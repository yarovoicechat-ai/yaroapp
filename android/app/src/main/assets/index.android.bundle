__d(function(e,n,t,a,o,i,r){Object.defineProperty(i,"__esModule",{value:!0}),i.resources=void 0;i.resources={en:{translation:{language_name:"English",home:{call_now:"Call Now",online:"online",offline:"offline",connect_chat:"Connect & Chat",total_coins:"Beans",messages:"Messages",notifications:"Notifications",tabs:{all:"All",star:"Star",trending:"Trending",new:"New"}},profile:{title:"Profile",guest_user:"Guest User",recharge:"Recharge",call_history:"Call History",rules:"Rules",help_support:"Help & Support",apply_hosting:"Apply Hosting",my_earnings:"My Earnings",ranking:"Ranking",call_level:"Call Level",frames:"Frames",withdraw:"Withdraw",id_manage:"ID Manage",verification:"Verification",language:"Language",blocklist:{title:"Blocklist",empty:"No blocked users",unblock:"Unblock"},settings:"Settings",save:"Save Changes",logout:"Logout",logging_out:"Logging out...",loading:"Loading profile...",id_label:"Id: ",na:"N/A",wallet:"Wallet"},settings:{title:"Settings",delete_account:"Delete Account",privacy:"Privacy Policy",refund:"Refund Policy",about:"About Us",contact:"Contact Us",account:"Account",delete_confirm:"Are you sure you want to delete your account? This action cannot be undone.",cancel:"Cancel",delete:"Delete",delete_success:"Account deleted successfully.",delete_fail:"Failed to delete account",delete_error:"An error occurred while deleting account."},edit_profile:{title:"Edit Profile",choose_avatar:"Choose Avatar",name_label:"Name",enter_name:"Enter your name",username_label:"Username",set_username:"Set your username",set_btn:"Set",user_id_label:"User ID",bio_label:"Bio",write_something:"Write something...",language:"Language",submit:"Submit",name_error:"Name cannot exceed 20 characters",bio_error:"Bio cannot exceed 100 characters",lang_error:"You can select up to 2 languages only",username_length_error:"Username must be at least 3 characters",username_success:"Username set successfully!",username_fail:"Failed to set username",update_success:"Profile updated!",update_fail:"Update failed",error:"Error",success:"Success",something_wrong:"Something went wrong"},account:{title:"Account",google_email:"Google Email",phone_number:"Phone Number",verified:"Verified",not_verified:"Not Verified",verify:"Verify"},privacy_policy:{title:"Privacy Policy \u2014 Yaro",content:"Effective Date: 15/08/2025\n\n---\n\n1. Introduction\n\nYaro (\"we\", \"our\", or \"us\") respects your privacy and is committed to protecting your personal data. This Privacy Policy explains how we collect, use, and disclose information when you use our mobile application (\"App\").\n\nBy using the App, you agree to the collection and use of information as described here.\n\n2. Information We Collect\n\n2.1 Personal Information:\nWhen you register or use the App, we may collect information you provide such as your name, username, profile picture, email address, and payment details.\n\n2.2 Usage Data:\nWe collect data about how you use the App, including interactions with other users, voice chat logs metadata (not content), and app usage statistics.\n\n2.3 Device Information:\nInformation about your device, such as device type, operating system version, unique device identifiers, IP address, and mobile network information.\n\n3. How We Use Your Information\n\n\u2022 To provide and maintain the App's features, including voice calls and chat services.\n\u2022 To process payments and manage your account.\n\u2022 To communicate with you regarding updates, promotions, and support.\n\u2022 To improve our App and develop new features.\n\u2022 To detect and prevent fraudulent or illegal activities.\n\n5. User Generated Content (UGC) Policy\n\n\u2022 **Zero Tolerance**: We have a zero-tolerance policy for objectionable content or abusive users.\n\u2022 **Reporting**: You can report inappropriate content or users directly within the app via the 'Report' button on user profiles or chat screens.\n\u2022 **Blocking**: You can block any user to prevent them from contacting you.\n\u2022 **Action**: We review reports within 24 hours and will remove offending content and suspend users who violate our terms.\n\u2022 **Prohibited Content**: Hate speech, nudity, violence, bullying, and harassment are strictly prohibited.\n\n6. Data Sharing and Disclosure\n\n\u2022 We do not sell your personal information to third parties.\n\u2022 We may share your information with trusted service providers who assist in operating the App, subject to confidentiality agreements.\n\u2022 We may disclose your data if required by law or to protect our rights.\n\n5. In-App Purchases and Payments\n\nAll payments are processed securely through the app store's payment system. We do not store your payment details directly.\n\n6. Your Rights and Choices\n\n\u2022 You can access, update, or delete your personal information through the App settings or by contacting support.\n\u2022 You may opt-out of receiving promotional communications at any time.\n\u2022 You can delete your account anytime via the App.\n\n7. Data Security\n\nWe implement industry-standard technical and organizational measures to protect your information from unauthorized access, alteration, disclosure, or destruction.\n\n8. Children's Privacy\n\nOur App is not intended for children under 18 years. We do not knowingly collect data from anyone under 18.\n\n9. Changes to This Privacy Policy\n\nWe may update this Privacy Policy occasionally. We will notify you of any changes by posting the new Privacy Policy on this page. Continued use of the App after changes means you accept the updated policy.\n\n10. Contact Us\n\nFor any questions about this Privacy Policy or your data, please contact us via the Support section in the App.\n\nBy using Yaro, you acknowledge that you have read and agreed to this Privacy Policy."},about_us:{title:"About Us \u2013 Yaro",content:"Welcome to Yaro \u2013 A Private 1-on-1 Voice Calling and Friendship App!\n\nYaro is a social voice platform that helps users connect through real-time 1-on-1 voice calls. Whether you're looking to talk, make new friends, or just pass the time, Yaro offers a safe and engaging space for meaningful voice conversations.\n\n\ud83c\udfaf Key Features:\n\n\u2022 1-on-1 Real-Time Voice Calling\n\u2022 Diamond & Bean Social System (with easy recharge)\n\u2022 Profile Customization (avatars, bios)\n\u2022 Smart Matchmaking to Meet New People\n\u2022 Full Privacy Controls \u2013 Block, Report, etc.\n\n\ud83d\udd12 Safe and Respectful Environment\n\nWe prioritize user safety. Our platform includes strict moderation tools, reporting features, and user controls to maintain a respectful and abuse-free experience.\n\n\ud83c\udf0d Who We Are\n\nYaro is developed by an India-based team passionate about building secure and voice-focused social experiences.\n\n\ud83d\udcf1 App Availability:\n\nAvailable on the Google Play Store\nhttps://play.google.com/store/apps/details?id=yaro.vc.app\n\n\ud83d\udcec Contact Us:\n\nEmail: support@yaroapp.in\nIn-App: Go to Profile \u2192 Help & Support"},contact_us:{title:"Contact Us",part1:"At Yaro, we are committed to providing a seamless and safe voice-calling experience for all users. If you have any questions, feedback, or concerns regarding the app, our services, or your account, feel free to contact us.\n\n\ud83d\udcec Support Email:\n",part2:"\nWe usually respond within 24\u201348 business hours.\n\n\ud83d\udee0 In-App Support:\nYou can also reach us from within the app:\n\n1. Go to your Profile\n2. Tap on Help & Support\n3. Submit your issue or feedback directly\n\n\ud83e\uddd1\u200d\u2696 Legal & Policy Queries:\nFor legal matters, privacy concerns, or terms of service inquiries, you can also email us at ",part3:" with the subject line clearly mentioning your concern (e.g., \"Privacy Concern\", \"Terms of Service Question\")."},refund_policy:{title:"Refund Policy \u2013 Yaro",content:"Effective Date: 15/08/2025\n\n1. General Policy\n\nAll purchases made within Yaro are considered final and non-refundable. We provide virtual content and services such as voice chat access, virtual coins, and premium features. Once purchased, these services are delivered instantly and cannot be reversed.\n\n2. In-App Purchases\n\n\u2022 Purchases made via Google Play Store are handled by Google Play's payment system.\n\u2022 We do not process or manage payments directly.\n\u2022 In rare cases, refunds may be considered if the user experiences technical issues or accidental purchases.\n\n3. Eligibility for Refund\n\nRefund requests will be reviewed on a case-by-case basis and may be approved only under the following conditions:\n\n\u2022 Duplicate purchase\n\u2022 Technical failure (purchase not delivered)\n\u2022 Unauthorized transaction (with valid proof)\n\nTo be eligible for a refund, you must:\n\n\u2022 Contact us within 48 hours of the transaction\n\u2022 Provide the Order ID and relevant proof (e.g., screenshots, error messages)\n\n4. How to Request a Refund\n\nIf you believe you are eligible for a refund, follow one of these options:\n\nVia Google Play:\n\n1. Open your Google Play account.\n2. Go to \"Order History\".\n3. Find the transaction and tap \"Report a Problem\".\n4. Select the appropriate reason and submit the form.\n\nOr Contact Us Directly:\n\nEmail: support@yaroapp.in\nInclude:\n\n\u2022 Your Name\n\u2022 Google Order ID (starting with GPA.)\n\u2022 Reason for refund request\n\u2022 Screenshot (if applicable)\n\n5. Refund Timeframe\n\nIf approved, refunds will be issued to the original payment method within 5\u201310 business days, depending on your bank or Google Play policy.\n\n6. No Refunds For:\n\n\u2022 Change of mind\n\u2022 Partially used services (e.g., consumed coins or completed chats)\n\u2022 Misuse or violation of terms\n\u2022 Requests after 48 hours of purchase\n\n7. Contact Us\n\nFor support or refund requests, please contact us via:\n\nSupport Email: support@yaroapp.in\nIn-App Support Section: Available in App Settings\n\nBy purchasing in the app, you agree to this Refund Policy."},terms_of_use:{title:"Terms of Use \u2013 Yaro",content:"1. Introduction:\nWelcome to Yaro, a social voice chat and voice calling application. By using this app, you agree to abide by the following terms and conditions.\n\n2. User Eligibility:\nYou must be at least 18 years old to use this app. By using this app, you confirm that you meet the eligibility criteria.\n\n3. Use of the App:\n- This app allows you to join public and private voice chat rooms and make voice calls to other users.\n- You agree to use the app only for lawful and respectful communication.\n- Any form of abuse, harassment, or objectionable content is strictly prohibited.\n\n4. Account Responsibility:\n- You are responsible for maintaining the confidentiality of your account.\n- You must not share your login credentials with anyone.\n- If you suspect any unauthorized access, please report it through the app support section.\n\n5. Privacy & Data:\n- We value your privacy. Your personal data will be handled securely and used only to improve the app experience.\n- Voice data and chat interactions are not shared publicly or with third parties, unless required by law.\n\n6. Payments & Diamonds:\n- The app may offer in-app purchases like coins or premium features.\n- All purchases are final and non-refundable unless stated otherwise by app store policies.\n\n7. Termination of Account:\n- Yaro reserves the right to suspend or terminate your account if you violate any terms.\n- You may also delete your account anytime from the app's settings.\n\n8. App Content:\n- Some visuals, avatars, or icons may be generated using artificial intelligence (AI).\n- These do not represent real individuals. Any similarity is purely coincidental.\n\n9. Changes to Terms:\nWe may update these terms from time to time. Continued use of the app means you accept the updated terms.\n\n10. Support:\nIf you have questions, concerns, or complaints, please reach out to us from the Support section in the app.\n\nNote: These Terms of Use are a general guideline and do not replace any legal rules under applicable laws, including the Indian Penal Code or IT Act."},notifications:{title:"Notifications",empty:"No notifications yet"},system_messages:{title:"System Messages",empty:"No system messages"},error:{server_busy_title:"Server Busy",server_busy_msg:"Something went wrong. Please try again after some time.",purchase_failed:"Purchase failed. Please try again.",verification_failed:"Verification failed.",error_title:"Error",success_title:"Success"},recharge:{title:"Recharge Wallet",processing:"Processing Purchase...",history:"Recharge History",no_history:"No recharge history found.",success:"Diamonds added to your wallet!",verification_failed:"Verification Failed",server_error:"Payment verification failed on server.",purchase_failed:"Purchase failed.",error:"Error"},withdrawal:{title:"Withdrawal",success:"Success",min_withdrawal:"Minimum withdrawal is \u20b9",complete_kyc:"Complete Your KYC",verify:"Verify",input_coin:"Input Withdrawal Beans",equivalent_amount:"Equivalent Amount:",bank_account:"Bank Account",upi:"UPI",bank_name:"Bank Name",account_number:"Account Number",confirm_account:"Confirm account number",ifsc_code:"IFSC CODE",receiver_name:"Receiver Name",enter_upi:"Enter UPI ID",example_upi:"Example: user@upi",withdraw_now:"Withdraw Now"},history:{type:"Type",time:"Time",date:"Date",coin:"Beans",call_history:"Call History",one_month:"1 Month",days:"Days",total_timing:"Total Timing :",name_label:"Name :",id_label:"ID :",type_label:"Type :",commission:"Commission :",voice:"Voice :",gift:"Gift :",duration:"Duration:",date_label:"Date:",start:"Start:",end:"End:",no_call_history:"No call history found."},rules:{title:"Rules And Regulation",host_rules:"Host Rules",host_rule_1:"Do Not Share Your Personal Information\nLike Fb , Insta , Mobile No With User",host_rule_2:"Do Not Remain Quiet After Picking\nUp The Calls",host_rule_3:"Don't Act Rude With The Users",host_rule_4:"Don't Force For Too Much Gifting",user_rules:"Users Rules",note:"Note",note_desc:"If any of the above rules are not\nfollowed , our AI tools will deduct\nAnd Block Your Wallet And Account"},help:{title:"Help & Support",reason:"Reason",your_reason:"Your Reason",other_reason_placeholder:"Other Reason",your_query:"Your Query",input_placeholder:"Input",upload:"Upload Screenshot/Video",remove_file:"Remove File",submit:"Submit",select_reason:"Please select a reason.",specify_reason:"Please specify the reason.",enter_query:"Please enter your query.",success_submit:"Your request has been submitted successfully!",failed_pick:"Failed to pick file",failed_submit:"Failed to submit request",error_submit:"Something went wrong. Please try again.",reasons:{add_coin_issue:"Recharge / Diamond Issue",user_report:"User Report",host_report:"Host Report",withdraw_issue:"Withdraw Issue",bank_account_issue:"Bank Account Issue",none:"None",other:"Other"}},ranking:{title:"Ranking",daily:"Daily",weekly:"Weekly",monthly:"Monthly",call:"Call",time:"Time",coins:"Beans",today:"Today",week:"Week",month:"Month",top:"Top",unknown:"Unknown",no:"No",name:"Name"},level:{title:"Level",user:"User",call:"Call",min:"Min",min_suffix:"min",how_to_upgrade:"How To Upgrade ?",table_level:"Level",total_call:"Total Call",total_time:"Total Time",earning_min:"Earning/Min"},frame:{title:"Frame",user:"User",level:"Level",table_level:"Level",table_frame:"Frame"},id_manage:{title:"ID Manage",name_label:"Name:",na:"N/A",id_label:"Id No:",username_label:"User Name:",status_label:"ID Active / Deactive:",date:"Date",start_time:"Start Time",end_time:"End Time",total_time:"Total Time",no_history:"No history found",error:"Error",update_fail:"Failed to update status"},kyc:{title:"KYC Verification",error:"Error",failed_pick:"Failed to pick file",missing_fields:"Missing Fields",enter_both:"Please enter both Pan & Aadhar numbers",missing_docs:"Missing Documents",select_all_images:"Please select all 3 required