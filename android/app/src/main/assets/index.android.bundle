0 \u09a8\u09be\u09ae \u0985\u09a8\u09cd\u09a4\u09a4 \u09e9\u099f\u09bf \u0985\u0995\u09cd\u09b7\u09b0\u09c7\u09b0 \u09b9\u09a4\u09c7 \u09b9\u09ac\u09c7",username_success:"\u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0 \u09a8\u09be\u09ae \u09b8\u09ab\u09b2\u09ad\u09be\u09ac\u09c7 \u09b8\u09c7\u099f \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7!",username_fail:"\u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0 \u09a8\u09be\u09ae \u09b8\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u09ac\u09cd\u09af\u09b0\u09cd\u09a5",update_success:"\u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7!",update_fail:"\u0986\u09aa\u09a1\u09c7\u099f \u09ac\u09cd\u09af\u09b0\u09cd\u09a5 \u09b9\u09af\u09bc\u09c7\u099b\u09c7",error:"\u09a4\u09cd\u09b0\u09c1\u099f\u09bf",success:"\u09b8\u09ab\u09b2",something_wrong:"\u0995\u09bf\u099b\u09c1 \u09ad\u09c1\u09b2 \u09b9\u09af\u09bc\u09c7\u099b\u09c7"},account:{title:"\u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f",google_email:"Google \u0987\u09ae\u09c7\u0987\u09b2",phone_number:"\u09ab\u09cb\u09a8 \u09a8\u09ae\u09cd\u09ac\u09b0",verified:"\u09af\u09be\u099a\u09be\u0987\u0995\u09c3\u09a4",not_verified:"\u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09a8\u09bf",verify:"\u09af\u09be\u099a\u09be\u0987 \u0995\u09b0\u09c1\u09a8"},privacy_policy:{title:"\u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u09a8\u09c0\u09a4\u09bf \u2014 Yaro",content:"\u0995\u09be\u09b0\u09cd\u09af\u0995\u09b0 \u09a4\u09be\u09b0\u09bf\u0996: \u09e7\u09eb/\u09e6\u09ee/\u09e8\u09e6\u09e8\u09eb\n\n---\n\n\u09e7. \u09ad\u09c2\u09ae\u09bf\u0995\u09be\n\nYaro (\"\u0986\u09ae\u09b0\u09be\", \"\u0986\u09ae\u09be\u09a6\u09c7\u09b0\", \u09ac\u09be \"\u0986\u09ae\u09be\u09a6\u09c7\u09b0\") \u0986\u09aa\u09a8\u09be\u09b0 \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be\u0995\u09c7 \u09b8\u09ae\u09cd\u09ae\u09be\u09a8 \u0995\u09b0\u09c7 \u098f\u09ac\u0982 \u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09a1\u09c7\u099f\u09be \u09b8\u09c1\u09b0\u0995\u09cd\u09b7\u09be\u09af\u09bc \u09aa\u09cd\u09b0\u09a4\u09bf\u09b6\u09cd\u09b0\u09c1\u09a4\u09bf\u09ac\u09a6\u09cd\u09a7\u0964 \u098f\u0987 \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u09a8\u09c0\u09a4\u09bf \u09ac\u09cd\u09af\u09be\u0996\u09cd\u09af\u09be \u0995\u09b0\u09c7 \u09af\u09c7 \u0986\u09aa\u09a8\u09bf \u09af\u0996\u09a8 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u0985\u09cd\u09af\u09be\u09aa\u09cd\u09b2\u09bf\u0995\u09c7\u09b6\u09a8 (\"\u0985\u09cd\u09af\u09be\u09aa\") \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7\u09a8 \u09a4\u0996\u09a8 \u0986\u09ae\u09b0\u09be \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u09a4\u09a5\u09cd\u09af \u09b8\u0982\u0997\u09cd\u09b0\u09b9, \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u0995\u09be\u09b6 \u0995\u09b0\u09bf\u0964\n\n\u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7, \u0986\u09aa\u09a8\u09bf \u098f\u0996\u09be\u09a8\u09c7 \u09ac\u09b0\u09cd\u09a3\u09bf\u09a4 \u09a4\u09a5\u09cd\u09af\u09c7\u09b0 \u09b8\u0982\u0997\u09cd\u09b0\u09b9 \u098f\u09ac\u0982 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09b8\u09ae\u09cd\u09ae\u09a4 \u09b9\u09a8\u0964\n\n\u09e8. \u0986\u09ae\u09b0\u09be \u09af\u09c7 \u09a4\u09a5\u09cd\u09af \u09b8\u0982\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09bf\n\n\u09e8.\u09e7 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09a4\u09a5\u09cd\u09af:\n\u0986\u09aa\u09a8\u09bf \u09af\u0996\u09a8 \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09a8\u09bf\u09ac\u09a8\u09cd\u09a7\u09a8 \u0995\u09b0\u09c7\u09a8 \u09ac\u09be \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7\u09a8, \u09a4\u0996\u09a8 \u0986\u09ae\u09b0\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09be\u09ae, \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0 \u09a8\u09be\u09ae, \u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2 \u099b\u09ac\u09bf, \u0987\u09ae\u09c7\u09b2 \u09a0\u09bf\u0995\u09be\u09a8\u09be \u098f\u09ac\u0982 \u0985\u09b0\u09cd\u09a5\u09aa\u09cd\u09b0\u09a6\u09be\u09a8\u09c7\u09b0 \u09ac\u09bf\u09b6\u09a6\u0997\u09c1\u09b2\u09bf\u09b0 \u09ae\u09a4\u09cb \u09a4\u09a5\u09cd\u09af \u09b8\u0982\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09bf\u0964\n\n\u09e8.\u09e8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u09c7\u09b0 \u09a1\u09c7\u099f\u09be:\n\u0986\u09aa\u09a8\u09bf \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7\u09a8 \u09b8\u09c7 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u0986\u09ae\u09b0\u09be \u09a1\u09c7\u099f\u09be \u09b8\u0982\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09bf, \u09af\u09be\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09ae\u09bf\u09a5\u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be, \u09ad\u09af\u09bc\u09c7\u09b8 \u099a\u09cd\u09af\u09be\u099f \u09b2\u0997 \u09ae\u09c7\u099f\u09be\u09a1\u09c7\u099f\u09be (\u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09c0 \u09a8\u09af\u09bc), \u098f\u09ac\u0982 \u0985\u09cd\u09af\u09be\u09aa \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u09c7\u09b0 \u09aa\u09b0\u09bf\u09b8\u0982\u0996\u09cd\u09af\u09be\u09a8 \u0985\u09a8\u09cd\u09a4\u09b0\u09cd\u09ad\u09c1\u0995\u09cd\u09a4 \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964\n\n\u09e8.\u09e9 \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u09c7\u09b0 \u09a4\u09a5\u09cd\u09af:\n\u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u09a4\u09a5\u09cd\u09af, \u09af\u09c7\u09ae\u09a8 \u09a1\u09bf\u09ad\u09be\u0987\u09b8\u09c7\u09b0 \u09a7\u09b0\u09a3, \u0985\u09aa\u09be\u09b0\u09c7\u099f\u09bf\u0982 \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae \u09b8\u0982\u09b8\u09cd\u0995\u09b0\u09a3, \u0985\u09a8\u09a8\u09cd\u09af \u09a1\u09bf\u09ad\u09be\u0987\u09b8 \u09b8\u09a8\u09be\u0995\u09cd\u09a4\u0995\u09be\u09b0\u09c0, \u0986\u0987\u09aa\u09bf \u09a0\u09bf\u0995\u09be\u09a8\u09be \u098f\u09ac\u0982 \u09ae\u09cb\u09ac\u09be\u0987\u09b2 \u09a8\u09c7\u099f\u0993\u09af\u09bc\u09be\u09b0\u09cd\u0995 \u09a4\u09a5\u09cd\u09af\u0964\n\n\u09e9. \u0986\u09ae\u09b0\u09be \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09a4\u09a5\u09cd\u09af \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09bf\n\n\u2022 \u09ad\u09af\u09bc\u09c7\u09b8 \u0995\u09b2 \u098f\u09ac\u0982 \u099a\u09cd\u09af\u09be\u099f \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be \u09b8\u09b9 \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af\u0997\u09c1\u09b2\u09bf \u09b8\u09b0\u09ac\u09b0\u09be\u09b9 \u098f\u09ac\u0982 \u09ac\u099c\u09be\u09af\u09bc \u09b0\u09be\u0996\u09be\u09b0 \u099c\u09a8\u09cd\u09af\u0964\n\u2022 \u0985\u09b0\u09cd\u09a5\u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u0995\u09b0\u09a4\u09c7 \u098f\u09ac\u0982 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09a4\u09c7\u0964\n\u2022 \u0986\u09aa\u09a1\u09c7\u099f, \u09aa\u09cd\u09b0\u099a\u09be\u09b0 \u098f\u09ac\u0982 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09bf\u09a4 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09a4\u09c7\u0964\n\u2022 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09b0\u09a4\u09c7 \u098f\u09ac\u0982 \u09a8\u09a4\u09c1\u09a8 \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af\u0997\u09c1\u09b2\u09bf \u09ac\u09bf\u0995\u09be\u09b6 \u0995\u09b0\u09a4\u09c7\u0964\n\u2022 \u09aa\u09cd\u09b0\u09a4\u09be\u09b0\u09a3\u09be\u09ae\u09c2\u09b2\u0995 \u09ac\u09be \u0985\u09ac\u09c8\u09a7 \u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u0995\u09b2\u09be\u09aa \u09b8\u09a8\u09be\u0995\u09cd\u09a4 \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b0\u09cb\u09a7 \u0995\u09b0\u09a4\u09c7\u0964\n\n\u09eb. \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0 \u099c\u09c7\u09a8\u09be\u09b0\u09c7\u099f\u09c7\u09a1 \u0995\u09a8\u099f\u09c7\u09a8\u09cd\u099f (UGC) \u09a8\u09c0\u09a4\u09bf\n\n\u2022 **\u099c\u09bf\u09b0\u09cb \u099f\u09b2\u09be\u09b0\u09c7\u09a8\u09cd\u09b8**: \u0986\u09aa\u09a4\u09cd\u09a4\u09bf\u099c\u09a8\u0995 \u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09c0 \u09ac\u09be \u0985\u09ac\u09ae\u09be\u09a8\u09a8\u09be\u0995\u09b0 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u099c\u09bf\u09b0\u09cb-\u099f\u09b2\u09be\u09b0\u09c7\u09a8\u09cd\u09b8 \u09a8\u09c0\u09a4\u09bf \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964\n\u2022 **\u09b0\u09bf\u09aa\u09cb\u09b0\u09cd\u099f\u09bf\u0982**: \u0986\u09aa\u09a8\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0 \u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2 \u09ac\u09be \u099a\u09cd\u09af\u09be\u099f \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u0997\u09c1\u09b2\u09bf\u09a4\u09c7 '\u09b0\u09bf\u09aa\u09cb\u09b0\u09cd\u099f' \u09ac\u09cb\u09a4\u09be\u09ae\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u0985\u09a8\u09c1\u09aa\u09af\u09c1\u0995\u09cd\u09a4 \u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09c0 \u09ac\u09be \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09a6\u09c7\u09b0 \u09b0\u09bf\u09aa\u09cb\u09b0\u09cd\u099f \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964\n\u2022 **\u0985\u09ac\u09b0\u09c1\u09a6\u09cd\u09a7 \u0995\u09b0\u09be**: \u0986\u09aa\u09a8\u09bf \u0995\u09cb\u09a8\u0993 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u0995\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09a4\u09c7 \u09ac\u09be\u09a7\u09be \u09a6\u09bf\u09a4\u09c7 \u0985\u09ac\u09b0\u09c1\u09a6\u09cd\u09a7 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964\n\u2022 **\u09aa\u09a6\u0995\u09cd\u09b7\u09c7\u09aa**: \u0986\u09ae\u09b0\u09be \u09e8\u09ea \u0998\u09a8\u09cd\u099f\u09be\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09aa\u09cd\u09b0\u09a4\u09bf\u09ac\u09c7\u09a6\u09a8\u0997\u09c1\u09b2\u09bf \u09aa\u09b0\u09cd\u09af\u09be\u09b2\u09cb\u099a\u09a8\u09be \u0995\u09b0\u09bf \u098f\u09ac\u0982 \u0986\u09aa\u09a4\u09cd\u09a4\u09bf\u0995\u09b0 \u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09c0 \u09b8\u09b0\u09bf\u09af\u09bc\u09c7 \u09a6\u09c7\u09ac \u098f\u09ac\u0982 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b6\u09b0\u09cd\u09a4\u09be\u09a6\u09bf \u09b2\u0999\u09cd\u0998\u09a8\u0995\u09be\u09b0\u09c0 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09a6\u09c7\u09b0 \u09b8\u09cd\u09a5\u0997\u09bf\u09a4 \u0995\u09b0\u09ac\u0964\n\u2022 **\u09a8\u09bf\u09b7\u09bf\u09a6\u09cd\u09a7 \u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09c0**: \u0998\u09c3\u09a3\u09be\u09a4\u09cd\u09ae\u0995 \u09ac\u0995\u09cd\u09a4\u09ac\u09cd\u09af, \u09a8\u0997\u09cd\u09a8\u09a4\u09be, \u09b8\u09b9\u09bf\u0982\u09b8\u09a4\u09be, \u0997\u09c1\u09a8\u09cd\u09a1\u09be\u09ae\u09bf \u098f\u09ac\u0982 \u09b9\u09af\u09bc\u09b0\u09be\u09a8\u09bf \u0995\u09a0\u09cb\u09b0\u09ad\u09be\u09ac\u09c7 \u09a8\u09bf\u09b7\u09bf\u09a6\u09cd\u09a7\u0964\n\n\u09ec. \u09a1\u09c7\u099f\u09be \u09ad\u09be\u0997 \u0995\u09b0\u09c7 \u09a8\u09c7\u0993\u09af\u09bc\u09be \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u0995\u09be\u09b6\n\n\u2022 \u0986\u09ae\u09b0\u09be \u09a4\u09c3\u09a4\u09c0\u09af\u09bc \u09aa\u0995\u09cd\u09b7\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09a4\u09a5\u09cd\u09af \u09ac\u09bf\u0995\u09cd\u09b0\u09bf \u0995\u09b0\u09bf \u09a8\u09be\u0964\n\u2022 \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u099a\u09c1\u0995\u09cd\u09a4\u09bf\u09b0 \u09b8\u09be\u09aa\u09c7\u0995\u09cd\u09b7\u09c7 \u09af\u09be\u09b0\u09be \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09a4\u09c7 \u09b8\u09b9\u09be\u09af\u09bc\u09a4\u09be \u0995\u09b0\u09c7 \u09a4\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u0986\u09ae\u09b0\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09a4\u09a5\u09cd\u09af \u09a8\u09bf\u09b0\u09cd\u09ad\u09b0\u09af\u09cb\u0997\u09cd\u09af \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be \u09b8\u09b0\u09ac\u09b0\u09be\u09b9\u0995\u09be\u09b0\u09c0\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09ad\u09be\u0997 \u0995\u09b0\u09c7 \u09a8\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09bf\u0964\n\u2022 \u0986\u0987\u09a8 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc \u09b9\u09b2\u09c7 \u09ac\u09be \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0985\u09a7\u09bf\u0995\u09be\u09b0 \u09b0\u0995\u09cd\u09b7\u09be\u09af\u09bc \u0986\u09ae\u09b0\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09c7\u099f\u09be \u09aa\u09cd\u09b0\u0995\u09be\u09b6 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09bf\u0964\n\n\u09eb. \u0987\u09a8-\u0985\u09cd\u09af\u09be\u09aa \u0995\u09c7\u09a8\u09be\u0995\u09be\u099f\u09be \u098f\u09ac\u0982 \u0985\u09b0\u09cd\u09a5\u09aa\u09cd\u09b0\u09a6\u09be\u09a8\n\n\u09b8\u09ae\u09b8\u09cd\u09a4 \u0985\u09b0\u09cd\u09a5\u09aa\u09cd\u09b0\u09a6\u09be\u09a8 \u0985\u09cd\u09af\u09be\u09aa \u09b8\u09cd\u099f\u09cb\u09b0\u09c7\u09b0 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09a8\u09bf\u09b0\u09be\u09aa\u09a6\u09c7 \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be\u099c\u09be\u09a4 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u0964 \u0986\u09ae\u09b0\u09be \u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09b0\u09cd\u09a5\u09aa\u09cd\u09b0\u09a6\u09be\u09a8\u09c7\u09b0 \u09ac\u09bf\u09b6\u09a6\u099f\u09bf \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3 \u0995\u09b0\u09bf \u09a8\u09be\u0964\n\n\u09ec. \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09a7\u09bf\u0995\u09be\u09b0 \u098f\u09ac\u0982 \u09aa\u099b\u09a8\u09cd\u09a6\n\n\u2022 \u0986\u09aa\u09a8\u09bf \u0985\u09cd\u09af\u09be\u09aa \u09b8\u09c7\u099f\u09bf\u0982\u09b8\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09ac\u09be \u09b8\u09b9\u09be\u09af\u09bc\u09a4\u09be\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09a4\u09a5\u09cd\u09af \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8, \u0986\u09aa\u09a1\u09c7\u099f \u09ac\u09be \u09ae\u09c1\u099b\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964\n\u2022 \u0986\u09aa\u09a8\u09bf \u09af\u09c7 \u0995\u09cb\u09a8\u0993 \u09b8\u09ae\u09af\u09bc \u09aa\u09cd\u09b0\u099a\u09be\u09b0\u09ae\u09c2\u09b2\u0995 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u09aa\u09cd\u09b0\u09be\u09aa\u09cd\u09a4\u09bf \u09a5\u09c7\u0995\u09c7 \u09ac\u09c7\u09b0\u09bf\u09af\u09bc\u09c7 \u0986\u09b8\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964\n\u2022 \u0986\u09aa\u09a8\u09bf \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09af\u09c7 \u0995\u09cb\u09a8\u0993 \u09b8\u09ae\u09af\u09bc \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09ae\u09c1\u099b\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964\n\n\u09ed. \u09a1\u09c7\u099f\u09be \u09b8\u09c1\u09b0\u0995\u09cd\u09b7\u09be\n\n\u0985\u09a8\u09a8\u09c1\u09ae\u09cb\u09a6\u09bf\u09a4 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8, \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8, \u09aa\u09cd\u09b0\u0995\u09be\u09b6 \u09ac\u09be \u09a7\u09cd\u09ac\u0982\u09b8 \u09a5\u09c7\u0995\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09a4\u09a5\u09cd\u09af \u09b8\u09c1\u09b0\u0995\u09cd\u09b7\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09ae\u09b0\u09be \u09b6\u09bf\u09b2\u09cd\u09aa-\u09ae\u09be\u09a8\u0995 \u09aa\u09cd\u09b0\u09af\u09c1\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u098f\u09ac\u0982 \u09b8\u09be\u0982\u0997\u09a0\u09a8\u09bf\u0995 \u09ac\u09cd\u09af\u09ac\u09b8\u09cd\u09a5\u09be \u09ac\u09be\u09b8\u09cd\u09a4\u09ac\u09be\u09af\u09bc\u09a8 \u0995\u09b0\u09bf\u0964\n\n\u09ee. \u09b6\u09bf\u09b6\u09c1\u09a6\u09c7\u09b0 \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be\n\n\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u09e7\u09ee \u09ac\u099b\u09b0\u09c7\u09b0 \u0995\u09ae \u09ac\u09af\u09bc\u09b8\u09c0 \u09b6\u09bf\u09b6\u09c1\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09a8\u09af\u09bc\u0964 \u0986\u09ae\u09b0\u09be \u099c\u09c7\u09a8\u09c7\u09b6\u09c1\u09a8\u09c7 \u09e7\u09ee \u09ac\u099b\u09b0\u09c7\u09b0 \u0995\u09ae \u09ac\u09af\u09bc\u09b8\u09c0 \u0995\u09be\u09b0\u0993 \u0995\u09be\u099b \u09a5\u09c7\u0995\u09c7 \u09a1\u09c7\u099f\u09be \u09b8\u0982\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09bf \u09a8\u09be\u0964\n\n\u09ef. \u098f\u0987 \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u09a8\u09c0\u09a4\u09bf\u09a4\u09c7 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8\n\n\u0986\u09ae\u09b0\u09be \u09ae\u09be\u099d\u09c7 \u09ae\u09be\u099d\u09c7 \u098f\u0987 \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u09a8\u09c0\u09a4\u09bf\u099f\u09bf \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09bf\u0964 \u098f\u0987 \u09aa\u09c3\u09b7\u09cd\u09a0\u09be\u09af\u09bc \u09a8\u09a4\u09c1\u09a8 \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u09a8\u09c0\u09a4\u09bf \u09aa\u09cb\u09b8\u09cd\u099f \u0995\u09b0\u09c7 \u0986\u09ae\u09b0\u09be \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0995\u09cb\u09a8\u0993 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8\u09c7\u09b0 \u09ac\u09bf\u09b7\u09af\u09bc\u09c7 \u0985\u09ac\u09b9\u09bf\u09a4 \u0995\u09b0\u09ac\u0964 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8\u09c7\u09b0 \u09aa\u09b0\u09c7 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf\u09b0 \u0985\u09ac\u09bf\u099a\u09cd\u099b\u09bf\u09a8\u09cd\u09a8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u09c7\u09b0 \u0985\u09b0\u09cd\u09a5 \u0986\u09aa\u09a8\u09bf \u0986\u09aa\u09a1\u09c7\u099f \u09b9\u0993\u09af\u09bc\u09be \u09a8\u09c0\u09a4\u09bf\u099f\u09bf \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09c7\u09a8\u0964\n\n\u09e7\u09e6. \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\n\n\u098f\u0987 \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u09a8\u09c0\u09a4\u09bf \u09ac\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u09a1\u09c7\u099f\u09be \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u09af\u09c7 \u0995\u09cb\u09a8\u0993 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af, \u09a6\u09af\u09bc\u09be \u0995\u09b0\u09c7 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf\u09a4\u09c7 \u09b8\u09b9\u09be\u09af\u09bc\u09a4\u09be \u09ac\u09bf\u09ad\u09be\u0997\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\u0964\n\nYaro \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7, \u0986\u09aa\u09a8\u09bf \u09b8\u09cd\u09ac\u09c0\u0995\u09be\u09b0 \u0995\u09b0\u09c7\u099b\u09c7\u09a8 \u09af\u09c7 \u0986\u09aa\u09a8\u09bf \u098f\u0987 \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u09a8\u09c0\u09a4\u09bf\u099f\u09bf \u09aa\u09a1\u09bc\u09c7\u099b\u09c7\u09a8 \u098f\u09ac\u0982 \u09b8\u09ae\u09cd\u09ae\u09a4 \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u09a8\u0964"},about_us:{title:"\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u2013 Yaro",content:"Yaro-\u09a4\u09c7 \u09b8\u09cd\u09ac\u09be\u0997\u09a4\u09ae \u2013 \u098f\u0995\u099f\u09bf \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 1-\u0985\u09a8-1 \u09ad\u09af\u09bc\u09c7\u09b8 \u0995\u09b2\u09bf\u0982 \u098f\u09ac\u0982 \u09ab\u09cd\u09b0\u09c7\u09a8\u09cd\u09a1\u09b6\u09bf\u09aa \u0985\u09cd\u09af\u09be\u09aa!\n\nYaro \u098f\u0995\u099f\u09bf \u09b8\u09be\u09ae\u09be\u099c\u09bf\u0995 \u09ad\u09af\u09bc\u09c7\u09b8 \u09aa\u09cd\u09b2\u09cd\u09af\u09be\u099f\u09ab\u09b0\u09cd\u09ae \u09af\u09be \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09a6\u09c7\u09b0 \u09b0\u09bf\u09af\u09bc\u09c7\u09b2-\u099f\u09be\u0987\u09ae 1-\u0985\u09a8-1 \u09ad\u09af\u09bc\u09c7\u09b8 \u0995\u09b2\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u09b8\u0982\u09af\u09cb\u0997 \u0995\u09b0\u09a4\u09c7 \u09b8\u09b9\u09be\u09af\u09bc\u09a4\u09be \u0995\u09b0\u09c7\u0964 \u0986\u09aa\u09a8\u09bf \u0995\u09a5\u09be \u09ac\u09b2\u09a4\u09c7, \u09a8\u09a4\u09c1\u09a8 \u09ac\u09a8\u09cd\u09a7\u09c1 \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09a4\u09c7, \u09ac\u09be \u0995\u09c7\u09ac\u09b2 \u09b8\u09ae\u09af\u09bc \u0995\u09be\u099f\u09be\u09a4\u09c7 \u099a\u09be\u0987\u099b\u09c7\u09a8 \u09a8\u09be \u0995\u09c7\u09a8, Yaro \u0985\u09b0\u09cd\u09a5\u09ac\u09b9 \u09ad\u09af\u09bc\u09c7\u09b8 \u0995\u09a5\u09cb\u09aa\u0995\u09a5\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0995\u099f\u09bf \u09a8\u09bf\u09b0\u09be\u09aa\u09a6 \u098f\u09ac\u0982 \u0986\u0995\u09b0\u09cd\u09b7\u09a3\u09c0\u09af\u09bc \u09b8\u09cd\u09a5\u09be\u09a8 \u09b8\u09b0\u09ac\u09b0\u09be\u09b9 \u0995\u09b0\u09c7\u0964\n\n\ud83c\udfaf \u09ae\u09c2\u09b2 \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af:\n\n\u2022 1-\u0985\u09a8-1 \u09b0\u09bf\u09af\u09bc\u09c7\u09b2-\u099f\u09be\u0987\u09ae \u09ad\u09af\u09bc\u09c7\u09b8 \u0995\u09b2\u09bf\u0982\n\u2022 \u0995\u09af\u09bc\u09c7\u09a8-\u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u0995 \u0995\u09b2\u09bf\u0982 \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae (\u09b8\u09b9\u099c \u09b0\u09bf\u099a\u09be\u09b0\u09cd\u099c \u09b8\u09b9)\n\u2022 \u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2 \u0995\u09be\u09b8\u09cd\u099f\u09ae\u09be\u0987\u099c\u09c7\u09b6\u09a8 (\u0985\u09ac\u09a4\u09be\u09b0, \u09ac\u09be\u09af\u09bc\u09cb\u09b8)\n\u2022 \u09a8\u09a4\u09c1\u09a8 \u09b2\u09cb\u0995\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09a6\u09c7\u0996\u09be \u0995\u09b0\u09a4\u09c7 \u09b8\u09cd\u09ae\u09be\u09b0\u09cd\u099f \u09ae\u09cd\u09af\u09be\u099a\u09ae\u09c7\u0915\u093f\u0902\u0917\n\u2022 \u09b8\u09ae\u09cd\u09aa\u09c2\u09b0\u09cd\u09a3 \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u09a8\u09bf\u09af\u09bc\u09a8\u09cd\u09a4\u09cd\u09b0\u09a3 \u2013 \u09ac\u09cd\u09b2\u0995, \u09b0\u09bf\u09aa\u09cb\u09b0\u09cd\u099f \u0987\u09a4\u09cd\u09af\u09be\u09a6\u09bf\u0964\n\n\ud83d\udd12 \u09a8\u09bf\u09b0\u09be\u09aa\u09a6 \u098f\u09ac\u0982 \u09b8\u09ae\u09cd\u09ae\u09be\u09a8\u099c\u09a8\u0995 \u09aa\u09b0\u09bf\u09ac\u09c7\u09b6\n\n\u0986\u09ae\u09b0\u09be \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0 \u09b8\u09c1\u09b0\u0995\u09cd\u09b7\u09be\u0995\u09c7 \u0985\u0997\u09cd\u09b0\u09be\u09a7\u09bf\u0995\u09be\u09b0 \u09a6\u09bf\u0987\u0964 \u09b8\u09ae\u09cd\u09ae\u09be\u09a8\u099c\u09a8\u0995 \u098f\u09ac\u0982 \u0985\u09aa\u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0-\u09ae\u09c1\u0995\u09cd\u09a4 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u09ac\u099c\u09be\u09af\u09bc \u09b0\u09be\u0996\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u09cd\u09b2\u09cd\u09af\u09be\u099f\u09ab\u09b0\u09cd\u09ae\u09c7 \u0995\u09a0\u09cb\u09b0 \u09ae\u09a1\u09be\u09b0\u09c7\u09b6\u09a8 \u09b8\u09b0\u099e\u09cd\u099c\u09be\u09ae, \u09b0\u09bf\u09aa\u09cb\u09b0\u09cd\u099f\u09bf\u0982 \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af \u098f\u09ac\u0982 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0 \u09a8\u09bf\u09af\u09bc\u09a8\u09cd\u09a4\u09cd\u09b0\u09a3 \u0985\u09a8\u09cd\u09a4\u09b0\u09cd\u09ad\u09c1\u0995\u09cd\u09a4 \u09b0\u09af\u09bc\u09c7\u099b\u09c7\u0964\n\n\ud83c\udf0d \u0986\u09ae\u09b0\u09be \u0995\u09c7\n\nYaro \u098f\u0995\u099f\u09bf \u09ad\u09be\u09b0\u09a4-\u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u0995 \u09a6\u09b2 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09ac\u09bf\u0995\u09be\u09b6\u09bf\u09a4 \u09af\u09be\u09b0\u09be \u09b8\u09c1\u09b0\u0995\u09cd\u09b7\u09bf\u09a4 \u098f\u09ac\u0982 \u09ad\u09af\u09bc\u09c7\u09b8-\u0995\u09c7\u09a8\u09cd\u09a6\u09cd\u09b0\u09bf\u0995 \u09b8\u09be\u09ae\u09be\u099c\u09bf\u0995 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u09a4\u09c8\u09b0\u09bf\u09a4\u09c7 \u0986\u0997\u09cd\u09b0\u09b9\u09c0\u0964\n\n\ud83d\udcf1 \u0985\u09cd\u09af\u09be\u09aa \u0989\u09aa\u09b2\u09ac\u09cd\u09a7\u09a4\u09be:\n\n\u0997\u09c1\u0997\u09b2 \u09aa\u09cd\u09b2\u09c7 \u09b8\u09cd\u099f\u09cb\u09b0\u09c7 \u0989\u09aa\u09b2\u09ac\u09cd\u09a7\nhttps://play.google.com/store/apps/details?id=yaro.vc.app\n\n\ud83d\udcec \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8:\n\n\u0987\u09ae\u09c7\u0987\u09b2: support@yaroapp.in\n\u0987\u09a8-\u0985\u09cd\u09af\u09be\u09aa: \u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2 \u2192 \u09b8\u09b9\u09be\u09af\u09bc\u09a4\u09be \u098f\u09ac\u0982 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8 \u098f \u09af\u09be\u09a8"},contact_us:{title:"\u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8",part1:"Yaro-\u09a4\u09c7, \u0986\u09ae\u09b0\u09be \u09b8\u09ae\u09b8\u09cd\u09a4 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09a6\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u098f\u0995\u099f\u09bf \u09a8\u09bf\u09b0\u09ac\u099a\u09cd\u099b\u09bf\u09a8\u09cd\u09a8 \u098f\u09ac\u0982 \u09a8\u09bf\u09b0\u09be\u09aa\u09a6 \u09ad\u09af\u09bc\u09c7\u09b8-\u0995\u09b2\u09bf\u0982 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u09b8\u09b0\u09ac\u09b0\u09be\u09b9 \u0995\u09b0\u09a4\u09c7 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b6\u09cd\u09b0\u09c1\u09a4\u09bf\u09ac\u09a6\u09cd\u09a7\u0964 \u0985\u09cd\u09af\u09be\u09aa, \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be \u09ac\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09b8\u09ae\u09cd\u09aa\u09b0\u09cd\u0995\u09c7 \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09cb\u09a8\u0993 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8, \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u09ac\u09be \u0989\u09a6\u09cd\u09ac\u09c7\u0997 \u09a5\u09be\u0995\u09c7 \u09a4\u09ac\u09c7 \u09a8\u09bf\u09b0\u09cd\u09a6\u09cd\u09ac\u09bf\u09a7\u09be\u09af\u09bc \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\u0964\n\n\ud83d\udcec \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8 \u0987\u09ae\u09c7\u0987\u09b2:\n",part2:"\n\u0986\u09ae\u09b0\u09be \u09b8\u09be\u09a7\u09be\u09b0\u09a3\u09a4 \u09e8\u09ea-\u09ea\u09ee \u0995\u09be\u09b0\u09cd\u09af\u0998\u09a3\u09cd\u099f\u09be\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09b8\u09be\u09a1\u09bc\u09be \u09a6\u09bf\u0987\u0964\n\n\ud83d\udee0 \u0987\u09a8-\u0985\u09cd\u09af\u09be\u09aa \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8:\n\u0986\u09aa\u09a8\u09bf \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u09ad\u09bf\u09a4\u09b0 \u09a5\u09c7\u0995\u09c7\u0993 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u09aa\u09cc\u0981\u099b\u09be\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8:\n\n1. \u0986\u09aa\u09a8\u09be\u09b0 \u09aa\u09cd\u09b0\u09cb\u09ab\u09be\u0987\u09b2\u09c7 \u09af\u09be\u09a8\n2. \u09b8\u09b9\u09be\u09af\u09bc\u09a4\u09be \u098f\u09ac\u0982 \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8\u09c7 \u0986\u09b2\u09a4\u09cb \u099a\u09be\u09aa\u09c1\u09a8\n3. \u0986\u09aa\u09a8\u09be\u09b0 \u09b8\u09ae\u09b8\u09cd\u09af\u09be \u09ac\u09be \u09aa\u09cd\u09b0\u09a4\u09bf\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u099c\u09ae\u09be \u09a6\u09bf\u09a8\n\n\ud83e\uddd1\u200d\u2696 \u0986\u0987\u09a8\u09c0 \u098f\u09ac\u0982 \u09a8\u09c0\u09a4\u09bf\u0997\u09a4 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8:\n\u0986\u0987\u09a8\u09c0 \u09ac\u09bf\u09b7\u09af\u09bc, \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be\u09b0 \u0989\u09a6\u09cd\u09ac\u09c7\u0997 \u09ac\u09be \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u09b0 \u09b6\u09b0\u09cd\u09a4\u09be\u09a6\u09bf \u0985\u09a8\u09c1\u09b8\u09a8\u09cd\u09a7\u09be\u09a8\u09c7\u09b0 \u099c\u09a8\u09cd\u09af, \u0986\u09aa\u09a8\u09bf \u09ac\u09bf\u09b7\u09af\u09bc \u09b2\u09be\u0987\u09a8\u09c7 \u09b8\u09cd\u09aa\u09b7\u09cd\u099f\u09ad\u09be\u09ac\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0989\u09a6\u09cd\u09ac\u09c7\u0997\u099f\u09bf \u0989\u09b2\u09cd\u09b2\u09c7\u0996 \u0995\u09b0\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0987\u09ae\u09c7\u09b2 \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8 ",part3:" \u09a0\u09bf\u0995\u09be\u09a8\u09be\u09af\u09bc (\u09af\u09c7\u09ae\u09a8, \"\u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u0989\u09a6\u09cd\u09ac\u09c7\u0997\", \"\u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u09b0 \u09b6\u09b0\u09cd\u09a4\u09be\u09a6\u09bf \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8\")\u0964"},refund_policy:{title:"\u09b0\u09bf\u09ab\u09be\u09a8\u09cd\u09a1 \u09a8\u09c0\u09a4\u09bf \u2013 Yaro",content:"\u0995\u09be\u09b0\u09cd\u09af\u0995\u09b0 \u09a4\u09be\u09b0\u09bf\u0996: \u09e7\u09eb/\u09e6\u09ee/\u09e8\u09e6\u09e8\u09eb\n\n\u09e7. \u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u09a8\u09c0\u09a4\u09bf\n\nYaro-\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09b8\u09ae\u09b8\u09cd\u09a4 \u0995\u09c7\u09a8\u09be\u0995\u09be\u099f\u09be \u099a\u09c2\u09a1\u09bc\u09be\u09a8\u09cd\u09a4 \u098f\u09ac\u0982 \u0985-\u09ab\u09c7\u09b0\u09a4\u09af\u09cb\u0997\u09cd\u09af \u09ac\u09b2\u09c7 \u09ac\u09bf\u09ac\u09c7\u099a\u09bf\u09a4 \u09b9\u09af\u09bc\u0964 \u0986\u09ae\u09b0\u09be \u09ad\u09af\u09bc\u09c7\u09b8 \u099a\u09cd\u09af\u09be\u099f \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8, \u09ad\u09be\u09b0\u09cd\u099a\u09c1\u09af\u09bc\u09be\u09b2 \u0995\u09af\u09bc\u09c7\u09a8 \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09af\u09bc\u09be\u09ae \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af\u0997\u09c1\u09b2\u09bf\u09b0 \u09ae\u09a4\u09cb \u09ad\u09be\u09b0\u09cd\u099a\u09c1\u09af\u09bc\u09be\u09b2 \u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09c0 \u098f\u09ac\u0982 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be \u09b8\u09b0\u09ac\u09b0\u09be\u09b9 \u0995\u09b0\u09bf\u0964 \u098f\u0995\u09ac\u09be\u09b0 \u0995\u09c7\u09a8\u09be \u09b9\u09b2\u09c7, \u098f\u0987 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u0997\u09c1\u09b2\u09bf \u09a4\u09be\u09a4\u09cd\u0995\u09cd\u09b7\u09a3\u09bf\u0995\u09ad\u09be\u09ac\u09c7 \u09b8\u09b0\u09ac\u09b0\u09be\u09b9 \u0995\u09b0\u09be \u09b9\u09af\u09bc \u098f\u09ac\u0982 \u09ac\u09bf\u09aa\u09b0\u09c0\u09a4 \u0995\u09b0\u09be \u09af\u09be\u09af\u09bc \u09a8\u09be\u0964\n\n\u09e8. \u0987\u09a8-\u0985\u09cd\u09af\u09be\u09aa \u0995\u09c7\u09a8\u09be\u0995\u09be\u099f\u09be\n\n\u2022 \u0997\u09c1\u0997\u09b2 \u09aa\u09cd\u09b2\u09c7 \u09b8\u09cd\u099f\u09cb\u09b0\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u0995\u09b0\u09be \u0995\u09c7\u09a8\u09be\u0995\u09be\u099f\u09be \u0997\u09c1\u0997\u09b2 \u09aa\u09cd\u09b2\u09c7\u09b0 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09bf\u09a4 \u09b9\u09af\u09bc\u0964\n\u2022 \u0986\u09ae\u09b0\u09be \u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u09aa\u09cd\u09b0\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u09ac\u09be \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09bf \u09a8\u09be\u0964\n\u2022 \u09ac\u09bf\u09b0\u09b2 \u0995\u09cd\u09b7\u09c7\u09a4\u09cd\u09b0\u09c7, \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0 \u09af\u09a6\u09bf \u09aa\u09cd\u09b0\u09af\u09c1\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09b8\u09ae\u09b8\u09cd\u09af\u09be \u09ac\u09be \u09a6\u09c1\u09b0\u09cd\u0998\u099f\u09a8\u09be\u099c\u09a8\u09bf\u09a4 \u0995\u09c7\u09a8\u09be\u0995\u09be\u099f\u09be\u09b0 \u09b8\u09ae\u09cd\u09ae\u09c1\u0996\u09c0\u09a8 \u09b9\u09a8 \u09a4\u09ac\u09c7 \u09b0\u09bf\u09ab\u09be\u09a8\u09cd\u09a1 \u09ac\u09bf\u09ac\u09c7\u099a\u09a8\u09be \u0995\u09b0\u09be \u09af\u09c7\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964\n\n\u09e9. \u09b0\u09bf\u09ab\u09be\u09a8\u09cd\u09a1\u09c7\u09b0 \u09af\u09cb\u0997\u09cd\u09af\u09a4\u09be\n\n\u09b0\u09bf\u09ab\u09be\u09a8\u09cd\u09a1\u09c7\u09b0 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u0997\u09c1\u09b2\u09bf \u0995\u09c7\u09b8-\u09ac\u09be\u0987-\u0995\u09c7\u09b8 \u09ad\u09bf\u09a4\u09cd\u09a4\u09bf\u09a4\u09c7 \u09aa\u09b0\u09cd\u09af\u09be\u09b2\u09cb\u099a\u09a8\u09be \u0995\u09b0\u09be \u09b9\u09ac\u09c7 \u098f\u09ac\u0982 \u0995\u09c7\u09ac\u09b2 \u09a8\u09bf\u09ae\u09cd\u09a8\u09b2\u09bf\u0996\u09bf\u09a4 \u09b6\u09b0\u09cd\u09a4\u0997\u09c1\u09b2\u09bf\u09b0 \u0985\u09a7\u09c0\u09a8\u09c7 \u0985\u09a8\u09c1\u09ae\u09cb\u09a6\u09bf\u09a4 \u09b9\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7:\n\n\u2022 \u09a1\u09c1\u09aa\u09cd\u09b2\u09bf\u0995\u09c7\u099f \u0995\u09c7\u09a8\u09be\u0995\u09be\u099f\u09be\n\u2022 \u09aa\u09cd\u09b0\u09af\u09c1\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09ac\u09cd\u09af\u09b0\u09cd\u09a5\u09a4\u09be (\u0995\u09cd\u09b0\u09af\u09bc \u09ac\u09bf\u09a4\u09b0\u09a3 \u0995\u09b0\u09be \u09b9\u09af\u09bc\u09a8\u09bf)\n\u2022 \u0985\u09a8\u09a8\u09c1\u09ae\u09cb\u09a6\u09bf\u09a4 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8 (\u09ac\u09c8\u09a7 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3 \u09b8\u09b9)\n\n\u09b0\u09bf\u09ab\u09be\u09a8\u09cd\u09a1\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09af\u09cb\u0997\u09cd\u09af \u09b9\u09a4\u09c7, \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u0985\u09ac\u09b6\u09cd\u09af\u0987:\n\n\u2022 \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u09c7\u09b0 \u09ea\u09ee \u0998\u09a8\u09cd\u099f\u09be\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7\n\u2022 \u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u0986\u0987\u09a1\u09bf \u098f\u09ac\u0982 \u09aa\u09cd\u09b0\u09be\u09b8\u0999\u09cd\u0997\u09bf\u0995 \u09aa\u09cd\u09b0\u09ae\u09be\u09a3 (\u09af\u09c7\u09ae\u09a8 \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u09b6\u099f, \u09a4\u09cd\u09b0\u09c1\u099f\u09bf \u09ac\u09be\u09b0\u09cd\u09a4\u09be) \u09b8\u09b0\u09ac\u09b0\u09be\u09b9 \u0995\u09b0\u09a4\u09c7 \u09b9\u09ac\u09c7\n\n\u09ea. \u0995\u09c0\u09ad\u09be\u09ac\u09c7 \u09b0\u09bf\u09ab\u09be\u09a8\u09cd\u09a1\u09c7\u09b0 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7 \u0995\u09b0\u09ac\u09c7\u09a8\n\n\u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u09ac\u09bf\u09b6\u09cd\u09ac\u09be\u09b8 \u0995\u09b0\u09c7\u09a8 \u09af\u09c7 \u0986\u09aa\u09a8\u09bf \u09b0\u09bf\u09ab\u09be\u09a8\u09cd\u09a1\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u09af\u09cb\u0997\u09cd\u09af, \u09a4\u09ac\u09c7 \u098f\u0987 \u09ac\u09bf\u0995\u09b2\u09cd\u09aa\u0997\u09c1\u09b2\u09bf\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u098f\u0995\u099f\u09bf \u0985\u09a8\u09c1\u09b8\u09b0\u09a3 \u0995\u09b0\u09c1\u09a8:\n\n\u0997\u09c1\u0997\u09b2 \u09aa\u09cd\u09b2\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7:\n\n\u09e7. \u0986\u09aa\u09a8\u09be\u09b0 \u0997\u09c1\u0997\u09b2 \u09aa\u09cd\u09b2\u09c7 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u0996\u09c1\u09b2\u09c1\u09a8\u0964\n\u09e8. \"\u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u0987\u09a4\u09bf\u09b9\u09be\u09b8\"-\u098f \u09af\u09be\u09a8\u0964\n\u09e9. \u09b2\u09c7\u09a8\u09a6\u09c7\u09a8\u099f\u09bf \u0996\u09c1\u0981\u099c\u09c1\u09a8 \u098f\u09ac\u0982 \"\u09b8\u09ae\u09b8\u09cd\u09af\u09be\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09ac\u09c7\u09a6\u09a8 \u0995\u09b0\u09c1\u09a8\"-\u098f \u0986\u09b2\u09a4\u09cb \u099a\u09be\u09aa\u09c1\u09a8\u0964\n\u09ea. \u0989\u09aa\u09af\u09c1\u0995\u09cd\u09a4 \u0995\u09be\u09b0\u09a3 \u09a8\u09bf\u09b0\u09cd\u09ac\u09be\u099a\u09a8 \u0995\u09b0\u09c1\u09a8 \u098f\u09ac\u0982 \u09ab\u09b0\u09cd\u09ae\u099f\u09bf \u099c\u09ae\u09be \u09a6\u09bf\u09a8\u0964\n\n\u09ac\u09be \u09b8\u09b0\u09be\u09b8\u09b0\u09bf \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8:\n\n\u0987\u09ae\u09c7\u0987\u09b2: support@yaroapp.in\n\u0985\u09a8\u09cd\u09a4\u09b0\u09cd\u09ad\u09c1\u0995\u09cd\u09a4 \u0995\u09b0\u09c1\u09a8:\n\n\u2022 \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09be\u09ae\n\u2022 \u0997\u09c1\u0997\u09b2 \u0985\u09b0\u09cd\u09a1\u09be\u09b0 \u0986\u0987\u09a1\u09bf (GPA. \u09a6\u09bf\u09af\u09bc\u09c7 \u09b6\u09c1\u09b0\u09c1)\n\u2022 \u09b0\u09bf\u09ab\u09be\u09a8\u09cd\u09a1 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u09c7\u09b0 \u0995\u09be\u09b0\u09a3\n\u2022 \u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09a8\u09b6\u099f (\u09af\u09a6\u09bf \u09aa\u09cd\u09b0\u09af\u09cb\u099c\u09cd\u09af \u09b9\u09af\u09bc)\n\n\u09eb. \u09b0\u09bf\u09ab\u09be\u09a8\u09cd\u09a1\u09c7\u09b0 \u09b8\u09ae\u09af\u09bc\u09b8\u09c0\u09ae\u09be\n\n\u0985\u09a8\u09c1\u09ae\u09cb\u09a6\u09bf\u09a4 \u09b9\u09b2\u09c7, \u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09cd\u09af\u09be\u0982\u0995 \u09ac\u09be \u0997\u09c1\u0997\u09b2 \u09aa\u09cd\u09b2\u09c7 \u09a8\u09c0\u09a4\u09bf\u09b0 \u0989\u09aa\u09b0 \u09a8\u09bf\u09b0\u09cd\u09ad\u09b0 \u0995\u09b0\u09c7 \u09eb-\u09e7\u09e6 \u0995\u09be\u09b0\u09cd\u09af\u09a6\u09bf\u09ac\u09b8\u09c7\u09b0 \u09ae\u09a7\u09cd\u09af\u09c7 \u09ae\u09c2\u09b2 \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u09aa\u09a6\u09cd\u09a7\u09a4\u09bf\u09a4\u09c7 \u09b0\u09bf\u09ab\u09be\u09a8\u09cd\u09a1 \u099c\u09be\u09b0\u09bf \u0995\u09b0\u09be \u09b9\u09ac\u09c7\u0964\n\n\u09ec. \u098f\u09b0 \u099c\u09a8\u09cd\u09af \u0995\u09cb\u09a8\u0993 \u09b0\u09bf\u09ab\u09be\u09a8\u09cd\u09a1 \u09a8\u09c7\u0987:\n\n\u2022 \u09ae\u09a4 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8\n\u2022 \u0986\u0982\u09b6\u09bf\u0995\u09ad\u09be\u09ac\u09c7 \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u09aa\u09b0\u09bf\u09b7\u09c7\u09ac\u09be\u0997\u09c1\u09b2\u09bf (\u09af\u09c7\u09ae\u09a8 \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u0995\u09af\u09bc\u09c7\u09a8 \u09ac\u09be \u09b8\u09ae\u09cd\u09aa\u09a8\u09cd\u09a8 \u099a\u09cd\u09af\u09be\u099f)\n\u2022 \u09b6\u09b0\u09cd\u09a4\u09be\u09ac\u09b2\u09c0\u09b0 \u0985\u09aa\u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u09ac\u09be \u09b2\u0999\u09cd\u0998\u09a8\n\u2022 \u0995\u09cd\u09b0\u09af\u09bc\u09c7\u09b0 \u09ea\u09ee \u0998\u09a8\u09cd\u099f\u09be \u09aa\u09b0\u09c7 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\n\n\u09ed. \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8\n\n\u09b8\u09ae\u09b0\u09cd\u09a5\u09a8 \u09ac\u09be \u09b0\u09bf\u09ab\u09be\u09a8\u09cd\u09a1\u09c7\u09b0 \u0985\u09a8\u09c1\u09b0\u09cb\u09a7\u09c7\u09b0 \u099c\u09a8\u09cd\u09af, \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997 \u0995\u09b0\u09c1\u09a8:\n\n\u09b8\u09ae\u09b0\u09cd\u09a5\u09a8 \u0987\u09ae\u09c7\u0987\u09b2: support@yaroapp.in\n\u0987\u09a8-\u0985\u09cd\u09af\u09be\u09aa \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8 \u09ac\u09bf\u09ad\u09be\u0997: \u0985\u09cd\u09af\u09be\u09aa \u09b8\u09c7\u099f\u09bf\u0982\u09b8\u09c7 \u0989\u09aa\u09b2\u09ac\u09cd\u09a7\n\n\u0985\u09cd\u09af\u09be\u09aa\u09c7 \u0995\u09cd\u09b0\u09af\u09bc\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7, \u0986\u09aa\u09a8\u09bf \u098f\u0987 \u09b0\u09bf\u09ab\u09be\u09a8\u09cd\u09a1 \u09a8\u09c0\u09a4\u09bf\u09a4\u09c7 \u09b8\u09ae\u09cd\u09ae\u09a4 \u09b9\u09a8\u0964"},terms_of_use:{title:"\u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u09c7\u09b0 \u09b6\u09b0\u09cd\u09a4\u09be\u09ac\u09b2\u09c0 \u2013 Yaro",content:"\u09e7. \u09aa\u09b0\u09bf\u099a\u09bf\u09a4\u09bf:\nYaro, \u098f\u0995\u099f\u09bf \u09b8\u09be\u09ae\u09be\u099c\u09bf\u0995 \u09ad\u09af\u09bc\u09c7\u09b8 \u099a\u09cd\u09af\u09be\u099f \u098f\u09ac\u0982 \u09ad\u09af\u09bc\u09c7\u09b8 \u0995\u09b2\u09bf\u0982 \u0985\u09cd\u09af\u09be\u09aa\u09cd\u09b2\u09bf\u0995\u09c7\u09b6\u09a8\u09c7 \u09b8\u09cd\u09ac\u09be\u0997\u09a4\u09ae\u0964 \u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7, \u0986\u09aa\u09a8\u09bf \u09a8\u09bf\u09ae\u09cd\u09a8\u09b2\u09bf\u0996\u09bf\u09a4 \u09a8\u09bf\u09af\u09bc\u09ae \u098f\u09ac\u0982 \u09b6\u09b0\u09cd\u09a4\u09be\u09ac\u09b2\u09c0 \u09ae\u09c7\u09a8\u09c7 \u099a\u09b2\u09a4\u09c7 \u09b8\u09ae\u09cd\u09ae\u09a4 \u09b9\u09a8\u0964\n\n\u09e8. \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09b0 \u09af\u09cb\u0997\u09cd\u09af\u09a4\u09be:\n\u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09af\u09bc\u09b8 \u0995\u09ae\u09aa\u0995\u09cd\u09b7\u09c7 \u09e7\u09ee \u09ac\u099b\u09b0 \u09b9\u09a4\u09c7 \u09b9\u09ac\u09c7\u0964 \u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7, \u0986\u09aa\u09a8\u09bf \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u099b\u09c7\u09a8 \u09af\u09c7 \u0986\u09aa\u09a8\u09bf \u09af\u09cb\u0997\u09cd\u09af\u09a4\u09be\u09b0 \u09ae\u09be\u09a8\u09a6\u09a3\u09cd\u09a1 \u09aa\u09c2\u09b0\u09a3 \u0995\u09b0\u09c7\u099b\u09c7\u09a8\u0964\n\n\u09e9. \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0:\n- \u098f\u0987 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u0986\u09aa\u09a8\u09be\u0995\u09c7 \u09b8\u09b0\u09cd\u09ac\u099c\u09a8\u09c0\u09a8 \u098f\u09ac\u0982 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09ad\u09af\u09bc\u09c7\u09b8 \u099a\u09cd\u09af\u09be\u099f \u09b0\u09c1\u09ae\u09c7 \u09af\u09cb\u0997 \u09a6\u09bf\u09a4\u09c7 \u098f\u09ac\u0982 \u0985\u09a8\u09cd\u09af\u09be\u09a8\u09cd\u09af \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u0995\u09be\u09b0\u09c0\u09a6\u09c7\u09b0 \u09ad\u09af\u09bc\u09c7\u09b8 \u0995\u09b2 \u0995\u09b0\u09be\u09b0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u09a6\u09c7\u09af\u09bc\u0964\n- \u0986\u09aa\u09a8\u09bf \u0995\u09c7\u09ac\u09b2 \u0986\u0987\u09a8\u09c0 \u098f\u09ac\u0982 \u09b6\u09cd\u09b0\u09a6\u09cd\u09a7\u09be\u09b6\u09c0\u09b2 \u09af\u09cb\u0997\u09be\u09af\u09cb\u0997\u09c7\u09b0 \u099c\u09a8\u09cd\u09af \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09a4\u09c7 \u09b8\u09ae\u09cd\u09ae\u09a4 \u09b9\u09a8\u0964\n- \u09af\u09c7 \u0995\u09cb\u09a8\u0993 \u09a7\u09b0\u09a3\u09c7\u09b0 \u0985\u09aa\u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0, \u09b9\u09af\u09bc\u09b0\u09be\u09a8\u09bf \u09ac\u09be \u0986\u09aa\u09a4\u09cd\u09a4\u09bf\u0995\u09b0 \u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09c0 \u0995\u09a0\u09cb\u09b0\u09ad\u09be\u09ac\u09c7 \u09a8\u09bf\u09b7\u09bf\u09a6\u09cd\u09a7\u0964\n\n\u09ea. \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7\u09b0 \u09a6\u09be\u09af\u09bc\u09bf\u09a4\u09cd\u09ac:\n- \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f\u09c7\u09b0 \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u09ac\u099c\u09be\u09af\u09bc \u09b0\u09be\u0996\u09be\u09b0 \u099c\u09a8\u09cd\u09af \u0986\u09aa\u09a8\u09bf \u09a6\u09be\u09af\u09bc\u09c0\u0964\n- \u0986\u09aa\u09a8\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09b2\u0997\u0987\u09a8 \u09b6\u0982\u09b8\u09be\u09aa\u09a4\u09cd\u09b0\u0997\u09c1\u09b2\u09bf \u0995\u09be\u09b0\u0993 \u09b8\u09be\u09a5\u09c7 \u09ad\u09be\u0997 \u0995\u09b0\u09c7 \u09a8\u09c7\u09ac\u09c7\u09a8 \u09a8\u09be\u0964\n- \u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09bf \u0995\u09cb\u09a8\u0993 \u0985\u09a8\u09a8\u09c1\u09ae\u09cb\u09a6\u09bf\u09a4 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8\u09c7\u09b0 \u09b8\u09a8\u09cd\u09a6\u09c7\u09b9 \u0995\u09b0\u09c7\u09a8 \u09a4\u09ac\u09c7 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0985\u09cd\u09af\u09be\u09aa \u09b8\u09ae\u09b0\u09cd\u09a5\u09a8 \u09ac\u09bf\u09ad\u09be\u0997\u09c7\u09b0 \u09ae\u09be\u09a7\u09cd\u09af\u09ae\u09c7 \u098f\u099f\u09bf \u09aa\u09cd\u09b0\u09a4\u09bf\u09ac\u09c7\u09a6\u09a8 \u0995\u09b0\u09c1\u09a8\u0964\n\n\u09eb. \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be \u098f\u09ac\u0982 \u09a1\u09c7\u099f\u09be:\n- \u0986\u09ae\u09b0\u09be \u0986\u09aa\u09a8\u09be\u09b0 \u0997\u09cb\u09aa\u09a8\u09c0\u09af\u09bc\u09a4\u09be\u09b0 \u09ae\u09c2\u09b2\u09cd\u09af \u09a6\u09bf\u0987\u0964 \u0986\u09aa\u09a8\u09be\u09b0 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u0997\u09a4 \u09a1\u09c7\u099f\u09be \u09a8\u09bf\u09b0\u09be\u09aa\u09a6\u09c7 \u09aa\u09b0\u09bf\u099a\u09be\u09b2\u09a8\u09be \u0995\u09b0\u09be \u09b9\u09ac\u09c7 \u098f\u09ac\u0982 \u0995\u09c7\u09ac\u09b2 \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u0985\u09ad\u09bf\u099c\u09cd\u099e\u09a4\u09be \u0989\u09a8\u09cd\u09a8\u09a4 \u0995\u09b0\u09a4\u09c7 \u09ac\u09cd\u09af\u09ac\u09b9\u09c3\u09a4 \u09b9\u09ac\u09c7\u0964\n- \u0986\u0987\u09a8 \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u09aa\u09cd\u09b0\u09af\u09bc\u09cb\u099c\u09a8\u09c0\u09af\u09bc \u09a8\u09be \u09b9\u09b2\u09c7 \u09ad\u09af\u09bc\u09c7\u09b8 \u09a1\u09c7\u099f\u09be \u098f\u09ac\u0982 \u099a\u09cd\u09af\u09be\u099f \u09ae\u09bf\u09a5\u09b8\u09cd\u0995\u09cd\u09b0\u09bf\u09af\u09bc\u09be \u09aa\u09cd\u09b0\u0995\u09be\u09b6\u09cd\u09af\u09c7 \u09ac\u09be \u09a4\u09c3\u09a4\u09c0\u09af\u09bc \u09aa\u0995\u09cd\u09b7\u09c7\u09b0 \u09b8\u09be\u09a5\u09c7 \u09ad\u09be\u0997 \u0995\u09b0\u09be \u09b9\u09af\u09bc \u09a8\u09be\u0964\n\n\u09ec. \u09aa\u09c7\u09ae\u09c7\u09a8\u09cd\u099f \u098f\u09ac\u0982 \u0995\u09af\u09bc\u09c7\u09a8:\n- \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf \u0995\u09af\u09bc\u09c7\u09a8 \u09ac\u09be \u09aa\u09cd\u09b0\u09bf\u09ae\u09bf\u09af\u09bc\u09be\u09ae \u09ac\u09c8\u09b6\u09bf\u09b7\u09cd\u099f\u09cd\u09af\u09c7\u09b0 \u09ae\u09a4\u09cb \u0987\u09a8-\u0985\u09cd\u09af\u09be\u09aa \u0995\u09cd\u09b0\u09af\u09bc\u09c7\u09b0 \u09aa\u09cd\u09b0\u09b8\u09cd\u09a4\u09be\u09ac \u09a6\u09bf\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964\n- \u0985\u09cd\u09af\u09be\u09aa \u09b8\u09cd\u099f\u09cb\u09b0\u09c7\u09b0 \u09a8\u09c0\u09a4\u09bf \u09a6\u09cd\u09ac\u09be\u09b0\u09be \u0985\u09a8\u09cd\u09af\u09a5\u09be\u09af\u09bc \u09ac\u09b2\u09be \u09a8\u09be \u09a5\u09be\u0995\u09b2\u09c7 \u09b8\u09ae\u09b8\u09cd\u09a4 \u0995\u09c7\u09a8\u09be\u0995\u09be\u099f\u09be \u099a\u09c2\u09a1\u09bc\u09be\u09a8\u09cd\u09a4 \u098f\u09ac\u0982 \u0985-\u09ab\u09c7\u09b0\u09a4\u09af\u09cb\u0997\u09cd\u09af\u0964\n\n\u09ed. \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u0985\u09ac\u09b8\u09be\u09a8:\n- \u0986\u09aa\u09a8\u09bf \u09af\u09a6\u09bf \u0995\u09cb\u09a8\u0993 \u09b6\u09b0\u09cd\u09a4 \u09b2\u0999\u09cd\u0998\u09a8 \u0995\u09b0\u09c7\u09a8 \u09a4\u09ac\u09c7 Yaro \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09b8\u09cd\u09a5\u0997\u09bf\u09a4 \u09ac\u09be \u09ac\u09be\u09a4\u09bf\u09b2 \u0995\u09b0\u09be\u09b0 \u0985\u09a7\u09bf\u0995\u09be\u09b0 \u09b8\u0982\u09b0\u0995\u09cd\u09b7\u09a3 \u0995\u09b0\u09c7\u0964\n- \u0986\u09aa\u09a8\u09bf \u09af\u09c7 \u0995\u09cb\u09a8\u0993 \u09b8\u09ae\u09af\u09bc \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u09b8\u09c7\u099f\u09bf\u0982\u09b8 \u09a5\u09c7\u0995\u09c7 \u0986\u09aa\u09a8\u09be\u09b0 \u0985\u09cd\u09af\u09be\u0995\u09be\u0989\u09a8\u09cd\u099f \u09ae\u09c1\u099b\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964\n\n\u09ee. \u0985\u09cd\u09af\u09be\u09aa \u09b8\u09be\u09ae\u0997\u09cd\u09b0\u09c0:\n- \u0995\u09bf\u099b\u09c1 \u09ad\u09bf\u099c\u09cd\u09af\u09c1\u09af\u09bc\u09be\u09b2, \u0985\u09ac\u09a4\u09be\u09b0 \u09ac\u09be \u0986\u0987\u0995\u09a8 \u0995\u09c3\u09a4\u09cd\u09b0\u09bf\u09ae \u09ac\u09c1\u09a6\u09cd\u09a7\u09bf\u09ae\u09a4\u09cd\u09a4\u09be (\u098f\u0986\u0987) \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0 \u0995\u09b0\u09c7 \u09a4\u09c8\u09b0\u09bf \u0995\u09b0\u09be \u09af\u09c7\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u0964\n- \u098f\u0997\u09c1\u09b2\u09bf \u09aa\u09cd\u09b0\u0995\u09c3\u09a4 \u09ac\u09cd\u09af\u0995\u09cd\u09a4\u09bf\u09a6\u09c7\u09b0 \u09aa\u09cd\u09b0\u09a4\u09bf\u09a8\u09bf\u09a7\u09bf\u09a4\u09cd\u09ac \u0995\u09b0\u09c7 \u09a8\u09be\u0964 \u09af\u09c7 \u0995\u09cb\u09a8\u0993 \u09b8\u09be\u09a6\u09c3\u09b6\u09cd\u09af \u09a8\u09bf\u0996\u09c1\u0981\u09a4 \u0995\u09be\u0995\u09a4\u09be\u09b2\u09c0\u09af\u09bc\u0964\n\n\u09ef. \u09b6\u09b0\u09cd\u09a4\u09be\u09ac\u09b2\u09c0\u09a4\u09c7 \u09aa\u09b0\u09bf\u09ac\u09b0\u09cd\u09a4\u09a8:\n\u0986\u09ae\u09b0\u09be \u09b8\u09ae\u09af\u09bc\u09c7 \u09b8\u09ae\u09af\u09bc\u09c7 \u098f\u0987 \u09b6\u09b0\u09cd\u09a4\u09be\u09ac\u09b2\u09c0 \u0986\u09aa\u09a1\u09c7\u099f \u0995\u09b0\u09a4\u09c7 \u09aa\u09be\u09b0\u09bf\u0964 \u0985\u09cd\u09af\u09be\u09aa\u099f\u09bf\u09b0 \u0985\u09ac\u09bf\u099a\u09cd\u099b\u09bf\u09a8\u09cd\u09a8 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u09c7\u09b0 \u0985\u09b0\u09cd\u09a5 \u0986\u09aa\u09a8\u09bf \u0986\u09aa\u09a1\u09c7\u099f \u09b9\u0993\u09af\u09bc\u09be \u09b6\u09b0\u09cd\u09a4\u09be\u09ac\u09b2\u09c0 \u0997\u09cd\u09b0\u09b9\u09a3 \u0995\u09b0\u09c7\u09a8\u0964\n\n\u09e7\u09e6. \u09b8\u09b9\u09be\u09af\u09bc\u09a4\u09be:\n\u09af\u09a6\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u0995\u09cb\u09a8\u0993 \u09aa\u09cd\u09b0\u09b6\u09cd\u09a8, \u0989\u09a6\u09cd\u09ac\u09c7\u0997 \u09ac\u09be \u0985\u09ad\u09bf\u09af\u09cb\u0997 \u09a5\u09be\u0995\u09c7 \u09a4\u09ac\u09c7 \u09a6\u09af\u09bc\u09be \u0995\u09b0\u09c7 \u0985\u09cd\u09af\u09be\u09aa\u09c7\u09b0 \u09b8\u09b9\u09be\u09af\u09bc\u09a4\u09be \u09ac\u09bf\u09ad\u09be\u0997 \u09a5\u09c7\u0995\u09c7 \u0986\u09ae\u09be\u09a6\u09c7\u09b0 \u0995\u09be\u099b\u09c7 \u09aa\u09cc\u0981\u099b\u09be\u09a8\u0964\n\n\u09a6\u09cd\u09b0\u09b7\u09cd\u099f\u09ac\u09cd\u09af: \u098f\u0987 \u09ac\u09cd\u09af\u09ac\u09b9\u09be\u09b0\u09c7\u09b0 \u09b6\u09b0\u09cd\u09a4\u09be\u09ac\u09b2\u09c0 \u098f\u0995\u099f\u09bf \u09b8\u09be\u09a7\u09be\u09b0\u09a3 \u0997\u09be\u0987\u09a1\u09b2\u09be\u0987\u09a8 \u098f\u09ac\u0982 \u09ad\u09be\u09b0\u09a4\u09c0\u09af\u09bc \u09a6\u09a3\u09cd\u09a1\u09ac\u09bf\u09a7\u09bf \u09ac\u09be \u0986\u0987\u099f\u09bf \u0986\u0987\u09a8 \u09b8\u09b9 \u09aa\u09cd\u09b0\u09af\u09cb\u099c\u09cd\u09af \u0986\u0987\u09a8\u09c7\u09b0 \u0985\u09a7\u09c0\u09a8\u09c7 \u0995\u09cb\u09a8\u0993 \u0986\u0987\u09a8\u09c0 \u09a8\u09bf\u09af\u09bc\u09ae\u0995\u09c7 \u09aa\u09cd\u09b0\u09a4\u09bf\u09b8\u09cd\u09a5\u09be\u09aa\u09a8 \u0995\u09b0\u09c7 \u09a8\u09be\u0964"},notifications:{title:"\u09ac\u09bf\u099c\u09cd\u099e\u09aa\u09cd\u09a4\u09bf",empty:"\u098f\u0996\u09a8\u0993 \u0995\u09cb\u09a8 \u09ac\u09bf\u099c\u09cd\u099e\u09aa\u09cd\u09a4\u09bf \u09a8\u09c7\u0987"},system_messages:{title:"\u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae \u09ac\u09be\u09b0\u09cd\u09a4\u09be",empty:"\u0995\u09cb\u09a8 \u09b8\u09bf\u09b8\u09cd\u099f\u09c7\u09ae \u09ac\u09be\u09b0\u09cd\u09a4\u09be \u09a8\u09c7\u0987"},recharge:{title:"\u0993\u09af\u09bc\u09be\u09b2\u09c7\u099f \u09b0\u09bf\u099a\u09be\u09b0\u09cd\u099c \u0995\u09b0\u09c1\u09a8",processing:"\u0995\u09cd\u09b0\u09af\u09bc \u09aa