6a9\u06be\u06cc\u06ba...",language:"\u0632\u0628\u0627\u0646",submit:"\u062c\u0645\u0639 \u06a9\u0631\u0627\u0626\u06cc\u06ba",name_error:"\u0646\u0627\u0645 20 \u062d\u0631\u0648\u0641 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u0646\u06c1\u06cc\u06ba \u06c1\u0648 \u0633\u06a9\u062a\u0627",bio_error:"\u0628\u0627\u0626\u06cc\u0648 100 \u062d\u0631\u0648\u0641 \u0633\u06d2 \u0632\u06cc\u0627\u062f\u06c1 \u0646\u06c1\u06cc\u06ba \u06c1\u0648 \u0633\u06a9\u062a\u0627",lang_error:"\u0622\u067e \u0635\u0631\u0641 2 \u0632\u0628\u0627\u0646\u06cc\u06ba \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba",username_length_error:"\u0635\u0627\u0631\u0641 \u0646\u0627\u0645 \u06a9\u0645 \u0627\u0632 \u06a9\u0645 3 \u062d\u0631\u0648\u0641 \u06a9\u0627 \u06c1\u0648\u0646\u0627 \u0686\u0627\u06c1\u06cc\u06d2",username_success:"\u0635\u0627\u0631\u0641 \u0646\u0627\u0645 \u06a9\u0627\u0645\u06cc\u0627\u0628\u06cc \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0645\u062a\u0639\u06cc\u0646 \u06c1\u0648 \u06af\u06cc\u0627!",username_fail:"\u0635\u0627\u0631\u0641 \u0646\u0627\u0645 \u0645\u062a\u0639\u06cc\u0646 \u06a9\u0631\u0646\u06d2 \u0645\u06cc\u06ba \u0646\u0627\u06a9\u0627\u0645",update_success:"\u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u0627\u067e \u0688\u06cc\u0679 \u06c1\u0648 \u06af\u0626\u06cc!",update_fail:"\u0627\u067e \u0688\u06cc\u0679 \u0646\u0627\u06a9\u0627\u0645 \u06c1\u0648 \u06af\u0626\u06cc",error:"\u062e\u0631\u0627\u0628\u06cc",success:"\u06a9\u0627\u0645\u06cc\u0627\u0628\u06cc",something_wrong:"\u06a9\u0686\u06be \u063a\u0644\u0637 \u06c1\u0648 \u06af\u06cc\u0627"},account:{title:"\u0627\u06a9\u0627\u0624\u0646\u0679",google_email:"Google \u0627\u06cc \u0645\u06cc\u0644",phone_number:"\u0641\u0648\u0646 \u0646\u0645\u0628\u0631",verified:"\u062a\u0635\u062f\u06cc\u0642 \u0634\u062f\u06c1",not_verified:"\u062a\u0635\u062f\u06cc\u0642 \u0646\u06c1\u06cc\u06ba \u06c1\u0648\u0626\u06cc",verify:"\u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u06cc\u06ba"},privacy_policy:{title:"\u0631\u0627\u0632\u062f\u0627\u0631\u06cc \u06a9\u06cc \u067e\u0627\u0644\u06cc\u0633\u06cc \u2014 Yaro",content:"\u0645\u0624\u062b\u0631 \u062a\u0627\u0631\u06cc\u062e: 15/08/2025\n\n---\n\n1. \u062a\u0639\u0627\u0631\u0641\n\nYaro (\"\u06c1\u0645\"\u060c \"\u06c1\u0645\u0627\u0631\u0627\"\u060c \u06cc\u0627 \"\u06c1\u0645\u06cc\u06ba\") \u0622\u067e \u06a9\u06cc \u0631\u0627\u0632\u062f\u0627\u0631\u06cc \u06a9\u0627 \u0627\u062d\u062a\u0631\u0627\u0645 \u06a9\u0631\u062a\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u0622\u067e \u06a9\u06d2 \u0630\u0627\u062a\u06cc \u0688\u06cc\u0679\u0627 \u06a9\u06cc \u062d\u0641\u0627\u0638\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u067e\u0631\u0639\u0632\u0645 \u06c1\u06d2\u06d4 \u06cc\u06c1 \u0631\u0627\u0632\u062f\u0627\u0631\u06cc \u06a9\u06cc \u067e\u0627\u0644\u06cc\u0633\u06cc \u0628\u062a\u0627\u062a\u06cc \u06c1\u06d2 \u06a9\u06c1 \u062c\u0628 \u0622\u067e \u06c1\u0645\u0627\u0631\u06cc \u0645\u0648\u0628\u0627\u0626\u0644 \u0627\u06cc\u067e\u0644\u06cc\u06a9\u06cc\u0634\u0646 (\"\u0627\u06cc\u067e\") \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u062a\u0648 \u06c1\u0645 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u06cc\u0633\u06d2 \u062c\u0645\u0639 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0638\u0627\u06c1\u0631 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\n\u0627\u06cc\u067e \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06a9\u06d2\u060c \u0622\u067e \u06cc\u06c1\u0627\u06ba \u0628\u06cc\u0627\u0646 \u06a9\u0631\u062f\u06c1 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u0648 \u062c\u0645\u0639 \u06a9\u0631\u0646\u06d2 \u0627\u0648\u0631 \u0627\u0633 \u06a9\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u0633\u06d2 \u0627\u062a\u0641\u0627\u0642 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\n2. \u06c1\u0645 \u062c\u0648 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u06a9\u0679\u06be\u0627 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\n2.1 \u0630\u0627\u062a\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a:\n\u062c\u0628 \u0622\u067e \u0627\u06cc\u067e \u06a9\u06d2 \u0644\u06cc\u06d2 \u0631\u062c\u0633\u0679\u0631 \u06c1\u0648\u062a\u06d2 \u06c1\u06cc\u06ba \u06cc\u0627 \u0627\u0633\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u062a\u0648 \u06c1\u0645 \u0622\u067e \u06a9\u0627 \u0646\u0627\u0645\u060c \u0635\u0627\u0631\u0641 \u0646\u0627\u0645\u060c \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u062a\u0635\u0648\u06cc\u0631\u060c \u0627\u06cc \u0645\u06cc\u0644 \u067e\u062a\u06c1\u060c \u0627\u0648\u0631 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u062c\u06cc\u0633\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u06a9\u0679\u06be\u0627 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\n2.2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0627 \u0688\u06cc\u0679\u0627:\n\u06c1\u0645 \u0627\u0633 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u0688\u06cc\u0679\u0627 \u0627\u06a9\u0679\u06be\u0627 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0622\u067e \u06a9\u0633 \u0637\u0631\u062d \u0627\u06cc\u067e \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u062c\u0633 \u0645\u06cc\u06ba \u062f\u06cc\u06af\u0631 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u062a\u0639\u0627\u0645\u0644\u0627\u062a\u060c \u0648\u0627\u0626\u0633 \u0686\u06cc\u0679 \u0644\u0627\u06af\u0632 \u0645\u06cc\u0679\u0627 \u0688\u06cc\u0679\u0627 (\u0645\u0648\u0627\u062f \u0646\u06c1\u06cc\u06ba)\u060c \u0627\u0648\u0631 \u0627\u06cc\u067e \u06a9\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06d2 \u0627\u0639\u062f\u0627\u062f\u0648\u0634\u0645\u0627\u0631 \u0634\u0627\u0645\u0644 \u06c1\u06cc\u06ba\u06d4\n\n2.3 \u0688\u06cc\u0648\u0627\u0626\u0633 \u06a9\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a:\n\u0622\u067e \u06a9\u06d2 \u0622\u0644\u06d2 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u060c \u062c\u06cc\u0633\u06d2 \u0688\u06cc\u0648\u0627\u0626\u0633 \u06a9\u06cc \u0642\u0633\u0645\u060c \u0622\u067e\u0631\u06cc\u0679\u0646\u06af \u0633\u0633\u0679\u0645 \u06a9\u0627 \u0648\u0631\u0698\u0646\u060c \u0645\u0646\u0641\u0631\u062f \u0688\u06cc\u0648\u0627\u0626\u0633 \u0634\u0646\u0627\u062e\u062a \u06a9\u0646\u0646\u062f\u06c1\u060c IP \u0627\u06cc\u0688\u0631\u06cc\u0633\u060c \u0627\u0648\u0631 \u0645\u0648\u0628\u0627\u0626\u0644 \u0646\u06cc\u0679 \u0648\u0631\u06a9 \u06a9\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u06d4\n\n3. \u06c1\u0645 \u0622\u067e \u06a9\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u0648 \u06a9\u0633 \u0637\u0631\u062d \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\n\u2022 \u0648\u0627\u0626\u0633 \u06a9\u0627\u0644 \u0627\u0648\u0631 \u0686\u06cc\u0679 \u0633\u0631\u0648\u0633\u0632 \u0633\u0645\u06cc\u062a \u0627\u06cc\u067e \u06a9\u06cc \u062e\u0635\u0648\u0635\u06cc\u0627\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u06d2 \u0627\u0648\u0631 \u0628\u0631\u0642\u0631\u0627\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u06d4\n\u2022 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc\u0648\u06ba \u067e\u0631 \u06a9\u0627\u0631\u0631\u0648\u0627\u0626\u06cc \u06a9\u0631\u0646\u06d2 \u0627\u0648\u0631 \u0627\u067e\u0646\u06d2 \u0627\u06a9\u0627\u0624\u0646\u0679 \u06a9\u0627 \u0627\u0646\u062a\u0638\u0627\u0645 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u06d4\n\u2022 \u0627\u067e \u0688\u06cc\u0679\u0633\u060c \u067e\u0631\u0648\u0645\u0648\u0634\u0646\u0632 \u0627\u0648\u0631 \u062a\u0639\u0627\u0648\u0646 \u06a9\u06d2 \u062d\u0648\u0627\u0644\u06d2 \u0633\u06d2 \u0622\u067e \u0633\u06d2 \u0628\u0627\u062a \u0686\u06cc\u062a \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u06d4\n\u2022 \u06c1\u0645\u0627\u0631\u06cc \u0627\u06cc\u067e \u06a9\u0648 \u0628\u06c1\u062a\u0631 \u0628\u0646\u0627\u0646\u06d2 \u0627\u0648\u0631 \u0646\u0626\u06cc \u062e\u0635\u0648\u0635\u06cc\u0627\u062a \u062a\u06cc\u0627\u0631 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u06d4\n\u2022 \u062f\u06be\u0648\u06a9\u06c1 \u062f\u06c1\u06cc \u06cc\u0627 \u063a\u06cc\u0631 \u0642\u0627\u0646\u0648\u0646\u06cc \u0633\u0631\u06af\u0631\u0645\u06cc\u0648\u06ba \u06a9\u0627 \u067e\u062a\u06c1 \u0644\u06af\u0627\u0646\u06d2 \u0627\u0648\u0631 \u0631\u0648\u06a9\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2\u06d4\n\n5. \u0635\u0627\u0631\u0641 \u06a9\u0627 \u062a\u06cc\u0627\u0631 \u06a9\u0631\u062f\u06c1 \u0645\u0648\u0627\u062f (UGC) \u067e\u0627\u0644\u06cc\u0633\u06cc\n\n\u2022 **\u0635\u0641\u0631 \u0631\u0648\u0627\u062f\u0627\u0631\u06cc**: \u0642\u0627\u0628\u0644 \u0627\u0639\u062a\u0631\u0627\u0636 \u0645\u0648\u0627\u062f \u06cc\u0627 \u0628\u062f\u0633\u0644\u0648\u06a9\u06cc \u06a9\u0631\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06c1\u0645\u0627\u0631\u06cc \u0632\u06cc\u0631\u0648 \u0679\u0627\u0644\u0631\u06cc\u0646\u0633 \u067e\u0627\u0644\u06cc\u0633\u06cc \u06c1\u06d2\u06d4\n\u2022 **\u0631\u067e\u0648\u0631\u0679\u0646\u06af**: \u0622\u067e \u0635\u0627\u0631\u0641 \u06a9\u06d2 \u067e\u0631\u0648\u0641\u0627\u0626\u0644\u0632 \u06cc\u0627 \u0686\u06cc\u0679 \u0627\u0633\u06a9\u0631\u06cc\u0646\u0632 \u067e\u0631 '\u0631\u067e\u0648\u0631\u0679' \u0628\u0679\u0646 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0627\u06cc\u067e \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u0628\u0631\u0627\u06c1 \u0631\u0627\u0633\u062a \u0646\u0627\u0645\u0646\u0627\u0633\u0628 \u0645\u0648\u0627\u062f \u06cc\u0627 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u06cc \u0627\u0637\u0644\u0627\u0639 \u062f\u06d2 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\u2022 **\u0628\u0644\u0627\u06a9 \u06a9\u0631\u0646\u0627**: \u0622\u067e \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0635\u0627\u0631\u0641 \u06a9\u0648 \u0622\u067e \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u0646\u06d2 \u0633\u06d2 \u0631\u0648\u06a9\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633\u06d2 \u0628\u0644\u0627\u06a9 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\u2022 **\u06a9\u0627\u0631\u0631\u0648\u0627\u0626\u06cc**: \u06c1\u0645 24 \u06af\u06be\u0646\u0679\u0648\u06ba \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u0631\u067e\u0648\u0631\u0679\u0633 \u06a9\u0627 \u062c\u0627\u0626\u0632\u06c1 \u0644\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0645\u062c\u0631\u0645\u0627\u0646\u06c1 \u0645\u0648\u0627\u062f \u06a9\u0648 \u06c1\u0679\u0627 \u062f\u06cc\u06ba \u06af\u06d2 \u0627\u0648\u0631 \u06c1\u0645\u0627\u0631\u06cc \u0634\u0631\u0627\u0626\u0637 \u06a9\u06cc \u062e\u0644\u0627\u0641 \u0648\u0631\u0632\u06cc \u06a9\u0631\u0646\u06d2 \u0648\u0627\u0644\u06d2 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u0645\u0639\u0637\u0644 \u06a9\u0631 \u062f\u06cc\u06ba \u06af\u06d2\u06d4\n\u2022 **\u0645\u0645\u0646\u0648\u0639\u06c1 \u0645\u0648\u0627\u062f**: \u0646\u0641\u0631\u062a \u0627\u0646\u06af\u06cc\u0632 \u062a\u0642\u0627\u0631\u06cc\u0631\u060c \u0639\u0631\u06cc\u0627\u0646\u06cc\u062a\u060c \u062a\u0634\u062f\u062f\u060c \u063a\u0646\u0688\u06c1 \u06af\u0631\u062f\u06cc \u0627\u0648\u0631 \u06c1\u0631\u0627\u0633\u0627\u06ba \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u0633\u062e\u062a\u06cc \u0633\u06d2 \u0645\u0645\u0627\u0646\u0639\u062a \u06c1\u06d2\u06d4\n\n6. \u0688\u06cc\u0679\u0627 \u0634\u06cc\u0626\u0631\u0646\u06af \u0627\u0648\u0631 \u0627\u0646\u06a9\u0634\u0627\u0641\n\n\u2022 \u06c1\u0645 \u0622\u067e \u06a9\u06cc \u0630\u0627\u062a\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062a\u06cc\u0633\u0631\u06d2 \u0641\u0631\u06cc\u0642 \u06a9\u0648 \u0641\u0631\u0648\u062e\u062a \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\u2022 \u06c1\u0645 \u0622\u067e \u06a9\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0645\u0633\u062a\u0646\u062f \u062e\u062f\u0645\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0646\u0646\u062f\u06af\u0627\u0646 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0634\u06cc\u0626\u0631 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u062c\u0648 \u0627\u06cc\u067e \u06a9\u0648 \u0686\u0644\u0627\u0646\u06d2 \u0645\u06cc\u06ba \u0645\u062f\u062f \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u060c \u0631\u0627\u0632\u062f\u0627\u0631\u06cc \u06a9\u06d2 \u0645\u0639\u0627\u06c1\u062f\u0648\u06ba \u0633\u06d2 \u0645\u0634\u0631\u0648\u0637\u06d4\n\u2022 \u06c1\u0645 \u0622\u067e \u06a9\u0627 \u0688\u06cc\u0679\u0627 \u0638\u0627\u06c1\u0631 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u0627\u06af\u0631 \u0642\u0627\u0646\u0648\u0646 \u06a9\u06cc \u0637\u0631\u0641 \u0633\u06d2 \u0636\u0631\u0648\u0631\u062a \u06c1\u0648 \u06cc\u0627 \u0627\u067e\u0646\u06d2 \u062d\u0642\u0648\u0642 \u06a9\u06d2 \u062a\u062d\u0641\u0638 \u06a9\u06d2 \u0644\u06cc\u06d2\u06d4\n\n5. \u062f\u0631\u0648\u0646 \u0627\u06cc\u067e \u062e\u0631\u06cc\u062f\u0627\u0631\u06cc \u0627\u0648\u0631 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc\u0627\u06ba\n\n\u062a\u0645\u0627\u0645 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc\u0648\u06ba \u06a9\u0648 \u0627\u06cc\u067e \u0627\u0633\u0679\u0648\u0631 \u06a9\u06d2 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u06d2 \u0646\u0638\u0627\u0645 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0645\u062d\u0641\u0648\u0638 \u0637\u0631\u06cc\u0642\u06d2 \u0633\u06d2 \u0639\u0645\u0644 \u0645\u06cc\u06ba \u0644\u0627\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u06d4 \u06c1\u0645 \u0622\u067e \u06a9\u06cc \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u06cc \u062a\u0641\u0635\u06cc\u0644\u0627\u062a \u0628\u0631\u0627\u06c1 \u0631\u0627\u0633\u062a \u0630\u062e\u06cc\u0631\u06c1 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\n6. \u0622\u067e \u06a9\u06d2 \u062d\u0642\u0648\u0642 \u0627\u0648\u0631 \u0627\u0646\u062a\u062e\u0627\u0628\n\n\u2022 \u0622\u067e \u0627\u06cc\u067e \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u06cc\u0627 \u062a\u0639\u0627\u0648\u0646 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631 \u06a9\u06d2 \u0627\u067e\u0646\u06cc \u0630\u0627\u062a\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc\u060c \u0627\u067e \u0688\u06cc\u0679\u060c \u06cc\u0627 \u062d\u0630\u0641 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\u2022 \u0622\u067e \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0648\u0642\u062a \u067e\u0631\u0648\u0645\u0648\u0634\u0646\u0644 \u06a9\u0645\u06cc\u0648\u0646\u06cc\u06a9\u06cc\u0634\u0646\u0632 \u062d\u0627\u0635\u0644 \u06a9\u0631\u0646\u06d2 \u0633\u06d2 \u0622\u067e\u0679 \u0622\u0624\u0679 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\u2022 \u0622\u067e \u0627\u06cc\u067e \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0648\u0642\u062a \u0627\u067e\u0646\u0627 \u0627\u06a9\u0627\u0624\u0646\u0679 \u062d\u0630\u0641 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\n7. \u0688\u06cc\u0679\u0627 \u0633\u06cc\u06a9\u06cc\u0648\u0631\u0679\u06cc\n\n\u06c1\u0645 \u0622\u067e \u06a9\u06cc \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u0648 \u063a\u06cc\u0631 \u0645\u062c\u0627\u0632 \u0631\u0633\u0627\u0626\u06cc\u060c \u062a\u0628\u062f\u06cc\u0644\u06cc\u060c \u0627\u0646\u06a9\u0634\u0627\u0641 \u06cc\u0627 \u062a\u0628\u0627\u06c1\u06cc \u0633\u06d2 \u0628\u0686\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0646\u0688\u0633\u0679\u0631\u06cc \u06a9\u06d2 \u0645\u0639\u06cc\u0627\u0631\u06cc \u062a\u06a9\u0646\u06cc\u06a9\u06cc \u0627\u0648\u0631 \u062a\u0646\u0638\u06cc\u0645\u06cc \u0627\u0642\u062f\u0627\u0645\u0627\u062a \u06a9\u0648 \u0646\u0627\u0641\u0630 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\n8. \u0628\u0686\u0648\u06ba \u06a9\u06cc \u0631\u0627\u0632\u062f\u0627\u0631\u06cc\n\n\u06c1\u0645\u0627\u0631\u06cc \u0627\u06cc\u067e 18 \u0633\u0627\u0644 \u0633\u06d2 \u06a9\u0645 \u0639\u0645\u0631 \u06a9\u06d2 \u0628\u0686\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2 \u0646\u06c1\u06cc\u06ba \u06c1\u06d2\u06d4 \u06c1\u0645 \u062c\u0627\u0646 \u0628\u0648\u062c\u06be \u06a9\u0631 18 \u0633\u0627\u0644 \u0633\u06d2 \u06a9\u0645 \u0639\u0645\u0631 \u06a9\u06d2 \u06a9\u0633\u06cc \u0633\u06d2 \u0628\u06be\u06cc \u0688\u06cc\u0679\u0627 \u0627\u06a9\u0679\u06be\u0627 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\n9. \u0627\u0633 \u0631\u0627\u0632\u062f\u0627\u0631\u06cc \u06a9\u06cc \u067e\u0627\u0644\u06cc\u0633\u06cc \u0645\u06cc\u06ba \u062a\u0628\u062f\u06cc\u0644\u06cc\u0627\u06ba\n\n\u06c1\u0645 \u0648\u0642\u062a\u0627\u064b \u0641\u0648\u0642\u062a\u0627\u064b \u0627\u0633 \u0631\u0627\u0632\u062f\u0627\u0631\u06cc \u06a9\u06cc \u067e\u0627\u0644\u06cc\u0633\u06cc \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06c1\u0645 \u0627\u0633 \u0635\u0641\u062d\u06c1 \u067e\u0631 \u0646\u0626\u06cc \u067e\u0631\u0627\u0626\u06cc\u0648\u06cc\u0633\u06cc \u067e\u0627\u0644\u06cc\u0633\u06cc \u067e\u0648\u0633\u0679 \u06a9\u0631 \u06a9\u06d2 \u0622\u067e \u0622\u067e \u06a9\u0648 \u06a9\u0633\u06cc \u0628\u06be\u06cc \u062a\u0628\u062f\u06cc\u0644\u06cc \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u0645\u0637\u0644\u0639 \u06a9\u0631\u06cc\u06ba \u06af\u06d2\u06d4 \u062a\u0628\u062f\u06cc\u0644\u06cc\u0648\u06ba \u06a9\u06d2 \u0628\u0639\u062f \u0627\u06cc\u067e \u06a9\u06d2 \u0645\u0633\u0644\u0633\u0644 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0627 \u0645\u0637\u0644\u0628 \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u0627\u067e \u0688\u06cc\u0679 \u0634\u062f\u06c1 \u067e\u0627\u0644\u06cc\u0633\u06cc \u06a9\u0648 \u0642\u0628\u0648\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\n10. \u06c1\u0645 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba\u06d4\n\n\u0627\u0633 \u0631\u0627\u0632\u062f\u0627\u0631\u06cc \u06a9\u06cc \u067e\u0627\u0644\u06cc\u0633\u06cc \u06cc\u0627 \u0622\u067e \u06a9\u06d2 \u0688\u06cc\u0679\u0627 \u06a9\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0633\u0648\u0627\u0644 \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u06cc\u067e \u0645\u06cc\u06ba \u0633\u067e\u0648\u0631\u0679 \u0633\u06cc\u06a9\u0634\u0646 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u06c1\u0645 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba\u06d4\n\nYaro \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06a9\u06d2\u060c \u0622\u067e \u062a\u0633\u0644\u06cc\u0645 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0622\u067e \u0646\u06d2 \u067e\u0631\u0627\u0626\u06cc\u0648\u06cc\u0633\u06cc \u067e\u0627\u0644\u06cc\u0633\u06cc \u06a9\u0648 \u067e\u0691\u06be \u0644\u06cc\u0627 \u06c1\u06d2 \u0627\u0648\u0631 \u0627\u0633 \u0633\u06d2 \u0627\u062a\u0641\u0627\u0642 \u06a9\u06cc\u0627 \u06c1\u06d2\u06d4"},about_us:{title:"\u06c1\u0645\u0627\u0631\u06d2 \u0628\u0627\u0631\u06d2 \u0645\u06cc\u06ba \u2013 Yaro",content:"Yaro \u0645\u06cc\u06ba \u062e\u0648\u0634 \u0622\u0645\u062f\u06cc\u062f - \u0627\u06cc\u06a9 \u0646\u062c\u06cc 1-\u0622\u0646-1 \u0648\u0627\u0626\u0633 \u06a9\u0627\u0644\u0646\u06af \u0627\u0648\u0631 \u0641\u0631\u06cc\u0646\u0688\u0634\u067e \u0627\u06cc\u067e!\n\nYaro \u0627\u06cc\u06a9 \u0633\u0645\u0627\u062c\u06cc \u0622\u0648\u0627\u0632 \u06a9\u0627 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u06c1\u06d2 \u062c\u0648 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u0631\u06cc\u0626\u0644 \u0679\u0627\u0626\u0645 1-\u0622\u0646-1 \u0635\u0648\u062a\u06cc \u06a9\u0627\u0644\u0648\u06ba \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u062c\u0691\u0646\u06d2 \u0645\u06cc\u06ba \u0645\u062f\u062f \u06a9\u0631\u062a\u0627 \u06c1\u06d2\u06d4 \u0686\u0627\u06c1\u06d2 \u0622\u067e \u0628\u0627\u062a \u06a9\u0631\u0646\u0627\u060c \u0646\u0626\u06d2 \u062f\u0648\u0633\u062a \u0628\u0646\u0627\u0646\u0627\u060c \u06cc\u0627 \u0635\u0631\u0641 \u0648\u0642\u062a \u06af\u0632\u0627\u0631\u0646\u0627 \u0686\u0627\u06c1\u062a\u06d2 \u06c1\u0648\u060c Yaro \u0628\u0627\u0645\u0639\u0646\u06cc \u0635\u0648\u062a\u06cc \u0628\u0627\u062a \u0686\u06cc\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06cc\u06a9 \u0645\u062d\u0641\u0648\u0638 \u0627\u0648\u0631 \u062f\u0644\u06a9\u0634 \u062c\u06af\u06c1 \u067e\u06cc\u0634 \u06a9\u0631\u062a\u06cc \u06c1\u06d2\u06d4\n\n\ud83c\udfaf \u0627\u06c1\u0645 \u062e\u0635\u0648\u0635\u06cc\u0627\u062a:\n\n\u2022 1-\u0622\u0646-1 \u0631\u06cc\u0626\u0644 \u0679\u0627\u0626\u0645 \u0648\u0627\u0626\u0633 \u06a9\u0627\u0644\u0646\u06af\n\u2022 \u0633\u06a9\u06d2 \u067e\u0631 \u0645\u0628\u0646\u06cc \u06a9\u0627\u0644\u0646\u06af \u0633\u0633\u0679\u0645 (\u0622\u0633\u0627\u0646 \u0631\u06cc\u0686\u0627\u0631\u062c \u06a9\u06d2 \u0633\u0627\u062a\u06be)\n\u2022 \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u06a9\u06d2 \u062d\u0633\u0628 \u0636\u0631\u0648\u0631\u062a (\u0627\u0648\u062a\u0627\u0631 \u060c \u0628\u0627\u0626\u06cc\u0648\u0633)\n\u2022 \u0646\u0626\u06d2 \u0644\u0648\u06af\u0648\u06ba \u0633\u06d2 \u0645\u0644\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0633\u0645\u0627\u0631\u0679 \u0645\u06cc\u0686 \u0645\u06cc\u06a9\u0646\u06af\n\u2022 \u0645\u06a9\u0645\u0644 \u0631\u0627\u0632\u062f\u0627\u0631\u06cc \u06a9\u06d2 \u06a9\u0646\u0679\u0631\u0648\u0644\u0632 - \u0628\u0644\u0627\u06a9\u060c \u0631\u067e\u0648\u0631\u0679\u060c \u0648\u063a\u06cc\u0631\u06c1\u06d4\n\n\ud83d\udd12 \u0645\u062d\u0641\u0648\u0638 \u0627\u0648\u0631 \u0642\u0627\u0628\u0644 \u0627\u062d\u062a\u0631\u0627\u0645 \u0645\u0627\u062d\u0648\u0644\n\n\u06c1\u0645 \u0635\u0627\u0631\u0641 \u06a9\u06cc \u062d\u0641\u0627\u0638\u062a \u06a9\u0648 \u062a\u0631\u062c\u06cc\u062d \u062f\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06c1\u0645\u0627\u0631\u06d2 \u067e\u0644\u06cc\u0679 \u0641\u0627\u0631\u0645 \u0645\u06cc\u06ba \u06c1\u0631 \u0627\u06cc\u06a9 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0645\u062d\u0641\u0648\u0638 \u0627\u0648\u0631 \u0628\u062f\u0633\u0644\u0648\u06a9\u06cc \u0633\u06d2 \u067e\u0627\u06a9 \u062a\u062c\u0631\u0628\u06c1 \u06a9\u0648 \u0628\u0631\u0642\u0631\u0627\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0633\u062e\u062a \u0627\u0639\u062a\u062f\u0627\u0644 \u067e\u0633\u0646\u062f \u0679\u0648\u0644\u0632\u060c \u0631\u067e\u0648\u0631\u0679\u0646\u06af \u06a9\u06cc \u062e\u0635\u0648\u0635\u06cc\u0627\u062a\u060c \u0627\u0648\u0631 \u0635\u0627\u0631\u0641 \u06a9\u06d2 \u06a9\u0646\u0679\u0631\u0648\u0644 \u0634\u0627\u0645\u0644 \u06c1\u06cc\u06ba\u06d4\n\n\ud83c\udf0d \u06c1\u0645 \u06a9\u0648\u0646 \u06c1\u06cc\u06ba\u06d4\n\nYaro \u06c1\u0646\u062f\u0648\u0633\u062a\u0627\u0646 \u0645\u06cc\u06ba \u0642\u0627\u0626\u0645 \u0627\u06cc\u06a9 \u0679\u06cc\u0645 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06c1 \u062a\u06cc\u0627\u0631 \u06a9\u06cc \u06af\u0626\u06cc \u06c1\u06d2 \u062c\u0648 \u0645\u062d\u0641\u0648\u0638 \u0627\u0648\u0631 \u0622\u0648\u0627\u0632 \u067e\u0631 \u0645\u0628\u0646\u06cc \u0633\u0645\u0627\u062c\u06cc \u062a\u062c\u0631\u0628\u0627\u062a \u06a9\u06cc \u062a\u0639\u0645\u06cc\u0631 \u06a9\u0627 \u062c\u0630\u0628\u06c1 \u0631\u06a9\u06be\u062a\u06cc \u06c1\u06d2\u06d4\n\n\ud83d\udcf1 \u0627\u06cc\u067e \u06a9\u06cc \u062f\u0633\u062a\u06cc\u0627\u0628\u06cc:\n\nGoogle Play Store \u067e\u0631 \u062f\u0633\u062a\u06cc\u0627\u0628 \u06c1\u06d2\u06d4\nhttps://play.google.com/store/apps/details?id=yaro.vc.app\n\n\ud83d\udcec \u06c1\u0645 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba:\n\n\u0627\u06cc \u0645\u06cc\u0644: support@yaroapp.in\n\u0627\u06cc\u067e \u06a9\u06d2 \u0627\u0646\u062f\u0631: \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u2192 \u0645\u062f\u062f \u0627\u0648\u0631 \u062a\u0639\u0627\u0648\u0646 \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba\u06d4"},contact_us:{title:"\u06c1\u0645 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba\u06d4",part1:"Yaro \u0645\u06cc\u06ba\u060c \u06c1\u0645 \u062a\u0645\u0627\u0645 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u0628\u063a\u06cc\u0631 \u06a9\u0633\u06cc \u0631\u06a9\u0627\u0648\u0679 \u06a9\u06d2 \u0627\u0648\u0631 \u0645\u062d\u0641\u0648\u0638 \u0648\u0627\u0626\u0633 \u06a9\u0627\u0644\u0646\u06af \u06a9\u0627 \u062a\u062c\u0631\u0628\u06c1 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u067e\u0631\u0639\u0632\u0645 \u06c1\u06cc\u06ba\u06d4 \u0627\u06af\u0631 \u0622\u067e \u06a9\u0648 \u0627\u06cc\u067e\u060c \u06c1\u0645\u0627\u0631\u06cc \u062e\u062f\u0645\u0627\u062a\u060c \u06cc\u0627 \u0627\u067e\u0646\u06d2 \u0627\u06a9\u0627\u0624\u0646\u0679 \u06a9\u06d2 \u062d\u0648\u0627\u0644\u06d2 \u0633\u06d2 \u06a9\u0648\u0626\u06cc \u0633\u0648\u0627\u0644\u0627\u062a\u060c \u0622\u0631\u0627\u0621 \u06cc\u0627 \u062e\u062f\u0634\u0627\u062a \u06c1\u06cc\u06ba\u060c \u062a\u0648 \u0628\u0644\u0627 \u062c\u06be\u062c\u06be\u06a9 \u06c1\u0645 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba\u06d4\n\n\ud83d\udcec \u0633\u067e\u0648\u0631\u0679 \u0627\u06cc \u0645\u06cc\u0644:\n",part2:"\n\u06c1\u0645 \u0639\u0627\u0645 \u0637\u0648\u0631 \u067e\u0631 24-48 \u06a9\u0627\u0631\u0648\u0628\u0627\u0631\u06cc \u06af\u06be\u0646\u0679\u0648\u06ba \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u062c\u0648\u0627\u0628 \u062f\u06cc\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\n\ud83d\udee0 \u062f\u0631\u0648\u0646 \u0627\u06cc\u067e \u0633\u067e\u0648\u0631\u0679:\n\u0622\u067e \u0627\u06cc\u067e \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u0633\u06d2 \u0628\u06be\u06cc \u06c1\u0645 \u062a\u06a9 \u067e\u06c1\u0646\u0686 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba:\n\n1. \u0627\u067e\u0646\u06d2 \u067e\u0631\u0648\u0641\u0627\u0626\u0644 \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba\n2. \u06c1\u06cc\u0644\u067e \u0627\u06cc\u0646\u0688 \u0633\u067e\u0648\u0631\u0679 \u067e\u0631 \u0679\u06cc\u067e \u06a9\u0631\u06cc\u06ba\n3. \u0627\u067e\u0646\u0627 \u0645\u0633\u0626\u0644\u06c1 \u06cc\u0627 \u0631\u0627\u0626\u06d2 \u0628\u0631\u0627\u06c1 \u0631\u0627\u0633\u062a \u062c\u0645\u0639 \u06a9\u0631\u0648\u0627\u0626\u06cc\u06ba\u06d4\n\n\ud83e\uddd1\u200d\u2696 \u0642\u0627\u0646\u0648\u0646\u06cc \u0627\u0648\u0631 \u067e\u0627\u0644\u06cc\u0633\u06cc \u06a9\u06d2 \u0633\u0648\u0627\u0644\u0627\u062a:\n\u0642\u0627\u0646\u0648\u0646\u06cc \u0645\u0639\u0627\u0645\u0644\u0627\u062a\u060c \u0631\u0627\u0632\u062f\u0627\u0631\u06cc \u06a9\u06d2 \u062e\u062f\u0634\u0627\u062a\u060c \u06cc\u0627 \u0633\u0631\u0648\u0633 \u06a9\u06cc \u0634\u0631\u0627\u0626\u0637 \u0633\u06d2 \u0645\u062a\u0639\u0644\u0642 \u067e\u0648\u0686\u06be \u06af\u0686\u06be \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0622\u067e \u06c1\u0645\u06cc\u06ba ",part3:" \u067e\u0631 \u0627\u06cc \u0645\u06cc\u0644 \u0628\u06be\u06cc \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba \u062c\u0633 \u0645\u06cc\u06ba \u0648\u0627\u0636\u062d \u0637\u0648\u0631 \u067e\u0631 \u0622\u067e \u06a9\u06cc \u062a\u0634\u0648\u06cc\u0634 \u06a9\u0627 \u062d\u0648\u0627\u0644\u06c1 \u062f\u06cc\u0627 \u06af\u06cc\u0627 \u06c1\u0648 (\u0645\u062b\u0644\u0627\u064b \"\u067e\u0631\u0627\u0626\u06cc\u0648\u06cc\u0633\u06cc \u062a\u0634\u0648\u06cc\u0634\"\u060c \"\u0633\u0631\u0648\u0633 \u06a9\u06cc \u0634\u0631\u0627\u0626\u0637 \u06a9\u0627 \u0633\u0648\u0627\u0644\")\u06d4"},refund_policy:{title:"\u0631\u0642\u0645 \u06a9\u06cc \u0648\u0627\u067e\u0633\u06cc \u06a9\u06cc \u067e\u0627\u0644\u06cc\u0633\u06cc \u2013 Yaro",content:"\u0645\u0624\u062b\u0631 \u062a\u0627\u0631\u06cc\u062e: 15/08/2025\n\n1. \u0639\u0645\u0648\u0645\u06cc \u067e\u0627\u0644\u06cc\u0633\u06cc\n\nYaro \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u06a9\u06cc \u06af\u0626\u06cc \u062a\u0645\u0627\u0645 \u062e\u0631\u06cc\u062f\u0627\u0631\u06cc\u0648\u06ba \u06a9\u0648 \u062d\u062a\u0645\u06cc \u0627\u0648\u0631 \u0646\u0627\u0642\u0627\u0628\u0644 \u0648\u0627\u067e\u0633\u06cc \u0633\u0645\u062c\u06be\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u06d4 \u06c1\u0645 \u0648\u0631\u0686\u0648\u0626\u0644 \u0645\u0648\u0627\u062f \u0627\u0648\u0631 \u062e\u062f\u0645\u0627\u062a \u062c\u06cc\u0633\u06d2 \u0648\u0627\u0626\u0633 \u0686\u06cc\u0679 \u062a\u06a9 \u0631\u0633\u0627\u0626\u06cc\u060c \u0648\u0631\u0686\u0648\u0626\u0644 \u0633\u06a9\u06d2 \u0627\u0648\u0631 \u067e\u0631\u06cc\u0645\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc\u0627\u062a \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0627\u06cc\u06a9 \u0628\u0627\u0631 \u062e\u0631\u06cc\u062f\u06d2 \u062c\u0627\u0646\u06d2 \u06a9\u06d2 \u0628\u0639\u062f\u060c \u06cc\u06c1 \u062e\u062f\u0645\u0627\u062a \u0641\u0648\u0631\u06cc \u0637\u0648\u0631 \u067e\u0631 \u0641\u0631\u0627\u06c1\u0645 \u06a9\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0627\u0646\u06c1\u06cc\u06ba \u0648\u0627\u067e\u0633 \u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627\u06d4\n\n2. \u0627\u06cc\u067e \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u062e\u0631\u06cc\u062f\u0627\u0631\u06cc\n\n\u2022 \u06af\u0648\u06af\u0644 \u067e\u0644\u06d2 \u0627\u0633\u0679\u0648\u0631 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u06a9\u06cc \u06af\u0626\u06cc \u062e\u0631\u06cc\u062f\u0627\u0631\u06cc\u0627\u06ba \u06af\u0648\u06af\u0644 \u067e\u0644\u06d2 \u06a9\u06d2 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u06d2 \u0646\u0638\u0627\u0645 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0633\u0646\u0628\u06be\u0627\u0644\u06cc \u062c\u0627\u062a\u06cc \u06c1\u06cc\u06ba\u06d4\n\u2022 \u06c1\u0645 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc\u0648\u06ba \u067e\u0631 \u0628\u0631\u0627\u06c1 \u0631\u0627\u0633\u062a \u06a9\u0627\u0631\u0631\u0648\u0627\u0626\u06cc \u06cc\u0627 \u0627\u0646\u062a\u0638\u0627\u0645 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\u2022 \u0634\u0627\u0630 \u0648 \u0646\u0627\u062f\u0631 \u0635\u0648\u0631\u062a\u0648\u06ba \u0645\u06cc\u06ba\u060c \u0631\u06cc\u0641\u0646\u0688\u0632 \u067e\u0631 \u063a\u0648\u0631 \u06a9\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2 \u0627\u06af\u0631 \u0635\u0627\u0631\u0641 \u06a9\u0648 \u062a\u06a9\u0646\u06cc\u06a9\u06cc \u0645\u0633\u0627\u0626\u0644 \u06cc\u0627 \u062d\u0627\u062f\u062b\u0627\u062a\u06cc \u062e\u0631\u06cc\u062f\u0627\u0631\u06cc \u06a9\u0627 \u0633\u0627\u0645\u0646\u0627 \u06a9\u0631\u0646\u0627 \u067e\u0691\u06d2\u06d4\n\n3. \u0631\u06cc\u0641\u0646\u0688 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u06c1\u0644\u06cc\u062a\n\n\u0631\u0642\u0645 \u06a9\u06cc \u0648\u0627\u067e\u0633\u06cc \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a\u0648\u06ba \u06a9\u0627 \u06c1\u0631 \u0645\u0639\u0627\u0645\u0644\u06d2 \u06a9\u06cc \u0628\u0646\u06cc\u0627\u062f \u067e\u0631 \u062c\u0627\u0626\u0632\u06c1 \u0644\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u0627\u0648\u0631 \u0635\u0631\u0641 \u062f\u0631\u062c \u0630\u06cc\u0644 \u0634\u0631\u0627\u0626\u0637 \u06a9\u06d2 \u062a\u062d\u062a \u0645\u0646\u0638\u0648\u0631 \u06a9\u06cc\u0627 \u062c\u0627 \u0633\u06a9\u062a\u0627 \u06c1\u06d2:\n\n\u2022 \u0688\u067e\u0644\u06cc\u06a9\u06cc\u0679 \u062e\u0631\u06cc\u062f\u0627\u0631\u06cc\n\u2022 \u062a\u06a9\u0646\u06cc\u06a9\u06cc \u062e\u0631\u0627\u0628\u06cc (\u062e\u0631\u06cc\u062f\u0627\u0631\u06cc \u0641\u0631\u0627\u06c1\u0645 \u0646\u06c1\u06cc\u06ba \u06a9\u06cc \u06af\u0626\u06cc)\n\u2022 \u063a\u06cc\u0631 \u0645\u062c\u0627\u0632 \u0644\u06cc\u0646 \u062f\u06cc\u0646 (\u062f\u0631\u0633\u062a \u062b\u0628\u0648\u062a \u06a9\u06d2 \u0633\u0627\u062a\u06be)\n\n\u0631\u06cc\u0641\u0646\u0688 \u06a9\u0627 \u0627\u06c1\u0644 \u06c1\u0648\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0636\u0631\u0648\u0631\u06cc \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e:\n\n\u2022 \u0644\u06cc\u0646 \u062f\u06cc\u0646 \u06a9\u06d2 48 \u06af\u06be\u0646\u0679\u0648\u06ba \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u06c1\u0645 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba\n\u2022 \u0622\u0631\u0688\u0631 \u0622\u0626\u06cc \u0688\u06cc \u0627\u0648\u0631 \u0645\u062a\u0639\u0644\u0642\u06c1 \u062b\u0628\u0648\u062a (\u062c\u06cc\u0633\u06d2 \u0627\u0633\u06a9\u0631\u06cc\u0646 \u0634\u0627\u0679\u0633\u060c \u063a\u0644\u0637\u06cc \u06a9\u06d2 \u067e\u06cc\u063a\u0627\u0645\u0627\u062a) \u0641\u0631\u0627\u06c1\u0645 \u06a9\u0631\u06cc\u06ba\n\n4. \u0631\u06cc\u0641\u0646\u0688 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u06cc\u0633\u06d2 \u06a9\u0631\u06cc\u06ba\n\n\u0627\u06af\u0631 \u0622\u067e \u06a9\u0648 \u0644\u06af\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u0631\u06cc\u0641\u0646\u0688 \u06a9\u06d2 \u0627\u06c1\u0644 \u06c1\u06cc\u06ba\u060c \u062a\u0648 \u0627\u0646 \u0645\u06cc\u06ba \u0633\u06d2 \u06a9\u0633\u06cc \u0627\u06cc\u06a9 \u0627\u062e\u062a\u06cc\u0627\u0631 \u067e\u0631 \u0639\u0645\u0644 \u06a9\u0631\u06cc\u06ba:\n\n\u06af\u0648\u06af\u0644 \u067e\u0644\u06d2 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2:\n\n1. \u0627\u067e\u0646\u0627 \u06af\u0648\u06af\u0644 \u067e\u0644\u06d2 \u0627\u06a9\u0627\u0624\u0646\u0679 \u06a9\u06be\u0648\u0644\u06cc\u06ba\u06d4\n2. \"\u0622\u0631\u0688\u0631 \u06a9\u06cc \u062a\u0627\u0631\u06cc\u062e\" \u067e\u0631 \u062c\u0627\u0626\u06cc\u06ba\u06d4\n3. \u0644\u06cc\u0646 \u062f\u06cc\u0646 \u062a\u0644\u0627\u0634 \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \"\u0645\u0633\u0626\u0644\u06c1 \u06a9\u06cc \u0627\u0637\u0644\u0627\u0639 \u062f\u06cc\u06ba\" \u067e\u0631 \u0679\u06cc\u067e \u06a9\u0631\u06cc\u06ba\u06d4\n4. \u0645\u0646\u0627\u0633\u0628 \u0648\u062c\u06c1 \u0645\u0646\u062a\u062e\u0628 \u06a9\u0631\u06cc\u06ba \u0627\u0648\u0631 \u0641\u0627\u0631\u0645 \u062c\u0645\u0639 \u06a9\u0631\u06cc\u06ba\u06d4\n\n\u06cc\u0627 \u0628\u0631\u0627\u06c1 \u0631\u0627\u0633\u062a \u06c1\u0645 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba:\n\n\u0627\u06cc \u0645\u06cc\u0644: support@yaroapp.in\n\u0634\u0627\u0645\u0644 \u06a9\u0631\u06cc\u06ba:\n\n\u2022 \u0622\u067e \u06a9\u0627 \u0646\u0627\u0645\n\u2022 \u06af\u0648\u06af\u0644 \u0622\u0631\u0688\u0631 \u0622\u0626\u06cc \u0688\u06cc (GPA \u0633\u06d2 \u0634\u0631\u0648\u0639 \u06c1\u0648\u062a\u0627 \u06c1\u06d2\u06d4)\n\u2022 \u0631\u06cc\u0641\u0646\u0688 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a \u06a9\u06cc \u0648\u062c\u06c1\n\u2022 \u0627\u0633\u06a9\u0631\u06cc\u0646 \u0634\u0627\u0679 (\u0627\u06af\u0631 \u0642\u0627\u0628\u0644 \u0627\u0637\u0644\u0627\u0642 \u06c1\u0648)\n\n5. \u0631\u06cc\u0641\u0646\u0688 \u06a9\u0627 \u0648\u0642\u062a\n\n\u0627\u06af\u0631 \u0645\u0646\u0638\u0648\u0631 \u06c1\u0648 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u060c \u062a\u0648 \u0622\u067e \u06a9\u06d2 \u0628\u06cc\u0646\u06a9 \u06cc\u0627 \u06af\u0648\u06af\u0644 \u067e\u0644\u06d2 \u06a9\u06cc \u067e\u0627\u0644\u06cc\u0633\u06cc \u06a9\u06d2 \u0644\u062d\u0627\u0638 \u0633\u06d2\u060c 5\u201310 \u06a9\u0627\u0631\u0648\u0628\u0627\u0631\u06cc \u062f\u0646\u0648\u06ba \u06a9\u06d2 \u0627\u0646\u062f\u0631 \u0627\u0635\u0644 \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc \u06a9\u06d2 \u0637\u0631\u06cc\u0642\u06d2 \u06a9\u0648 \u0641\u0646\u0688\u0632 \u0648\u0627\u067e\u0633 \u06a9\u0631 \u062f\u06cc\u06d2 \u062c\u0627\u0626\u06cc\u06ba \u06af\u06d2\u06d4\n\n6. \u0627\u0646 \u06a9\u06d2 \u0644\u06cc\u06d2 \u06a9\u0648\u0626\u06cc \u0631\u06cc\u0641\u0646\u0688 \u0646\u06c1\u06cc\u06ba:\n\n\u2022 \u0630\u06c1\u0646 \u06a9\u06cc \u062a\u0628\u062f\u06cc\u0644\u06cc\n\u2022 \u062c\u0632\u0648\u06cc \u0637\u0648\u0631 \u067e\u0631 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06c1\u0648\u0646\u06d2 \u0648\u0627\u0644\u06cc \u062e\u062f\u0645\u0627\u062a (\u062c\u06cc\u0633\u06d2\u060c \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u0634\u062f\u06c1 \u0633\u06a9\u06d2 \u06cc\u0627 \u0645\u06a9\u0645\u0644 \u0686\u06cc\u0679\u0633)\n\u2022 \u0634\u0631\u0627\u0626\u0637 \u06a9\u0627 \u063a\u0644\u0637 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06cc\u0627 \u062e\u0644\u0627\u0641 \u0648\u0631\u0632\u06cc\n\u2022 \u062e\u0631\u06cc\u062f\u0627\u0631\u06cc \u06a9\u06d2 48 \u06af\u06be\u0646\u0679\u06d2 \u0628\u0639\u062f \u062f\u0631\u062e\u0648\u0627\u0633\u062a\u06cc\u06ba\n\n7. \u06c1\u0645 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba\n\n\u0633\u067e\u0648\u0631\u0679 \u06cc\u0627 \u0631\u06cc\u0641\u0646\u0688 \u06a9\u06cc \u062f\u0631\u062e\u0648\u0627\u0633\u062a\u0648\u06ba \u06a9\u06d2 \u0644\u06cc\u06d2\u060c \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u06c1\u0645 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba:\n\n\u0633\u067e\u0648\u0631\u0679 \u0627\u06cc \u0645\u06cc\u0644: support@yaroapp.in\n\u0627\u0646-\u0627\u06cc\u067e \u0633\u067e\u0648\u0631\u0679 \u0633\u06cc\u06a9\u0634\u0646: \u0627\u06cc\u067e \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u0645\u06cc\u06ba \u062f\u0633\u062a\u06cc\u0627\u0628 \u06c1\u06d2\n\n\u0627\u06cc\u067e \u0645\u06cc\u06ba \u062e\u0631\u06cc\u062f\u0627\u0631\u06cc \u06a9\u0631\u06a9\u06d2\u060c \u0622\u067e \u0627\u0633 \u0631\u06cc\u0641\u0646\u0688 \u067e\u0627\u0644\u06cc\u0633\u06cc \u0633\u06d2 \u0627\u062a\u0641\u0627\u0642 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4"},terms_of_use:{title:"\u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06cc \u0634\u0631\u0627\u0626\u0637 \u2013 Yaro",content:"1. \u062a\u0639\u0627\u0631\u0641:\nYaro\u060c \u0627\u06cc\u06a9 \u0633\u0645\u0627\u062c\u06cc \u0635\u0648\u062a\u06cc \u0686\u06cc\u0679 \u0627\u0648\u0631 \u0648\u0627\u0626\u0633 \u06a9\u0627\u0644\u0646\u06af \u0627\u06cc\u067e\u0644\u06cc \u06a9\u06cc\u0634\u0646 \u0645\u06cc\u06ba \u062e\u0648\u0634 \u0622\u0645\u062f\u06cc\u062f\u06d4 \u0627\u0633 \u0627\u06cc\u067e \u06a9\u0648 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06a9\u06d2\u060c \u0622\u067e \u062f\u0631\u062c \u0630\u06cc\u0644 \u0634\u0631\u0627\u0626\u0637 \u0648 \u0636\u0648\u0627\u0628\u0637 \u06a9\u06cc \u067e\u0627\u0628\u0646\u062f\u06cc \u06a9\u0631\u0646\u06d2 \u0633\u06d2 \u0627\u062a\u0641\u0627\u0642 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\n2. \u0635\u0627\u0631\u0641 \u06a9\u06cc \u0627\u06c1\u0644\u06cc\u062a:\n\u0627\u0633 \u0627\u06cc\u067e \u06a9\u0648 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0622\u067e \u06a9\u06cc \u0639\u0645\u0631 \u06a9\u0645 \u0627\u0632 \u06a9\u0645 18 \u0633\u0627\u0644 \u06c1\u0648\u0646\u06cc \u0686\u0627\u06c1\u06cc\u06d2\u06d4 \u0627\u0633 \u0627\u06cc\u067e \u06a9\u0648 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u06a9\u06d2\u060c \u0622\u067e \u0627\u0633 \u0628\u0627\u062a \u06a9\u06cc \u062a\u0635\u062f\u06cc\u0642 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u06a9\u06c1 \u0622\u067e \u0627\u06c1\u0644\u06cc\u062a \u06a9\u06d2 \u0645\u0639\u06cc\u0627\u0631 \u067e\u0631 \u067e\u0648\u0631\u0627 \u0627\u062a\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\n3. \u0627\u06cc\u067e \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644:\n- \u06cc\u06c1 \u0627\u06cc\u067e \u0622\u067e \u06a9\u0648 \u0639\u0648\u0627\u0645\u06cc \u0627\u0648\u0631 \u0646\u062c\u06cc \u0648\u0627\u0626\u0633 \u0686\u06cc\u0679 \u0631\u0648\u0645\u0632 \u0645\u06cc\u06ba \u0634\u0627\u0645\u0644 \u06c1\u0648\u0646\u06d2 \u0627\u0648\u0631 \u062f\u0648\u0633\u0631\u06d2 \u0635\u0627\u0631\u0641\u06cc\u0646 \u06a9\u0648 \u0648\u0627\u0626\u0633 \u06a9\u0627\u0644 \u06a9\u0631\u0646\u06d2 \u06a9\u06cc \u0627\u062c\u0627\u0632\u062a \u062f\u06cc\u062a\u06cc \u06c1\u06d2\u06d4\n- \u0622\u067e \u0627\u06cc\u067e \u06a9\u0648 \u0635\u0631\u0641 \u0642\u0627\u0646\u0648\u0646\u06cc \u0627\u0648\u0631 \u0628\u0627\u0639\u0632\u062a \u0645\u0648\u0627\u0635\u0644\u062a \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u0646\u06d2 \u0633\u06d2 \u0627\u062a\u0641\u0627\u0642 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n- \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0642\u0633\u0645 \u06a9\u06cc \u0628\u062f\u0633\u0644\u0648\u06a9\u06cc\u060c \u06c1\u0631\u0627\u0633\u0627\u06ba \u06a9\u0631\u0646\u0627\u060c \u06cc\u0627 \u0642\u0627\u0628\u0644 \u0627\u0639\u062a\u0631\u0627\u0636 \u0645\u0648\u0627\u062f \u0633\u062e\u062a\u06cc \u0633\u06d2 \u0645\u0646\u0639 \u06c1\u06d2\u06d4\n\n4. \u0627\u06a9\u0627\u0624\u0646\u0679 \u06a9\u06cc \u0630\u0645\u06c1 \u062f\u0627\u0631\u06cc:\n- \u0622\u067e \u0627\u067e\u0646\u06d2 \u0627\u06a9\u0627\u0624\u0646\u0679 \u06a9\u06cc \u0631\u0627\u0632\u062f\u0627\u0631\u06cc \u0628\u0631\u0642\u0631\u0627\u0631 \u0631\u06a9\u06be\u0646\u06d2 \u06a9\u06d2 \u0630\u0645\u06c1 \u062f\u0627\u0631 \u06c1\u06cc\u06ba\u06d4\n- \u0622\u067e \u06a9\u0648 \u0627\u067e\u0646\u06cc \u0644\u0627\u06af \u0627\u0646 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u06a9\u0633\u06cc \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0634\u06cc\u0626\u0631 \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u0646\u06cc \u0686\u0627\u06c1\u0626\u06cc\u06ba\u06d4\n- \u0627\u06af\u0631 \u0622\u067e \u06a9\u0648 \u06a9\u0633\u06cc \u063a\u06cc\u0631 \u0645\u062c\u0627\u0632 \u0631\u0633\u0627\u0626\u06cc \u06a9\u0627 \u0634\u0628\u06c1 \u06c1\u06d2\u060c \u062a\u0648 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u06cc\u067e \u0633\u067e\u0648\u0631\u0679 \u0633\u06cc\u06a9\u0634\u0646 \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u0627\u0633 \u06a9\u06cc \u0627\u0637\u0644\u0627\u0639 \u062f\u06cc\u06ba\u06d4\n\n5. \u0631\u0627\u0632\u062f\u0627\u0631\u06cc \u0627\u0648\u0631 \u0688\u06cc\u0679\u0627:\n- \u06c1\u0645 \u0622\u067e \u06a9\u06cc \u0631\u0627\u0632\u062f\u0627\u0631\u06cc \u06a9\u06cc \u0642\u062f\u0631 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0622\u067e \u06a9\u0627 \u0630\u0627\u062a\u06cc \u0688\u06cc\u0679\u0627 \u0645\u062d\u0641\u0648\u0638 \u0637\u0631\u06cc\u0642\u06d2 \u0633\u06d2 \u0633\u0646\u0628\u06be\u0627\u0644\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627 \u0627\u0648\u0631 \u0635\u0631\u0641 \u0627\u06cc\u067e \u06a9\u06d2 \u062a\u062c\u0631\u0628\u06d2 \u06a9\u0648 \u0628\u06c1\u062a\u0631 \u0628\u0646\u0627\u0646\u06d2 \u06a9\u06d2 \u0644\u06cc\u06d2 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06cc\u0627 \u062c\u0627\u0626\u06d2 \u06af\u0627\u06d4\n- \u0635\u0648\u062a\u06cc \u0688\u06cc\u0679\u0627 \u0627\u0648\u0631 \u0686\u06cc\u0679 \u06a9\u06cc \u0628\u0627\u062a \u0686\u06cc\u062a \u06a9\u0648 \u0639\u0648\u0627\u0645\u06cc \u0637\u0648\u0631 \u067e\u0631 \u06cc\u0627 \u062a\u06cc\u0633\u0631\u06d2 \u0641\u0631\u06cc\u0642 \u06a9\u06d2 \u0633\u0627\u062a\u06be \u0634\u06cc\u0626\u0631 \u0646\u06c1\u06cc\u06ba \u06a9\u06cc\u0627 \u062c\u0627\u062a\u0627 \u06c1\u06d2\u060c \u062c\u0628 \u062a\u06a9 \u06a9\u06c1 \u0642\u0627\u0646\u0648\u0646 \u06a9\u06cc \u0636\u0631\u0648\u0631\u062a \u0646\u06c1 \u06c1\u0648\u06d4\n\n6. \u0627\u062f\u0627\u0626\u06cc\u06af\u06cc\u0627\u06ba \u0627\u0648\u0631 \u0633\u06a9\u06d2:\n- \u0627\u06cc\u067e \u0627\u06cc\u067e \u0645\u06cc\u06ba \u062e\u0631\u06cc\u062f\u0627\u0631\u06cc\u0648\u06ba \u062c\u06cc\u0633\u06d2 \u0633\u06a9\u06d2 \u06cc\u0627 \u067e\u0631\u06cc\u0645\u06cc\u0645 \u062e\u0635\u0648\u0635\u06cc\u0627\u062a \u06a9\u06cc \u067e\u06cc\u0634\u06a9\u0634 \u06a9\u0631 \u0633\u06a9\u062a\u06cc \u06c1\u06d2\u06d4\n- \u062a\u0645\u0627\u0645 \u062e\u0631\u06cc\u062f\u0627\u0631\u06cc\u0627\u06ba \u062d\u062a\u0645\u06cc \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0627\u0646 \u06a9\u06cc \u0648\u0627\u067e\u0633\u06cc \u0646\u06c1\u06cc\u06ba \u06c1\u0648 \u0633\u06a9\u062a\u06cc \u062c\u0628 \u062a\u06a9 \u06a9\u06c1 \u0627\u06cc\u067e \u0627\u0633\u0679\u0648\u0631 \u06a9\u06cc \u067e\u0627\u0644\u06cc\u0633\u06cc\u0648\u06ba \u06a9\u06d2 \u0630\u0631\u06cc\u0639\u06d2 \u062f\u0648\u0633\u0631\u06cc \u0635\u0648\u0631\u062a \u0645\u06cc\u06ba \u0628\u06cc\u0627\u0646 \u0646\u06c1 \u06a9\u06cc\u0627 \u06c1\u0648\u06d4\n\n7. \u0627\u06a9\u0627\u0624\u0646\u0679 \u06a9\u0627 \u062e\u0627\u062a\u0645\u06c1:\n- Yaro \u0627\u06af\u0631 \u0622\u067e \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0634\u0631\u0627\u0626\u0637 \u06a9\u06cc \u062e\u0644\u0627\u0641 \u0648\u0631\u0632\u06cc \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba \u062a\u0648 \u0622\u067e \u06a9\u06d2 \u0627\u06a9\u0627\u0624\u0646\u0679 \u06a9\u0648 \u0645\u0639\u0637\u0644 \u06cc\u0627 \u062e\u062a\u0645 \u06a9\u0631\u0646\u06d2 \u06a9\u0627 \u062d\u0642 \u0645\u062d\u0641\u0648\u0638 \u0631\u06a9\u06be\u062a\u0627 \u06c1\u06d2\u06d4\n- \u0622\u067e \u06a9\u0633\u06cc \u0628\u06be\u06cc \u0648\u0642\u062a \u0627\u06cc\u067e \u06a9\u06cc \u062a\u0631\u062a\u06cc\u0628\u0627\u062a \u0633\u06d2 \u0627\u067e\u0646\u0627 \u0627\u06a9\u0627\u0624\u0646\u0679 \u062d\u0630\u0641 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\n8. \u0627\u06cc\u067e \u06a9\u0627 \u0645\u0648\u0627\u062f:\n- \u06a9\u0686\u06be \u0628\u0635\u0631\u06cc\u060c \u0627\u0648\u062a\u0627\u0631\u060c \u06cc\u0627 \u0634\u0628\u06cc\u06c1\u06cc\u06ba \u0645\u0635\u0646\u0648\u0639\u06cc \u0630\u06c1\u0627\u0646\u062a (AI) \u06a9\u0627 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u0648\u0626\u06d2 \u062a\u06cc\u0627\u0631 \u06a9\u06cc \u062c\u0627 \u0633\u06a9\u062a\u06cc \u06c1\u06cc\u06ba\u06d4\n- \u06cc\u06c1 \u062d\u0642\u06cc\u0642\u06cc \u0627\u0641\u0631\u0627\u062f \u06a9\u06cc \u0646\u0645\u0627\u0626\u0646\u062f\u06af\u06cc \u0646\u06c1\u06cc\u06ba \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u06a9\u0648\u0626\u06cc \u0628\u06be\u06cc \u0645\u0645\u0627\u062b\u0644\u062a \u062e\u0627\u0644\u0635\u062a\u0627\u064b \u0627\u062a\u0641\u0627\u0642\u06cc\u06c1 \u06c1\u06d2\u06d4\n\n9. \u0634\u0631\u0627\u0626\u0637 \u0645\u06cc\u06ba \u062a\u0628\u062f\u06cc\u0644\u06cc\u0627\u06ba:\n\u06c1\u0645 \u0648\u0642\u062a\u0627\u064b \u0641\u0648\u0642\u062a\u0627\u064b \u0627\u0646 \u0634\u0631\u0627\u0626\u0637 \u06a9\u0648 \u0627\u067e \u0688\u06cc\u0679 \u06a9\u0631 \u0633\u06a9\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4 \u0627\u06cc\u067e \u06a9\u0627 \u0645\u0633\u0644\u0633\u0644 \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u0627\u0633 \u0628\u0627\u062a \u06a9\u06cc \u0646\u0634\u0627\u0646\u062f\u06c1\u06cc \u06a9\u0631\u062a\u0627 \u06c1\u06d2 \u06a9\u06c1 \u0622\u067e \u0627\u067e \u0688\u06cc\u0679 \u0634\u062f\u06c1 \u0634\u0631\u0627\u0626\u0637 \u06a9\u0648 \u0642\u0628\u0648\u0644 \u06a9\u0631\u062a\u06d2 \u06c1\u06cc\u06ba\u06d4\n\n10. \u0633\u067e\u0648\u0631\u0679:\n\u0627\u06af\u0631 \u0622\u067e \u06a9\u06d2 \u06a9\u0648\u0626\u06cc \u0633\u0648\u0627\u0644\u0627\u062a\u060c \u062e\u062f\u0634\u0627\u062a\u060c \u06cc\u0627 \u0634\u06a9\u0627\u06cc\u0627\u062a \u06c1\u06cc\u06ba\u060c \u062a\u0648 \u0628\u0631\u0627\u06c1 \u06a9\u0631\u0645 \u0627\u06cc\u067e \u0645\u06cc\u06ba \u0633\u067e\u0648\u0631\u0679 \u0633\u06cc\u06a9\u0634\u0646 \u0633\u06d2 \u06c1\u0645 \u0633\u06d2 \u0631\u0627\u0628\u0637\u06c1 \u06a9\u0631\u06cc\u06ba\u06d4\n\n\u0646\u0648\u0679: \u0627\u0633\u062a\u0639\u0645\u0627\u0644 \u06a9\u06cc \u06cc\u06c1 \u0634\u0631\u0627\u0626\u0637 \u0627\u06cc\u06a9 \u0639\u0627\u0645 \u0631\u06c1\u0646\u0645\u0627 \u062e\u0637\u0648\u0637 \u06c1\u06cc\u06ba \u0627\u0648\u0631 \u0642\u0627\u0628\