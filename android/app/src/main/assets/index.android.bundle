u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645",update_success:"\u062a\u0645 \u062a\u062d\u062f\u064a\u062b \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a!",update_fail:"\u0641\u0634\u0644 \u0627\u0644\u062a\u062d\u062f\u064a\u062b",error:"\u062e\u0637\u0623",success:"\u0646\u062c\u0627\u062d",something_wrong:"\u062d\u062f\u062b \u062e\u0637\u0623 \u0645\u0627"},account:{title:"\u0627\u0644\u062d\u0633\u0627\u0628",google_email:"\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0645\u0646 Google",phone_number:"\u0631\u0642\u0645 \u0627\u0644\u0647\u0627\u062a\u0641",verified:"\u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u0642",not_verified:"\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u062a\u062d\u0642\u0642",verify:"\u062a\u062d\u0642\u0642"},privacy_policy:{title:"\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u2014 \u062a\u0637\u0628\u064a\u0642 \u064a\u0627\u0631\u0648 Yaro",content:"\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0633\u0631\u064a\u0627\u0646: 15/08/2025\n\n---\n\n1. \u0645\u0642\u062f\u0645\u0629\n\n\u062a\u062d\u062a\u0631\u0645 \u0645\u0646\u0635\u0629 \u064a\u0627\u0631\u0648 Yaro (\"\u0646\u062d\u0646\" \u0623\u0648 \"\u0646\u0627\" \u0623\u0648 \"\u0644\u0646\u0627\") \u062e\u0635\u0648\u0635\u064a\u062a\u0643 \u0648\u062a\u0644\u062a\u0632\u0645 \u0628\u062d\u0645\u0627\u064a\u0629 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0627\u0644\u0634\u062e\u0635\u064a\u0629. \u062a\u0634\u0631\u062d \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0647\u0630\u0647 \u0643\u064a\u0641 \u0646\u0642\u0648\u0645 \u0628\u062c\u0645\u0639 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0648\u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0647\u0627 \u0648\u0627\u0644\u0643\u0634\u0641 \u0639\u0646\u0647\u0627 \u0639\u0646\u062f \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0643 \u0644\u062a\u0637\u0628\u064a\u0642\u0646\u0627 \u0627\u0644\u0645\u062d\u0645\u0648\u0644 (\"\u0627\u0644\u062a\u0637\u0628\u064a\u0642\").\n\n\u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0641\u0625\u0646\u0643 \u062a\u0648\u0627\u0641\u0642 \u0639\u0644\u0649 \u062c\u0645\u0639 \u0648\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0643\u0645\u0627 \u0647\u0648 \u0645\u0648\u0636\u062d \u0647\u0646\u0627.\n\n2. \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062a\u064a \u0646\u062c\u0645\u0639\u0647\u0627\n\n2.1 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u0634\u062e\u0635\u064a\u0629:\n\u0639\u0646\u062f \u0627\u0644\u062a\u0633\u062c\u064a\u0644 \u0623\u0648 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0642\u062f \u0646\u062c\u0645\u0639 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062a\u0642\u062f\u0645\u0647\u0627 \u0645\u062b\u0644 \u0627\u0633\u0645\u0643 \u0648\u0627\u0633\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0648\u0635\u0648\u0631\u0629 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \u0648\u0639\u0646\u0648\u0627\u0646 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0648\u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u062f\u0641\u0639.\n\n2.2 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645:\n\u0646\u0642\u0648\u0645 \u0628\u062c\u0645\u0639 \u0628\u064a\u0627\u0646\u0627\u062a \u062d\u0648\u0644 \u0643\u064a\u0641\u064a\u0629 \u0627\u0633\u062a\u062e\u062f\u0627\u0645\u0643 \u0644\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u062a\u0641\u0627\u0639\u0644\u0627\u062a \u0645\u0639 \u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0622\u062e\u0631\u064a\u0646\u060c \u0648\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0627\u0644\u0635\u0648\u062a\u064a\u0629 \u0627\u0644\u0648\u0635\u0641\u064a\u0629 (\u0648\u0644\u064a\u0633 \u0627\u0644\u0645\u062d\u062a\u0648\u0649)\u060c \u0648\u0625\u062d\u0635\u0627\u0626\u064a\u0627\u062a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642.\n\n2.3 \u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0627\u0644\u062c\u0647\u0627\u0632:\n\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u062d\u0648\u0644 \u062c\u0647\u0627\u0632\u0643\u060c \u0645\u062b\u0644 \u0646\u0648\u0639 \u0627\u0644\u062c\u0647\u0627\u0632 \u0648\u0625\u0635\u062f\u0627\u0631 \u0646\u0638\u0627\u0645 \u0627\u0644\u062a\u0634\u063a\u064a\u0644 \u0648\u0645\u0639\u0631\u0641\u0627\u062a \u0627\u0644\u0623\u062c\u0647\u0632\u0629 \u0627\u0644\u0641\u0631\u064a\u062f\u0629 \u0648\u0639\u0646\u0648\u0627\u0646 IP \u0648\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0634\u0628\u0643\u0629 \u0627\u0644\u0647\u0627\u062a\u0641 \u0627\u0644\u0645\u062d\u0645\u0648\u0644.\n\n3. \u0643\u064a\u0641 \u0646\u0633\u062a\u062e\u062f\u0645 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u0643\n\n\u2022 \u0644\u062a\u0648\u0641\u064a\u0631 \u0648\u0635\u064a\u0627\u0646\u0629 \u0645\u064a\u0632\u0627\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0627\u062a \u0627\u0644\u0635\u0648\u062a\u064a\u0629 \u0648\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u062f\u0631\u062f\u0634\u0629.\n\u2022 \u0644\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a \u0648\u0625\u062f\u0627\u0631\u0629 \u062d\u0633\u0627\u0628\u0643.\n\u2022 \u0644\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0643 \u0628\u0634\u0623\u0646 \u0627\u0644\u062a\u062d\u062f\u064a\u062b\u0627\u062a \u0648\u0627\u0644\u0639\u0631\u0648\u0636 \u0627\u0644\u062a\u0631\u0648\u064a\u062c\u064a\u0629 \u0648\u0627\u0644\u062f\u0639\u0645.\n\u2022 \u0644\u062a\u062d\u0633\u064a\u0646 \u062a\u0637\u0628\u064a\u0642\u0646\u0627 \u0648\u062a\u0637\u0648\u064a\u0631 \u0645\u064a\u0632\u0627\u062a \u062c\u062f\u064a\u062f\u0629.\n\u2022 \u0644\u0627\u0643\u062a\u0634\u0627\u0641 \u0648\u0645\u0646\u0639 \u0627\u0644\u0623\u0646\u0634\u0637\u0629 \u0627\u0644\u0627\u062d\u062a\u064a\u0627\u0644\u064a\u0629 \u0623\u0648 \u063a\u064a\u0631 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629.\n\n5. \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0630\u064a \u064a\u0646\u0634\u0626\u0647 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 (UGC)\n\n\u2022 **\u0639\u062f\u0645 \u0627\u0644\u062a\u0633\u0627\u0645\u062d**: \u0644\u062f\u064a\u0646\u0627 \u0633\u064a\u0627\u0633\u0629 \u0639\u062f\u0645 \u062a\u0633\u0627\u0645\u062d \u0645\u0637\u0644\u0642 \u0645\u0639 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0645\u0631\u0641\u0648\u0636 \u0623\u0648 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0645\u0633\u064a\u0626\u064a\u0646.\n\u2022 **\u0627\u0644\u0625\u0628\u0644\u0627\u063a**: \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0625\u0628\u0644\u0627\u063a \u0639\u0646 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0623\u0648 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u063a\u064a\u0631 \u0627\u0644\u0644\u0627\u0626\u0642\u064a\u0646 \u0645\u0628\u0627\u0634\u0631\u0629 \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0639\u0628\u0631 \u0632\u0631 \"\u0625\u0628\u0644\u0627\u063a\" \u0641\u064a \u0645\u0644\u0641\u0627\u062a \u062a\u0639\u0631\u064a\u0641 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0623\u0648 \u0634\u0627\u0634\u0627\u062a \u0627\u0644\u062f\u0631\u062f\u0634\u0629.\n\u2022 **\u0627\u0644\u062d\u0638\u0631**: \u064a\u0645\u0643\u0646\u0643 \u062d\u0638\u0631 \u0623\u064a \u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u0645\u0646\u0639\u0647 \u0645\u0646 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0643.\n\u2022 **\u0627\u0644\u0625\u062c\u0631\u0627\u0621**: \u0646\u0642\u0648\u0645 \u0628\u0645\u0631\u0627\u062c\u0639\u0629 \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0641\u064a \u063a\u0636\u0648\u0646 24 \u0633\u0627\u0639\u0629 \u0648\u0633\u0648\u0641 \u0646\u0632\u064a\u0644 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0645\u062e\u0627\u0644\u0641 \u0648\u0646\u0639\u0644\u0642 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0627\u0644\u0630\u064a\u0646 \u064a\u0646\u062a\u0647\u0643\u0648\u0646 \u0634\u0631\u0648\u0637\u0646\u0627.\n\u2022 **\u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0645\u062d\u0638\u0648\u0631**: \u064a\u064f\u062d\u0638\u0631 \u062a\u0645\u0627\u0645\u064b\u0627 \u062e\u0637\u0627\u0628 \u0627\u0644\u0643\u0631\u0627\u0647\u064a\u0629 \u0648\u0627\u0644\u0639\u0631\u064a \u0648\u0627\u0644\u0639\u0646\u0641 \u0648\u0627\u0644\u062a\u0646\u0645\u0631 \u0648\u0627\u0644\u0645\u0636\u0627\u064a\u0642\u0629.\n\n6. \u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0648\u0627\u0644\u0625\u0641\u0635\u0627\u062d \u0639\u0646\u0647\u0627\n\n\u2022 \u0646\u062d\u0646 \u0644\u0627 \u0646\u0628\u064a\u0639 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u0643 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0644\u0623\u0637\u0631\u0627\u0641 \u062b\u0627\u0644\u062b\u0629.\n\u2022 \u064a\u062c\u0648\u0632 \u0644\u0646\u0627 \u0645\u0634\u0627\u0631\u0643\u0629 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u0643 \u0645\u0639 \u0645\u0632\u0648\u062f\u064a \u0627\u0644\u062e\u062f\u0645\u0629 \u0627\u0644\u0645\u0648\u062b\u0648\u0642 \u0628\u0647\u0645 \u0627\u0644\u0630\u064a\u0646 \u064a\u0633\u0627\u0639\u062f\u0648\u0646 \u0641\u064a \u062a\u0634\u063a\u064a\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0648\u0641\u0642\u064b\u0627 \u0644\u0627\u062a\u0641\u0627\u0642\u064a\u0627\u062a \u0627\u0644\u0633\u0631\u064a\u0629.\n\u2022 \u064a\u062c\u0648\u0632 \u0644\u0646\u0627 \u0627\u0644\u0643\u0634\u0641 \u0639\u0646 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0625\u0630\u0627 \u0644\u0632\u0645 \u0627\u0644\u0623\u0645\u0631 \u0628\u0645\u0648\u062c\u0628 \u0627\u0644\u0642\u0627\u0646\u0648\u0646 \u0623\u0648 \u0644\u062d\u0645\u0627\u064a\u0629 \u062d\u0642\u0648\u0642\u0646\u0627.\n\n5. \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0648\u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\n\n\u062a\u062a\u0645 \u0645\u0639\u0627\u0644\u062c\u0629 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0628\u0623\u0645\u0627\u0646 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0646\u0638\u0627\u0645 \u0627\u0644\u062f\u0641\u0639 \u0641\u064a \u0645\u062a\u062c\u0631 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a. \u0646\u062d\u0646 \u0644\u0627 \u0646\u062e\u0632\u0646 \u062a\u0641\u0627\u0635\u064a\u0644 \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643 \u0645\u0628\u0627\u0634\u0631\u0629.\n\n6. \u062d\u0642\u0648\u0642\u0643 \u0648\u062e\u064a\u0627\u0631\u0627\u062a\u0643\n\n\u2022 \u064a\u0645\u0643\u0646\u0643 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u0643 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0623\u0648 \u062a\u062d\u062f\u064a\u062b\u0647\u0627 \u0623\u0648 \u062d\u0630\u0641\u0647\u0627 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0623\u0648 \u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0627\u0644\u062f\u0639\u0645.\n\u2022 \u064a\u062c\u0648\u0632 \u0644\u0643 \u0625\u0644\u063a\u0627\u0621 \u0627\u0644\u0627\u0634\u062a\u0631\u0627\u0643 \u0641\u064a \u062a\u0644\u0642\u064a \u0627\u0644\u0627\u062a\u0635\u0627\u0644\u0627\u062a \u0627\u0644\u062a\u0631\u0648\u064a\u062c\u064a\u0629 \u0641\u064a \u0623\u064a \u0648\u0642\u062a.\n\u2022 \u064a\u0645\u0643\u0646\u0643 \u062d\u0630\u0641 \u062d\u0633\u0627\u0628\u0643 \u0641\u064a \u0623\u064a \u0648\u0642\u062a \u0639\u0628\u0631 \u0627\u0644\u062a\u0637\u0628\u064a\u0642.\n\n7. \u0623\u0645\u0646 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a\n\n\u0646\u0646\u062d \u0646\u0646\u0641\u0630 \u0627\u0644\u0625\u062c\u0631\u0627\u0621\u0627\u062a \u0627\u0644\u0641\u0646\u064a\u0629 \u0648\u0627\u0644\u062a\u0646\u0638\u064a\u0645\u064a\u0629 \u0627\u0644\u0645\u062a\u0648\u0627\u0641\u0642\u0629 \u0645\u0639 \u0645\u0639\u0627\u064a\u064a\u0631 \u0627\u0644\u0635\u0646\u0627\u0639\u0629 \u0644\u062d\u0645\u0627\u064a\u0629 \u0645\u0639\u0644\u0648\u0645\u0627\u062a\u0643 \u0645\u0646 \u0627\u0644\u0648\u0635\u0648\u0644 \u063a\u064a\u0631 \u0627\u0644\u0645\u0635\u0631\u062d \u0628\u0647 \u0623\u0648 \u0627\u0644\u062a\u063a\u064a\u064a\u0631 \u0623\u0648 \u0627\u0644\u0643\u0634\u0641 \u0623\u0648 \u0627\u0644\u0625\u062a\u0644\u0627\u0641.\n\n8. \u062e\u0635\u0648\u0635\u064a\u0629 \u0627\u0644\u0623\u0637\u0641\u0627\u0644\n\n\u062a\u0637\u0628\u064a\u0642\u0646\u0627 \u063a\u064a\u0631 \u0645\u062e\u0635\u0635 \u0644\u0644\u0623\u0637\u0641\u0627\u0644 \u062f\u0648\u0646 \u0633\u0646 18 \u0639\u0627\u0645\u064b\u0627. \u0646\u062d\u0646 \u0644\u0627 \u0646\u062c\u0645\u0639 \u0628\u064a\u0627\u0646\u0627\u062a \u0639\u0646 \u0642\u0635\u062f \u0645\u0646 \u0623\u064a \u0634\u062e\u0635 \u062f\u0648\u0646 18 \u0639\u0627\u0645\u064b\u0627.\n\n9. \u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0639\u0644\u0649 \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0647\u0630\u0647\n\n\u0642\u062f \u0646\u0642\u0648\u0645 \u0628\u062a\u062d\u062f\u064a\u062b \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0647\u0630\u0647 \u0641\u064a \u0628\u0639\u0636 \u0627\u0644\u0623\u062d\u064a\u0627\u0646. \u0633\u0646\u062e\u0637\u0631\u0643 \u0628\u0623\u064a \u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0639\u0646 \u0637\u0631\u064a\u0642 \u0646\u0634\u0631 \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0627\u0644\u062c\u062f\u064a\u062f\u0629 \u0639\u0644\u0649 \u0647\u0630\u0647 \u0627\u0644\u0635\u0641\u062d\u0629. \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0628\u0639\u062f \u0627\u0644\u062a\u063a\u064a\u064a\u0631\u0627\u062a \u064a\u0639\u0646\u064a \u0642\u0628\u0648\u0644\u0643 \u0644\u0644\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u0645\u062d\u062f\u062b\u0629.\n\n10. \u0627\u062a\u0635\u0644 \u0628\u0646\u0627\n\n\u0644\u0623\u064a \u0623\u0633\u0626\u0644\u0629 \u062d\u0648\u0644 \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0647\u0630\u0647 \u0623\u0648 \u0628\u064a\u0627\u0646\u0627\u062a\u0643\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0646\u0627 \u0639\u0628\u0631 \u0642\u0633\u0645 \u0627\u0644\u062f\u0639\u0645 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642.\n\n\u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u062a\u0637\u0628\u064a\u0642 \u064a\u0627\u0631\u0648 Yaro\u060c \u0641\u0625\u0646\u0643 \u062a\u0642\u0631 \u0628\u0623\u0646\u0643 \u0642\u0631\u0623\u062a \u0648\u0648\u0627\u0641\u0642\u062a \u0639\u0644\u0649 \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0647\u0630\u0647."},about_us:{title:"\u0645\u0639\u0644\u0648\u0645\u0627\u062a \u0639\u0646\u0627 \u2013 \u062a\u0637\u0628\u064a\u0642 \u064a\u0627\u0631\u0648 Yaro",content:"\u0645\u0631\u062d\u0628\u064b\u0627 \u0628\u0643 \u0641\u064a \u064a\u0627\u0631\u0648 Yaro - \u062a\u0637\u0628\u064a\u0642 \u0645\u0643\u0627\u0644\u0645\u0627\u062a \u0635\u0648\u062a\u064a\u0629 \u0648\u0635\u062f\u0627\u0642\u0629 \u062e\u0627\u0635 1-\u0639\u0644\u0649-1!\n\n\u0645\u0646\u0635\u0629 \u064a\u0627\u0631\u0648 Yaro \u0647\u064a \u0645\u0646\u0635\u0629 \u0635\u0648\u062a\u064a\u0629 \u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629 \u062a\u0633\u0627\u0639\u062f \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0639\u0644\u0649 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0645\u0643\u0627\u0644\u0645\u0627\u062a \u0635\u0648\u062a\u064a\u0629 1-\u0639\u0644\u0649-1 \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0641\u0639\u0644\u064a. \u0633\u0648\u0627\u0621 \u0643\u0646\u062a \u062a\u062a\u0637\u0644\u0639 \u0625\u0644\u0649 \u0627\u0644\u062a\u062d\u062f\u062b \u0623\u0648 \u062a\u0643\u0648\u064a\u0646 \u0635\u062f\u0627\u0642\u0627\u062a \u062c\u062f\u064a\u062f\u0629 \u0623\u0648 \u0642\u0636\u0627\u0621 \u0627\u0644\u0648\u0642\u062a \u0641\u0642\u0637\u060c \u062a\u0642\u062f\u0645 \u064a\u0627\u0631\u0648 Yaro \u0645\u0633\u0627\u062d\u0629 \u0622\u0645\u0646\u0629 \u0648\u062c\u0630\u0627\u0628\u0629 \u0644\u0644\u0645\u062d\u0627\u062f\u062b\u0627\u062a \u0627\u0644\u0635\u0648\u062a\u064a\u0629 \u0627\u0644\u0645\u0641\u064a\u062f\u0629.\n\n\ud83c\udfaf \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0631\u0626\u064a\u0633\u064a\u0629:\n\n\u2022 \u0645\u0643\u0627\u0644\u0645\u0627\u062a \u0635\u0648\u062a\u064a\u0629 \u0641\u064a \u0627\u0644\u0648\u0642\u062a \u0627\u0644\u0641\u0639\u0644\u064a 1-\u0639\u0644\u0649-1\n\u2022 \u0646\u0638\u0627\u0645 \u0627\u062a\u0635\u0627\u0644 \u0642\u0627\u0626\u0645 \u0639\u0644\u0649 \u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0627\u0644\u0645\u0639\u062f\u0646\u064a\u0629 (\u0645\u0639 \u0625\u0639\u0627\u062f\u0629 \u0627\u0644\u0634\u062d\u0646 \u0627\u0644\u0633\u0647\u0644)\n\u2022 \u062a\u062e\u0635\u064a\u0635 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a (\u0627\u0644\u0635\u0648\u0631 \u0627\u0644\u0631\u0645\u0632\u064a\u0629 \u060c \u0627\u0644\u0633\u064a\u0631)\n\u2022 \u0627\u0644\u062a\u0648\u0641\u064a\u0642 \u0627\u0644\u0630\u0643\u064a \u0644\u0644\u0642\u0627\u0621 \u0623\u0634\u062e\u0627\u0635 \u062c\u062f\u062f\n\u2022 \u0636\u0648\u0627\u0628\u0637 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0627\u0644\u0643\u0627\u0645\u0644\u0629 - \u062d\u0638\u0631 \u060c \u0625\u0628\u0644\u0627\u063a \u060c \u0625\u0644\u062e.\n\n\ud83d\udd12 \u0628\u064a\u0626\u0629 \u0622\u0645\u0646\u0629 \u0648\u0645\u062d\u062a\u0631\u0645\u0629\n\n\u0646\u062d\u0646 \u0646\u0639\u0637\u064a \u0627\u0644\u0623\u0648\u0644\u0648\u064a\u0629 \u0644\u0633\u0644\u0627\u0645\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645. \u062a\u062a\u0636\u0645\u0646 \u0645\u0646\u0635\u062a\u0646\u0627 \u0623\u062f\u0648\u0627\u062a \u0627\u0644\u0625\u0634\u0631\u0627\u0641 \u0627\u0644\u0635\u0627\u0631\u0645\u0629 \u0648\u0645\u064a\u0632\u0627\u062a \u0625\u0639\u062f\u0627\u062f \u0627\u0644\u062a\u0642\u0627\u0631\u064a\u0631 \u0648\u0639\u0646\u0627\u0635\u0631 \u062a\u062d\u0643\u0645 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0644\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u062a\u062c\u0631\u0628\u0629 \u0645\u062d\u062a\u0631\u0645\u0629 \u0648\u062e\u0627\u0644\u064a\u0629 \u0645\u0646 \u0627\u0644\u0625\u0633\u0627\u0621\u0629.\n\n\ud83c\udf0d \u0645\u0646 \u0646\u062d\u0646\n\n\u062a\u0645 \u062a\u0637\u0648\u064a\u0631 \u064a\u0627\u0631\u0648 Yaro \u0645\u0646 \u0642\u0628\u0644 \u0641\u0631\u064a\u0642 \u0634\u063a\u0648\u0641 \u0628\u0628\u0646\u0627\u0621 \u062a\u062c\u0627\u0631\u0628 \u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629 \u0622\u0645\u0646\u0629 \u0648\u062a\u0631\u0643\u0632 \u0639\u0644\u0649 \u0627\u0644\u0635\u0648\u062a.\n\n\ud83d\udcf1 \u062a\u0648\u0627\u0641\u0631 \u0627\u0644\u062a\u0637\u0628\u064a\u0642:\n\n\u0645\u062a\u0648\u0641\u0631 \u0639\u0644\u0649 \u0645\u062a\u062c\u0631 Google Play\n\n\ud83d\udcec \u0627\u062a\u0635\u0644 \u0628\u0646\u0627:\n\n\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a: support@yaroapp.in\n\u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642: \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \u0627\u0644\u0645\u0644\u0641 \u0627\u0644\u0634\u062e\u0635\u064a \u2192 \u0627\u0644\u0645\u0633\u0627\u0639\u062f\u0629 \u0648\u0627\u0644\u062f\u0639\u0645"},contact_us:{title:"\u0627\u062a\u0635\u0644 \u0628\u0646\u0627",part1:"\u0641\u064a \u062a\u0637\u0628\u064a\u0642 \u064a\u0627\u0631\u0648 Yaro\u060c \u0646\u062d\u0646 \u0645\u0644\u062a\u0632\u0645\u0648\u0646 \u0628\u062a\u0648\u0641\u064a\u0631 \u062a\u062c\u0631\u0628\u0629 \u0627\u062a\u0635\u0627\u0644 \u0635\u0648\u062a\u064a \u0633\u0644\u0633\u0629 \u0648\u0622\u0645\u0646\u0629 \u0644\u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646. \u0625\u0630\u0627 \u0643\u0627\u0646 \u0644\u062f\u064a\u0643 \u0623\u064a \u0623\u0633\u0626\u0644\u0629 \u0623\u0648 \u062a\u0639\u0644\u064a\u0642\u0627\u062a \u0623\u0648 \u0645\u062e\u0627\u0648\u0641 \u0628\u0634\u0623\u0646 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0623\u0648 \u062e\u062f\u0645\u0627\u062a\u0646\u0627 \u0623\u0648 \u062d\u0633\u0627\u0628\u0643\u060c \u0641\u0644\u0627 \u062a\u062a\u0631\u062f\u062f \u0641\u064a \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0646\u0627.\n\n\ud83d\udcec \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0644\u062f\u0639\u0645:\n",part2:"\n\u0646\u0631\u062f \u0639\u0627\u062f\u0629 \u0641\u064a \u063a\u0636\u0648\u0646 24-48 \u0633\u0627\u0639\u0629 \u0639\u0645\u0644.\n\n\ud83d\udee0 \u0627\u0644\u062f\u0639\u0645 \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642:\n\u064a\u0645\u0643\u0646\u0643 \u0623\u064a\u0636\u064b\u0627 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u064a\u0646\u0627 \u0645\u0646 \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642:\n\n1. \u0627\u0630\u0647\u0628 \u0625\u0644\u0649 \u0645\u0644\u0641\u0643 \u0627\u0644\u0634\u062e\u0635\u064a\n2. \u0627\u0636\u063a\u0637 \u0639\u0644\u0649 \u0645\u0633\u0627\u0639\u062f\u0629 \u0648\u062f\u0639\u0645\n3. \u0623\u0631\u0633\u0644 \u0645\u0634\u0643\u0644\u062a\u0643 \u0623\u0648 \u062a\u0639\u0644\u064a\u0642\u0627\u062a\u0643 \u0645\u0628\u0627\u0634\u0631\u0629\n\n\ud83e\uddd1\u200d\u2696 \u0627\u0633\u062a\u0641\u0633\u0627\u0631\u0627\u062a \u0642\u0627\u0646\u0648\u0646\u064a\u0629 \u0648\u0633\u064a\u0627\u0633\u064a\u0629:\n\u0628\u0627\u0644\u0646\u0633\u0628\u0629 \u0644\u0644\u0645\u0633\u0627\u0626\u0644 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a\u0629\u060c \u0623\u0648 \u0645\u062e\u0627\u0648\u0641 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629\u060c \u0623\u0648 \u0627\u0633\u062a\u0641\u0633\u0627\u0631\u0627\u062a \u0634\u0631\u0648\u0637 \u0627\u0644\u062e\u062f\u0645\u0629\u060c \u064a\u0645\u0643\u0646\u0643 \u0623\u064a\u0636\u064b\u0627 \u0645\u0631\u0627\u0633\u0644\u062a\u0646\u0627 \u0639\u0628\u0631 \u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0639\u0644\u0649 support@yaroapp.in \u0645\u0639 \u0633\u0637\u0631 \u0645\u0648\u0636\u0648\u0639 \u064a\u0630\u0643\u0631 \u0645\u062e\u0627\u0648\u0641\u0643 \u0628\u0648\u0636\u0648\u062d (\u0639\u0644\u0649 \u0633\u0628\u064a\u0644 \u0627\u0644\u0645\u062b\u0627\u0644\u060c \"\u0627\u0647\u062a\u0645\u0627\u0645 \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629\"\u060c \"\u0633\u0624\u0627\u0644 \u0634\u0631\u0648\u0637 \u0627\u0644\u062e\u062f\u0645\u0629\").",part3:""},refund_policy:{title:"\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f \u2013 \u062a\u0637\u0628\u064a\u0642 \u064a\u0627\u0631\u0648 Yaro",content:"\u062a\u0627\u0631\u064a\u062e \u0627\u0644\u0633\u0631\u064a\u0627\u0646: 15/08/2025\n\n1. \u0627\u0644\u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u0639\u0627\u0645\u0629\n\n\u062a\u0639\u062a\u0628\u0631 \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0627\u0644\u062a\u064a \u062a\u062a\u0645 \u062f\u0627\u062e\u0644 \u062a\u0637\u0628\u064a\u0642 \u064a\u0627\u0631\u0648 Yaro \u0646\u0647\u0627\u0626\u064a\u0629 \u0648\u063a\u064a\u0631 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f. \u0646\u062d\u0646 \u0646\u0642\u062f\u0645 \u0645\u062d\u062a\u0648\u0649 \u0648\u062e\u062f\u0645\u0627\u062a \u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0645\u062b\u0644 \u0627\u0644\u0648\u0635\u0648\u0644 \u0625\u0644\u0649 \u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0627\u0644\u0635\u0648\u062a\u064a\u0629 \u0648\u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0627\u0644\u0627\u0641\u062a\u0631\u0627\u0636\u064a\u0629 \u0648\u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0645\u0645\u064a\u0632\u0629. \u0628\u0645\u062c\u0631\u062f \u0627\u0644\u0634\u0631\u0627\u0621\u060c \u064a\u062a\u0645 \u062a\u0633\u0644\u064a\u0645 \u0647\u0630\u0647 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0641\u0648\u0631 \u0648\u0644\u0627 \u064a\u0645\u0643\u0646 \u0639\u0643\u0633\u0647\u0627.\n\n2. \u0639\u0645\u0644\u064a\u0627\u062a \u0627\u0644\u0634\u0631\u0627\u0621 \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\n\n\u2022 \u062a\u062a\u0645 \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0639\u0628\u0631 \u0645\u062a\u062c\u0631 Google Play \u0645\u0646 \u062e\u0644\u0627\u0644 \u0646\u0638\u0627\u0645 \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u062e\u0627\u0635 \u0628\u0640 Google Play.\n\u2022 \u0646\u062d\u0646 \u0644\u0627 \u0646\u0642\u0648\u0645 \u0628\u0645\u0639\u0627\u0644\u062c\u0629 \u0623\u0648\u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a \u0645\u0628\u0627\u0634\u0631\u0629.\n\u2022 \u0641\u064a \u062d\u0627\u0644\u0627\u062a \u0646\u0627\u062f\u0631\u0629\u060c \u0642\u062f \u064a\u062a\u0645 \u0627\u0644\u0646\u0638\u0631 \u0641\u064a \u0627\u0644\u0645\u0628\u0627\u0644\u063a \u0627\u0644\u0645\u0633\u062a\u0631\u062f\u0629 \u0625\u0630\u0627 \u0648\u0627\u062c\u0647 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645 \u0645\u0634\u0643\u0644\u0627\u062a \u0641\u0646\u064a\u0629 \u0623\u0648 \u0639\u0645\u0644\u064a\u0627\u062a \u0634\u0631\u0627\u0621 \u063a\u064a\u0631 \u0645\u0642\u0635\u0648\u062f\u0629.\n\n3. \u0627\u0644\u0623\u0647\u0644\u064a\u0629 \u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0627\u0644\u0623\u0645\u0648\u0627\u0644\n\n\u0633\u062a\u062a\u0645 \u0645\u0631\u0627\u062c\u0639\u0629 \u0637\u0644\u0628\u0627\u062a \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0627\u0644\u0623\u0645\u0648\u0627\u0644 \u0639\u0644\u0649 \u0623\u0633\u0627\u0633 \u0643\u0644 \u062d\u0627\u0644\u0629 \u0639\u0644\u0649 \u062d\u062f\u0629 \u0648\u0644\u0627 \u064a\u062c\u0648\u0632 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629 \u0639\u0644\u064a\u0647\u0627 \u0625\u0644\u0627 \u0641\u064a \u0638\u0644 \u0627\u0644\u0634\u0631\u0648\u0637 \u0627\u0644\u062a\u0627\u0644\u064a\u0629:\n\n\u2022 \u062a\u0643\u0631\u0627\u0631 \u0627\u0644\u0634\u0631\u0627\u0621\n\u2022 \u0639\u0637\u0644 \u0641\u0646\u064a (\u0644\u0645 \u064a\u062a\u0645 \u062a\u0633\u0644\u064a\u0645 \u0627\u0644\u0634\u0631\u0627\u0621)\n\u2022 \u0645\u0639\u0627\u0645\u0644\u0629 \u063a\u064a\u0631 \u0645\u0635\u0631\u062d \u0628\u0647\u0627 (\u0645\u0639 \u0625\u062b\u0628\u0627\u062a \u0635\u0627\u0644\u062d)\n\n\u0644\u0643\u064a \u062a\u0643\u0648\u0646 \u0645\u0624\u0647\u0644\u0627\u064b \u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0627\u0644\u0623\u0645\u0648\u0627\u0644\u060c \u064a\u062c\u0628 \u0639\u0644\u064a\u0643:\n\n\u2022 \u0627\u062a\u0635\u0644 \u0628\u0646\u0627 \u0641\u064a \u063a\u0636\u0648\u0646 48 \u0633\u0627\u0639\u0629 \u0645\u0646 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629\n\u2022 \u062a\u0642\u062f\u064a\u0645 \u0645\u0639\u0631\u0641 \u0627\u0644\u0637\u0644\u0628 \u0648\u0627\u0644\u0625\u062b\u0628\u0627\u062a \u0630\u064a \u0627\u0644\u0635\u0644\u0629 (\u0645\u062b\u0644 \u0644\u0642\u0637\u0627\u062a \u0627\u0644\u0634\u0627\u0634\u0629 \u0623\u0648 \u0631\u0633\u0627\u0626\u0644 \u0627\u0644\u062e\u0637\u0623)\n\n4. \u0643\u064a\u0641\u064a\u0629 \u0637\u0644\u0628 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0627\u0644\u0623\u0645\u0648\u0627\u0644\n\n\u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0639\u062a\u0642\u062f \u0623\u0646\u0643 \u0645\u0624\u0647\u0644 \u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0627\u0644\u0623\u0645\u0648\u0627\u0644\u060c \u0641\u0627\u062a\u0628\u0639 \u0623\u062d\u062f \u0647\u0630\u0647 \u0627\u0644\u062e\u064a\u0627\u0631\u0627\u062a:\n\n\u0639\u0628\u0631 Google Play:\n\n1. \u0627\u0641\u062a\u062d \u062d\u0633\u0627\u0628 Google Play \u0627\u0644\u062e\u0627\u0635 \u0628\u0643.\n2. \u0627\u0646\u062a\u0642\u0644 \u0625\u0644\u0649 \"\u0633\u062c\u0644 \u0627\u0644\u0637\u0644\u0628\u0627\u062a\".\n3. \u0627\u0628\u062d\u062b \u0639\u0646 \u0627\u0644\u0645\u0639\u0627\u0645\u0644\u0629 \u0648\u0627\u0646\u0642\u0631 \u0641\u0648\u0642 \"\u0627\u0644\u0625\u0628\u0644\u0627\u063a \u0639\u0646 \u0645\u0634\u0643\u0644\u0629\".\n4. \u062d\u062f\u062f \u0627\u0644\u0633\u0628\u0628 \u0627\u0644\u0645\u0646\u0627\u0633\u0628 \u0648\u0623\u0631\u0633\u0644 \u0627\u0644\u0646\u0645\u0648\u0630\u062c.\n\n\u0623\u0648 \u0627\u062a\u0635\u0644 \u0628\u0646\u0627 \u0645\u0628\u0627\u0634\u0631\u0629:\n\n\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a: support@yaroapp.in\n\u0642\u0645 \u0628\u062a\u0636\u0645\u064a\u0646:\n\n\u2022 \u0627\u0633\u0645\u0643\n\u2022 \u0645\u0639\u0631\u0641 \u0637\u0644\u0628 Google (\u064a\u0628\u062f\u0623 \u0628\u0640 GPA.)\n\u2022 \u0633\u0628\u0628 \u0637\u0644\u0628 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0627\u0644\u0623\u0645\u0648\u0627\u0644\n\u2022 \u0644\u0642\u0637\u0629 \u0634\u0627\u0634\u0629 (\u0625\u0646 \u0648\u062c\u062f\u062a)\n\n5. \u0627\u0644\u0625\u0637\u0627\u0631 \u0627\u0644\u0632\u0645\u0646\u064a \u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0627\u0644\u0623\u0645\u0648\u0627\u0644\n\n\u0641\u064a \u062d\u0627\u0644\u0629 \u0627\u0644\u0645\u0648\u0627\u0641\u0642\u0629\u060c \u0633\u064a\u062a\u0645 \u0625\u0635\u062f\u0627\u0631 \u0627\u0644\u0645\u0628\u0627\u0644\u063a \u0627\u0644\u0645\u0633\u062a\u0631\u062f\u0629 \u0625\u0644\u0649 \u0637\u0631\u064a\u0642\u0629 \u0627\u0644\u062f\u0641\u0639 \u0627\u0644\u0623\u0635\u0644\u064a\u0629 \u0641\u064a \u063a\u0636\u0648\u0646 5 \u0625\u0644\u0649 10 \u0623\u064a\u0627\u0645 \u0639\u0645\u0644\u060c \u0627\u0639\u062a\u0645\u0627\u062f\u064b\u0627 \u0639\u0644\u0649 \u0645\u0635\u0631\u0641\u0643 \u0623\u0648 \u0633\u064a\u0627\u0633\u0629 Google Play.\n\n6. \u0644\u0627 \u064a\u062a\u0645 \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0627\u0644\u0623\u0645\u0648\u0627\u0644 \u0645\u0646 \u0623\u062c\u0644:\n\n\u2022 \u062a\u063a\u064a\u064a\u0631 \u0627\u0644\u0631\u0623\u064a\n\u2022 \u0627\u0644\u062e\u062f\u0645\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645\u0629 \u062c\u0632\u0626\u064a\u064b\u0627 (\u0645\u062b\u0644 \u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0627\u0644\u0645\u0633\u062a\u0647\u0644\u0643\u0629 \u0623\u0648 \u0627\u0644\u062f\u0631\u062f\u0634\u0627\u062a \u0627\u0644\u0645\u0643\u062a\u0645\u0644\u0629)\n\u2022 \u0625\u0633\u0627\u0621\u0629 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0623\u0648 \u0627\u0646\u062a\u0647\u0627\u0643 \u0627\u0644\u0634\u0631\u0648\u0637\n\u2022 \u0627\u0644\u0637\u0644\u0628\u0627\u062a \u0628\u0639\u062f 48 \u0633\u0627\u0639\u0629 \u0645\u0646 \u0627\u0644\u0634\u0631\u0627\u0621\n\n7. \u0627\u062a\u0635\u0644 \u0628\u0646\u0627\n\n\u0644\u0644\u062d\u0635\u0648\u0644 \u0639\u0644\u0649 \u0627\u0644\u062f\u0639\u0645 \u0623\u0648 \u0637\u0644\u0628\u0627\u062a \u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0627\u0644\u0623\u0645\u0648\u0627\u0644\u060c \u064a\u0631\u062c\u0649 \u0627\u0644\u0627\u062a\u0635\u0627\u0644 \u0628\u0646\u0627 \u0639\u0628\u0631:\n\n\u0627\u0644\u0628\u0631\u064a\u062f \u0627\u0644\u0625\u0644\u0643\u062a\u0631\u0648\u0646\u064a \u0644\u0644\u062f\u0639\u0645: support@yaroapp.in\n\u0642\u0633\u0645 \u0627\u0644\u062f\u0639\u0645 \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642: \u0645\u062a\u0627\u062d \u0641\u064a \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642\n\n\u0639\u0646 \u0637\u0631\u064a\u0642 \u0627\u0644\u0634\u0631\u0627\u0621 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0641\u0625\u0646\u0643 \u062a\u0648\u0627\u0641\u0642 \u0639\u0644\u0649 \u0633\u064a\u0627\u0633\u0629 \u0627\u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0647\u0630\u0647."},terms_of_use:{title:"\u0634\u0631\u0648\u0637 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u2013 \u062a\u0637\u0628\u064a\u0642 \u064a\u0627\u0631\u0648 Yaro",content:"1. \u0645\u0642\u062f\u0645\u0629:\n\u0645\u0631\u062d\u0628\u064b\u0627 \u0628\u0643 \u0641\u064a \u062a\u0637\u0628\u064a\u0642 \u064a\u0627\u0631\u0648 Yaro\u060c \u0648\u0647\u0648 \u062a\u0637\u0628\u064a\u0642 \u0644\u0644\u062f\u0631\u062f\u0634\u0629 \u0627\u0644\u0635\u0648\u062a\u064a\u0629 \u0648\u0627\u0644\u0645\u0643\u0627\u0644\u0645\u0627\u062a \u0627\u0644\u0635\u0648\u062a\u064a\u0629 \u0627\u0644\u0627\u062c\u062a\u0645\u0627\u0639\u064a\u0629. \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0641\u0625\u0646\u0643 \u062a\u0648\u0627\u0641\u0642 \u0639\u0644\u0649 \u0627\u0644\u0627\u0644\u062a\u0632\u0627\u0645 \u0628\u0627\u0644\u0634\u0631\u0648\u0637 \u0648\u0627\u0644\u0623\u062d\u0643\u0627\u0645 \u0627\u0644\u062a\u0627\u0644\u064a\u0629.\n\n2. \u0623\u0647\u0644\u064a\u0629 \u0627\u0644\u0645\u0633\u062a\u062e\u062f\u0645:\n\u064a\u062c\u0628 \u0623\u0646 \u064a\u0643\u0648\u0646 \u0639\u0645\u0631\u0643 18 \u0639\u0627\u0645\u064b\u0627 \u0639\u0644\u0649 \u0627\u0644\u0623\u0642\u0644 \u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642. \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u060c \u0641\u0625\u0646\u0643 \u062a\u0624\u0643\u062f \u0623\u0646\u0643 \u062a\u0641\u064a \u0628\u0645\u0639\u0627\u064a\u064a\u0631 \u0627\u0644\u0623\u0647\u0644\u064a\u0629.\n\n3. \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642:\n- \u064a\u062a\u064a\u062d \u0644\u0643 \u0647\u0630\u0627 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0627\u0644\u0627\u0646\u0636\u0645\u0627\u0645 \u0625\u0644\u0649 \u063a\u0631\u0641 \u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0627\u0644\u0635\u0648\u062a\u064a\u0629 \u0627\u0644\u0639\u0627\u0645\u0629 \u0648\u0627\u0644\u062e\u0627\u0635\u0629 \u0648\u0625\u062c\u0631\u0627\u0621 \u0645\u0643\u0627\u0644\u0645\u0627\u062a \u0635\u0648\u062a\u064a\u0629 \u0644\u0645\u0633\u062a\u062e\u062f\u0645\u064a\u0646 \u0622\u062e\u0631\u064a\u0646.\n- \u062a\u0648\u0627\u0641\u0642 \u0639\u0644\u0649 \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0641\u0642\u0637 \u0644\u0644\u062a\u0648\u0627\u0635\u0644 \u0627\u0644\u0642\u0627\u0646\u0648\u0646\u064a \u0648\u0627\u0644\u0645\u062d\u062a\u0631\u0645.\n- \u064a\u064f\u062d\u0638\u0631 \u062a\u0645\u0627\u0645\u064b\u0627 \u0623\u064a \u0634\u0643\u0644 \u0645\u0646 \u0623\u0634\u0643\u0627\u0644 \u0627\u0644\u0625\u0633\u0627\u0621\u0629 \u0623\u0648 \u0627\u0644\u0645\u0636\u0627\u064a\u0642\u0629 \u0623\u0648 \u0627\u0644\u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u0645\u0631\u0641\u0648\u0636.\n\n4. \u0645\u0633\u0624\u0648\u0644\u064a\u0629 \u0627\u0644\u062d\u0633\u0627\u0628:\n- \u0623\u0646\u062a \u0645\u0633\u0624\u0648\u0644 \u0639\u0646 \u0627\u0644\u062d\u0641\u0627\u0638 \u0639\u0644\u0649 \u0633\u0631\u064a\u0629 \u062d\u0633\u0627\u0628\u0643.\n- \u064a\u062c\u0628 \u0623\u0644\u0627 \u062a\u0634\u0627\u0631\u0643 \u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0639\u062a\u0645\u0627\u062f \u062a\u0633\u062c\u064a\u0644 \u0627\u0644\u062f\u062e\u0648\u0644 \u0627\u0644\u062e\u0627\u0635\u0629 \u0628\u0643 \u0645\u0639 \u0623\u064a \u0634\u062e\u0635.\n- \u0625\u0630\u0627 \u0643\u0646\u062a \u062a\u0634\u0643 \u0641\u064a \u0623\u064a \u0648\u0635\u0648\u0644 \u063a\u064a\u0631 \u0645\u0635\u0631\u062d \u0628\u0647\u060c \u0641\u064a\u0631\u062c\u0649 \u0627\u0644\u0625\u0628\u0644\u0627\u063a \u0639\u0646\u0647 \u0645\u0646 \u062e\u0644\u0627\u0644 \u0642\u0633\u0645 \u062f\u0639\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642.\n\n5. \u0627\u0644\u062e\u0635\u0648\u0635\u064a\u0629 \u0648\u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a:\n- \u0646\u062d\u0646 \u0646\u0642\u062f\u0631 \u062e\u0635\u0648\u0635\u064a\u062a\u0643. \u0633\u064a\u062a\u0645 \u0627\u0644\u062a\u0639\u0627\u0645\u0644 \u0645\u0639 \u0628\u064a\u0627\u0646\u0627\u062a\u0643 \u0627\u0644\u0634\u062e\u0635\u064a\u0629 \u0628\u0634\u0643\u0644 \u0622\u0645\u0646 \u0648\u0644\u0646 \u062a\u064f\u0633\u062a\u062e\u062f\u0645 \u0625\u0644\u0627 \u0644\u062a\u062d\u0633\u064a\u0646 \u062a\u062c\u0631\u0628\u0629 \u0627\u0644\u062a\u0637\u0628\u064a\u0642.\n- \u0644\u0627 \u062a\u062a\u0645 \u0645\u0634\u0627\u0631\u0643\u0629 \u0627\u0644\u0628\u064a\u0627\u0646\u0627\u062a \u0627\u0644\u0635\u0648\u062a\u064a\u0629 \u0648\u062a\u0641\u0627\u0639\u0644\u0627\u062a \u0627\u0644\u062f\u0631\u062f\u0634\u0629 \u0639\u0644\u0646\u064b\u0627 \u0623\u0648 \u0645\u0639 \u0623\u0637\u0631\u0627\u0641 \u062b\u0627\u0644\u062b\u0629\u060c \u0645\u0627 \u0644\u0645 \u064a\u0642\u062a\u0636 \u0627\u0644\u0642\u0627\u0646\u0648\u0646 \u0630\u0644\u0643.\n\n6. \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a \u0648\u0627\u0644\u0639\u0645\u0644\u0627\u062a:\n- \u0642\u062f \u064a\u0642\u062f\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0639\u0645\u0644\u064a\u0627\u062a \u0634\u0631\u0627\u0621 \u062f\u0627\u062e\u0644 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u0645\u062b\u0644 \u0627\u0644\u0639\u0645\u0644\u0627\u062a \u0627\u0644\u0645\u0639\u062f\u0646\u064a\u0629 \u0623\u0648 \u0627\u0644\u0645\u064a\u0632\u0627\u062a \u0627\u0644\u0645\u0645\u064a\u0632\u0629.\n- \u062c\u0645\u064a\u0639 \u0627\u0644\u0645\u0634\u062a\u0631\u064a\u0627\u062a \u0646\u0647\u0627\u0626\u064a\u0629 \u0648\u063a\u064a\u0631 \u0642\u0627\u0628\u0644\u0629 \u0644\u0644\u0627\u0633\u062a\u0631\u062f\u0627\u062f \u0645\u0627 \u0644\u0645 \u062a\u0646\u0635 \u0633\u064a\u0627\u0633\u0627\u062a \u0645\u062a\u062c\u0631 \u0627\u0644\u062a\u0637\u0628\u064a\u0642\u0627\u062a \u0639\u0644\u0649 \u062e\u0644\u0627\u0641 \u0630\u0644\u0643.\n\n7. \u0625\u0646\u0647\u0627\u0621 \u0627\u0644\u062d\u0633\u0627\u0628:\n- \u062a\u062d\u062a\u0641\u0638 \u0645\u0646\u0635\u0629 \u064a\u0627\u0631\u0648 Yaro \u0628\u0627\u0644\u062d\u0642 \u0641\u064a \u062a\u0639\u0644\u064a\u0642 \u062d\u0633\u0627\u0628\u0643 \u0623\u0648 \u0625\u0646\u0647\u0627\u0626\u0647 \u0625\u0630\u0627 \u0627\u0646\u062a\u0647\u0643\u062a \u0623\u064a \u0634\u0631\u0648\u0637.\n- \u064a\u0645\u0643\u0646\u0643 \u0623\u064a\u0636\u064b\u0627 \u062d\u0630\u0641 \u062d\u0633\u0627\u0628\u0643 \u0641\u064a \u0623\u064a \u0648\u0642\u062a \u0645\u0646 \u0625\u0639\u062f\u0627\u062f\u0627\u062a \u0627\u0644\u062a\u0637\u0628\u064a\u0642.\n\n8. \u0645\u062d\u062a\u0648\u0649 \u0627\u0644\u062a\u0637\u0628\u064a\u0642:\n- \u0642\u062f \u064a\u062a\u0645 \u0625\u0646\u0634\u0627\u0621 \u0628\u0639\u0636 \u0627\u0644\u0639\u0646\u0627\u0635\u0631 \u0627\u0644\u0645\u0631\u0626\u064a\u0629 \u0623\u0648 \u0627\u0644\u0635\u0648\u0631 \u0627\u0644\u0631\u0645\u0632\u064a\u0629 \u0623\u0648 \u0627\u0644\u0623\u064a\u0642\u0648\u0646\u0627\u062a \u0628\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u0630\u0643\u0627\u0621 \u0627\u0644\u0627\u0635\u0637\u0646\u0627\u0639\u064a (AI).\n- \u0644\u0627 \u062a\u0645\u062b\u0644 \u0647\u0630\u0647 \u0623\u0641\u0631\u0627\u062f\u064b\u0627 \u062d\u0642\u064a\u0642\u064a\u064a\u0646. \u0623\u064a \u062a\u0634\u0627\u0628\u0647 \u0645\u062d\u0636 \u0635\u062f\u0641\u0629.\n\n9. \u062a\u063a\u064a\u064a\u0631\u0627\u062a \u0639\u0644\u0649 \u0627\u0644\u0634\u0631\u0648\u0637:\n\u0642\u062f \u0646\u0642\u0648\u0645 \u0628\u062a\u062d\u062f\u064a\u062b \u0647\u0630\u0647 \u0627\u0644\u0634\u0631\u0648\u0637 \u0645\u0646 \u0648\u0642\u062a \u0644\u0622\u062e\u0631. \u0627\u0644\u0627\u0633\u062a\u0645\u0631\u0627\u0631 \u0641\u064a \u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0627\u0644\u062a\u0637\u0628\u064a\u0642 \u064a\u0639\u0646\u064a \u0642\u0628\u0648\u0644\u0643 \u0644\u0644\u0634\u0631\u0648\u0637 \u0627\u0644\u0645\u062d\u062f\u062b\u0629.\n\n10. \u0627\u0644\u062f\u0639\u0645:\n\u0625\u0630\u0627 \u0643\u0627\u0646\u062a \u0644\u062f\u064a\u0643 \u0623\u0633\u0626\u0644\u0629\u060c \u0623\u0648 \u0645\u062e\u0627\u0648\u0641\u060c \u0623\u0648 \u0634\u0643\u0627\u0648\u0649\u060c \u0641\u064a\u0631\u062c\u0649 \u0627\u0644\u062a\u0648\u0627\u0635\u0644 \u0645\u0639\u0646\u0627 \u0645\u0646 \u0642\u0633\u0645 \u0627\u0644\u062f\u0639\u0645 \u0641\u064a \u0627\u0644\u062a\u0637\u0628\u064a\u0642.\n\n\u0645\u0644\u0627\u062d\u0638\u0629: \u062a\u0639\u062f \u0634\u0631\u0648\u0637 \u0627\u0644\u0627\u0633\u062a\u062e\u062f\u0627\u0645 \u0647\u0630\u0647 \u0645\u0628\u0627\u062f\u0626 \u062a\u0648\u062c\u064a\u0647\u064a\u0629 \u0639\u0627\u0645\u0629 \u0648\u0644\u0627 \u062a\u062d\u0644 \u0645\u062d\u0644 \u0623\u064a \u0642\u0648\u0627\u0639\u062f \u0642\u0627\u0646\u0648\u0646\u064a\u0629 \u0628\u0645\u0648\u062c\u0628 \u0627\u0644\u0642\u0648\u0627\u0646\u064a\u0646 \u0627\u0644\u0645\u0639\u0645\u0648\u0644 \u0628\u0647\u0627\u060c \u0628\u0645\u0627 \u0641\u064a \u0630\u0644\u0643 \u0642\u0627\u0646\u0648\u0646 \u0627\u0644\u0639\u0642\u0648\u0628\u0627\u062a \u0627\u0644\u0647\u0646\u062f\u064a \u0623\u0648 \u0642\u0627\u0646\u0648\u0646 \u062a\u0643\u0646\u0648\u0644\u0648\u062c\u064a\u0627 \u0627\u0644\u0645\u0639\u0644\u0648\u0645\u0627\u062a."},notifications:{title:"\u0627\u0644\u0625\u0634\u0639\u0627\u0631\u0627\u062a",empty:"\u0644\u0627 \u062a\u0648\u062c\u062f \u0625\u0634\u0639\u0627\u0631\u0627\u062a \u062d\u062a\u0649 \u0627\u0644\u0622\u0646"},system_messages:{title:"\u0631\u0633\u0627\u0626\u0644 \u0627\u0644\u0646\u0638\u0627\u0645",empty:"\u0644\u0627 \u062a\u0648\u062c\u062f \u0631\u0633\u0627\u0626\u0644 \u0646\u0638\u0627\u0645"},recharge:{title:"\u0634\u062d\u0646 \u0627\u0644\u0645\u062d\u0641\u0638\u0629",processing:"\u062c\u0627\u0631\u064a \u0645\u0639\u0627\u0644\u062c\u0629 \u0627\u0644\u0634\u0631\u0627\u0621...",history:"\u0633\u062c\u0644 \u0627\u0644\u0634\u062d\u0646",no_history:"\u0644\u0645 \u064a\u062a\u0645 \u0627\u0644\u0639\u062b\u0648\u0631 \u0639\u0644\u0649 \u0633\u062c\u0644 \u0634\u062d\u0646."},withdrawal:{title:"\u0633\u062d\u0628",min_withdrawal:"\u0627\u0644\u062d\u062f \u0627\u0644\u0623\u062f\u0646\u0649 \u0644\u0644\u0633\u062d\u0628 \u0647\u0648 \u20b9",complete_kyc:"\u0623\u0643\u0645\u0644 KYC \u0627\u0644\u062e\u0627\u0635 \u0628\u0643",verify:"\u062a\u062d\u0642\u0642",input_coin:"\u0623\u062f\u062e\u0644 \u0639\u0645\u0644\u0629 \u0627\u0644\u0633\u062d\u0628",equivalent_amount:"\u0627\u0644\u0645\u0628\u0644\u063a \u0627\u0644\u0645\u0639\u0627\u062f\u0644:",bank_account:"\u062d\u0633\u0627\u0628 \u0628\u0646\u0643\u064a",upi:"\u0648\u0627\u062c\u0647\u0629 \u0627\u0644\u0645\u062f\u0641\u0648\u0639\u0627\u062a \u0627\u0644\u0645\u0648\u062d\u062f\u0629",bank_name:"\u0627\u0633\u0645 \u0627\u0644\u