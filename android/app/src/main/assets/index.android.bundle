\u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902",username_length_error:"\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e \u092e\u0947\u0902 \u0915\u092e \u0938\u0947 \u0915\u092e 3 \u0935\u0930\u094d\u0923 \u0939\u094b\u0928\u0947 \u091a\u093e\u0939\u093f\u090f",username_success:"\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e \u0938\u092b\u0932\u0924\u093e\u092a\u0942\u0930\u094d\u0935\u0915 \u0938\u0947\u091f \u0915\u093f\u092f\u093e \u0917\u092f\u093e!",username_fail:"\u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e \u0938\u0947\u091f \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0935\u093f\u092b\u0932",update_success:"\u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0905\u092a\u0921\u0947\u091f \u0915\u0940 \u0917\u0908!",update_fail:"\u0905\u0926\u094d\u092f\u0924\u0928 \u0935\u093f\u092b\u0932 \u0930\u0939\u093e",error:"\u0924\u094d\u0930\u0941\u091f\u093f",success:"\u0938\u092b\u0932\u0924\u093e",something_wrong:"\u0915\u0941\u091b \u0917\u0932\u0924 \u0939\u094b \u0917\u092f\u093e"},account:{title:"\u0916\u093e\u0924\u093e",google_email:"Google \u0908\u092e\u0947\u0932",phone_number:"\u092b\u093c\u094b\u0928 \u0928\u0902\u092c\u0930",verified:"\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924",not_verified:"\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0928\u0939\u0940\u0902",verify:"\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902"},privacy_policy:{title:"\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f \u2014 Yaro",content:"\u092a\u094d\u0930\u092d\u093e\u0935\u0940 \u0924\u093f\u0925\u093f: 15/08/2025\n\n---\n\n1. \u092a\u0930\u093f\u091a\u092f\n\nYaro (\"\u0939\u092e\", \"\u0939\u092e\u093e\u0930\u093e\", \u092f\u093e \"\u0939\u092e\u0947\u0902\") \u0906\u092a\u0915\u0940 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0915\u093e \u0938\u092e\u094d\u092e\u093e\u0928 \u0915\u0930\u0924\u093e \u0939\u0948 \u0914\u0930 \u0906\u092a\u0915\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0921\u0947\u091f\u093e \u0915\u0940 \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0924\u093f\u092c\u0926\u094d\u0927 \u0939\u0948\u0964 \u092f\u0939 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f \u092c\u0924\u093e\u0924\u0940 \u0939\u0948 \u0915\u093f \u091c\u092c \u0906\u092a \u0939\u092e\u093e\u0930\u0947 \u092e\u094b\u092c\u093e\u0907\u0932 \u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 (\"\u0910\u092a\") \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b \u0939\u092e \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0948\u0938\u0947 \u090f\u0915\u0924\u094d\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u092a\u094d\u0930\u0915\u091f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u3002\n\n\u0910\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947, \u0906\u092a \u092f\u0939\u093e\u0902 \u0935\u0930\u094d\u0923\u093f\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u0947 \u0938\u0902\u0917\u094d\u0930\u0939 \u0914\u0930 \u0909\u092a\u092f\u094b\u0917 \u0938\u0947 \u0938\u0939\u092e\u0924 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964\n\n2. \u0939\u092e \u091c\u094b \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u090f\u0915\u0924\u094d\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\n\n2.1 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940:\n\u091c\u092c \u0906\u092a \u0910\u092a \u0915\u0947 \u0932\u093f\u090f \u092a\u0902\u091c\u0940\u0915\u0930\u0923 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u092f\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u0924\u094b \u0939\u092e \u0906\u092a\u0915\u093e \u0928\u093e\u092e, \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093e\u092e, \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u091a\u093f\u0924\u094d\u0930, \u0908\u092e\u0947\u0932 \u092a\u0924\u093e \u0914\u0930 \u092d\u0941\u0917\u0924\u093e\u0928 \u0935\u093f\u0935\u0930\u0923 \u091c\u0948\u0938\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u090f\u0915\u0924\u094d\u0930 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\n\n2.2 \u0909\u092a\u092f\u094b\u0917 \u0921\u0947\u091f\u093e:\n\u0939\u092e \u0907\u0938 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0921\u0947\u091f\u093e \u090f\u0915\u0924\u094d\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a \u0910\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0948\u0938\u0947 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902, \u091c\u093f\u0938\u092e\u0947\u0902 \u0905\u0928\u094d\u092f \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u0947 \u0938\u093e\u0925 \u092c\u093e\u0924\u091a\u0940\u0924, \u0935\u0949\u092f\u0938 \u091a\u0948\u091f \u0932\u0949\u0917 \u092e\u0947\u091f\u093e\u0921\u0947\u091f\u093e (\u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0928\u0939\u0940\u0902), \u0914\u0930 \u0910\u092a \u0909\u092a\u092f\u094b\u0917 \u0906\u0901\u0915\u0921\u093c\u0947 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902\u0964\n\n2.3 \u0921\u093f\u0935\u093e\u0907\u0938 \u091c\u093e\u0928\u0915\u093e\u0930\u0940:\n\u0906\u092a\u0915\u0947 \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u091c\u093e\u0928\u0915\u093e\u0930\u0940, \u091c\u0948\u0938\u0947 \u0915\u093f \u0921\u093f\u0935\u093e\u0907\u0938 \u0915\u093e \u092a\u094d\u0930\u0915\u093e\u0930, \u0911\u092a\u0930\u0947\u091f\u093f\u0902\u0917 \u0938\u093f\u0938\u094d\u091f\u092e \u0938\u0902\u0938\u094d\u0915\u0930\u0923, \u0935\u093f\u0936\u093f\u0937\u094d\u091f \u0921\u093f\u0935\u093e\u0907\u0938 \u092a\u0939\u091a\u093e\u0928\u0915\u0930\u094d\u0924\u093e, \u0906\u0908\u092a\u0940 \u092a\u0924\u093e \u0914\u0930 \u092e\u094b\u092c\u093e\u0907\u0932 \u0928\u0947\u091f\u0935\u0930\u094d\u0915 \u091c\u093e\u0928\u0915\u093e\u0930\u0940\u0964\n\n3. \u0939\u092e \u0906\u092a\u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0948\u0938\u0947 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\n\n\u2022 \u0935\u0949\u092f\u0938 \u0915\u0949\u0932 \u0914\u0930 \u091a\u0948\u091f \u0938\u0947\u0935\u093e\u0913\u0902 \u0938\u0939\u093f\u0924 \u0910\u092a \u0915\u0940 \u0938\u0941\u0935\u093f\u0927\u093e\u090f\u0902 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u0914\u0930 \u092c\u0928\u093e\u090f \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964\n\u2022 \u092d\u0941\u0917\u0924\u093e\u0928 \u0938\u0902\u0938\u093e\u0927\u093f\u0924 \u0915\u0930\u0928\u0947 \u0914\u0930 \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0915\u093e \u092a\u094d\u0930\u092c\u0902\u0927\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964\n\u2022 \u0905\u092a\u0921\u0947\u091f, \u092a\u094d\u0930\u091a\u093e\u0930 \u0914\u0930 \u0938\u092e\u0930\u094d\u0925\u0928 \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947\u0902 \u0906\u092a\u0938\u0947 \u0938\u0902\u0935\u093e\u0926 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964\n\u2022 \u0939\u092e\u093e\u0930\u0947 \u0910\u092a \u0915\u094b \u092c\u0947\u0939\u0924\u0930 \u092c\u0928\u093e\u0928\u0947 \u0914\u0930 \u0928\u0908 \u0938\u0941\u0935\u093f\u0927\u093e\u090f\u0901 \u0935\u093f\u0915\u0938\u093f\u0924 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964\n\u2022 \u0927\u094b\u0916\u093e\u0927\u0921\u093c\u0940 \u092f\u093e \u0905\u0935\u0948\u0927 \u0917\u0924\u093f\u0935\u093f\u0927\u093f\u092f\u094b\u0902 \u0915\u093e \u092a\u0924\u093e \u0932\u0917\u093e\u0928\u0947 \u0914\u0930 \u0930\u094b\u0915\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f\u0964\n\n5. \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u091c\u0928\u093f\u0924 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 (UGC) \u0928\u0940\u0924\u093f\n\n\u2022 **\u0936\u0942\u0928\u094d\u092f \u0938\u0939\u0928\u0936\u0940\u0932\u0924\u093e**: \u0906\u092a\u0924\u094d\u0924\u093f\u091c\u0928\u0915 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092f\u093e \u0905\u092a\u092e\u093e\u0928\u091c\u0928\u0915 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u0939\u092e\u093e\u0930\u0940 \u0936\u0942\u0928\u094d\u092f-\u0938\u0939\u0928\u0936\u0940\u0932\u0924\u093e \u0928\u0940\u0924\u093f \u0939\u0948\u0964\n\u2022 **\u0930\u093f\u092a\u094b\u0930\u094d\u091f\u093f\u0902\u0917**: \u0906\u092a \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u092a\u094d\u0930\u094b\u092b\u093e\u0907\u0932 \u092f\u093e \u091a\u0948\u091f \u0938\u094d\u0915\u094d\u0930\u0940\u0928 \u092a\u0930 '\u0930\u093f\u092a\u094b\u0930\u094d\u091f' \u092c\u091f\u0928 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0910\u092a \u0915\u0947 \u092d\u0940\u0924\u0930 \u0938\u0940\u0927\u0947 \u0905\u0928\u0941\u091a\u093f\u0924 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u092f\u093e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u0940 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\n\u2022 **\u0905\u0935\u0930\u0941\u0926\u094d\u0927 \u0915\u0930\u0928\u093e**: \u0906\u092a \u0915\u093f\u0938\u0940 \u092d\u0940 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u094b \u0906\u092a\u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0928\u0947 \u0938\u0947 \u0930\u094b\u0915\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0905\u0935\u0930\u0941\u0926\u094d\u0927 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\n\u2022 **\u0915\u093e\u0930\u094d\u0930\u0935\u093e\u0908**: \u0939\u092e 24 \u0918\u0902\u091f\u094b\u0902 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0940 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0914\u0930 \u0906\u092a\u0924\u094d\u0924\u093f\u091c\u0928\u0915 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0915\u094b \u0939\u091f\u093e \u0926\u0947\u0902\u0917\u0947 \u0914\u0930 \u0939\u092e\u093e\u0930\u0940 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u093e \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u0915\u0930\u0928\u0947 \u0935\u093e\u0932\u0947 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u0928\u093f\u0932\u0902\u092c\u093f\u0924 \u0915\u0930 \u0926\u0947\u0902\u0917\u0947\u0964\n\u2022 **\u0928\u093f\u0937\u093f\u0926\u094d\u0927 \u0938\u093e\u092e\u0917\u094d\u0930\u0940**: \u0905\u092d\u0926\u094d\u0930 \u092d\u093e\u0937\u093e, \u0928\u0917\u094d\u0928\u0924\u093e, \u0939\u093f\u0902\u0938\u093e, \u092c\u0926\u092e\u093e\u0936\u0940 \u0914\u0930 \u0909\u0924\u094d\u092a\u0940\u0921\u093c\u0928 \u0938\u0916\u094d\u0924 \u0935\u0930\u094d\u091c\u093f\u0924 \u0939\u0948\u0964\n\n6. \u0921\u0947\u091f\u093e \u0938\u093e\u091d\u093e\u0915\u0930\u0923 \u0914\u0930 \u092a\u094d\u0930\u0915\u091f\u0940\u0915\u0930\u0923\n\n\u2022 \u0939\u092e \u0906\u092a\u0915\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0924\u0940\u0938\u0930\u0947 \u092a\u0915\u094d\u0937 \u0915\u094b \u0928\u0939\u0940\u0902 \u092c\u0947\u091a\u0924\u0947 \u0939\u0948\u0902\u0964\n\u2022 \u0939\u092e \u0906\u092a\u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0935\u093f\u0936\u094d\u0935\u0938\u0928\u0940\u092f \u0938\u0947\u0935\u093e \u092a\u094d\u0930\u0926\u093e\u0924\u093e\u0913\u0902 \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u091d\u093e \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902 \u091c\u094b \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0938\u092e\u091d\u094c\u0924\u094b\u0902 \u0915\u0947 \u0905\u0927\u0940\u0928 \u0910\u092a \u0915\u094b \u0938\u0902\u091a\u093e\u0932\u093f\u0924 \u0915\u0930\u0928\u0947 \u092e\u0947\u0902 \u0938\u0939\u093e\u092f\u0924\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n\u2022 \u092f\u0926\u093f \u0915\u093e\u0928\u0942\u0928 \u0926\u094d\u0935\u093e\u0930\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0939\u094b \u092f\u093e \u0939\u092e\u093e\u0930\u0947 \u0905\u0927\u093f\u0915\u093e\u0930\u094b\u0902 \u0915\u0940 \u0930\u0915\u094d\u0937\u093e \u0915\u0947 \u0932\u093f\u090f \u0939\u092e \u0906\u092a\u0915\u093e \u0921\u0947\u091f\u093e \u092a\u094d\u0930\u0915\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\n\n5. \u0907\u0928-\u0910\u092a \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0914\u0930 \u092d\u0941\u0917\u0924\u093e\u0928\n\n\u0938\u092d\u0940 \u092d\u0941\u0917\u0924\u093e\u0928\u094b\u0902 \u0915\u094b \u0910\u092a \u0938\u094d\u091f\u094b\u0930 \u0915\u0947 \u092d\u0941\u0917\u0924\u093e\u0928 \u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0938\u0902\u0938\u093e\u0927\u093f\u0924 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948\u0964 \u0939\u092e \u0906\u092a\u0915\u0947 \u092d\u0941\u0917\u0924\u093e\u0928 \u0935\u093f\u0935\u0930\u0923 \u0915\u094b \u0938\u0940\u0927\u0947 \u0938\u0902\u0917\u094d\u0930\u0939\u0940\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n\n6. \u0906\u092a\u0915\u0947 \u0905\u0927\u093f\u0915\u093e\u0930 \u0914\u0930 \u0935\u093f\u0915\u0932\u094d\u092a\n\n\u2022 \u0906\u092a \u0910\u092a \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u092f\u093e \u0938\u092e\u0930\u094d\u0925\u0928 \u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0915\u0947 \u0905\u092a\u0928\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0924\u0915 \u092a\u0939\u0941\u0902\u091a, \u0905\u092a\u0921\u0947\u091f \u092f\u093e \u0939\u091f\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\n\u2022 \u0906\u092a \u0915\u093f\u0938\u0940 \u092d\u0940 \u0938\u092e\u092f \u092a\u094d\u0930\u091a\u093e\u0930 \u0938\u0902\u091a\u093e\u0930 \u092a\u094d\u0930\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0938\u0947 \u092c\u093e\u0939\u0930 \u0928\u093f\u0915\u0932 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\n\u2022 \u0906\u092a \u0910\u092a \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0915\u092d\u0940 \u092d\u0940 \u0905\u092a\u0928\u093e \u0916\u093e\u0924\u093e \u0939\u091f\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\n\n7. \u0921\u0947\u091f\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e\n\n\u0939\u092e \u0906\u092a\u0915\u0940 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u094b \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u092a\u0939\u0941\u0902\u091a, \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928, \u092a\u094d\u0930\u0915\u091f\u0940\u0915\u0930\u0923 \u092f\u093e \u0935\u093f\u0928\u093e\u0936 \u0938\u0947 \u092c\u091a\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0909\u0926\u094d\u092f\u094b\u0917-\u092e\u093e\u0928\u0915 \u0924\u0915\u0928\u0940\u0915\u0940 \u0914\u0930 \u0938\u0902\u0917\u0920\u0928\u093e\u0924\u094d\u092e\u0915 \u0909\u092a\u093e\u092f\u094b\u0902 \u0915\u094b \u0932\u093e\u0917\u0942 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n\n8. \u092c\u091a\u094d\u091a\u094b\u0902 \u0915\u0940 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e\n\n\u0939\u092e\u093e\u0930\u093e \u0910\u092a 18 \u0935\u0930\u094d\u0937 \u0938\u0947 \u0915\u092e \u0909\u092e\u094d\u0930 \u0915\u0947 \u092c\u091a\u094d\u091a\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u0928\u0939\u0940\u0902 \u0939\u0948\u0964 \u0939\u092e \u091c\u093e\u0928\u092c\u0942\u091d\u0915\u0930 18 \u0935\u0930\u094d\u0937 \u0938\u0947 \u0915\u092e \u0909\u092e\u094d\u0930 \u0915\u0947 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0935\u094d\u092f\u0915\u094d\u0924\u093f \u0938\u0947 \u0921\u0947\u091f\u093e \u090f\u0915\u0924\u094d\u0930 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n\n9. \u0907\u0938 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f \u092e\u0947\u0902 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928\n\n\u0939\u092e \u0915\u092d\u0940-\u0915\u092d\u0940 \u0907\u0938 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f \u0915\u094b \u0905\u092a\u0921\u0947\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u092e \u0907\u0938 \u092a\u0943\u0937\u094d\u0920 \u092a\u0930 \u0928\u0908 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f \u092a\u094b\u0938\u094d\u091f \u0915\u0930\u0915\u0947 \u0906\u092a\u0915\u094b \u0915\u093f\u0938\u0940 \u092d\u0940 \u092c\u0926\u0932\u093e\u0935 \u0915\u0940 \u0938\u0942\u091a\u0928\u093e \u0926\u0947\u0902\u0917\u0947\u0964 \u092a\u0930\u093f\u0935\u0930\u094d\u0924\u0928 \u0915\u0947 \u092c\u093e\u0926 \u0910\u092a \u0915\u0947 \u0928\u093f\u0930\u0902\u0924\u0930 \u0909\u092a\u092f\u094b\u0917 \u0915\u093e \u092e\u0924\u0932\u092c \u0939\u0948 \u0915\u093f \u0906\u092a \u0905\u0926\u094d\u092f\u0924\u0928 \u0928\u0940\u0924\u093f \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n\n10. \u0939\u092e\u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\n\n\u0907\u0938 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f \u092f\u093e \u0906\u092a\u0915\u0947 \u0921\u0947\u091f\u093e \u0915\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u0915\u093f\u0938\u0940 \u092d\u0940 \u092a\u094d\u0930\u0936\u094d\u0928 \u0915\u0947 \u0932\u093f\u090f, \u0915\u0943\u092a\u092f\u093e \u0910\u092a \u092e\u0947\u0902 \u0938\u092e\u0930\u094d\u0925\u0928 \u0905\u0928\u0941\u092d\u093e\u0917 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0939\u092e\u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u3002\n\nYaro \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947, \u0906\u092a \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a\u0928\u0947 \u0907\u0938 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u0940\u0924\u093f \u0915\u094b \u092a\u0922\u093c \u0914\u0930 \u0938\u0939\u092e\u0924 \u0939\u094b \u0917\u090f \u0939\u0948\u0902."},about_us:{title:"\u0939\u092e\u093e\u0930\u0947 \u092c\u093e\u0930\u0947 \u092e\u0947\u0902 \u2013 Yaro",content:"Yaro \u092e\u0947\u0902 \u0906\u092a\u0915\u093e \u0938\u094d\u0935\u093e\u0917\u0924 \u0939\u0948 - \u090f\u0915 \u0928\u093f\u091c\u0940 1-\u0911\u0928-1 \u0935\u0949\u0907\u0938 \u0915\u0949\u0932\u093f\u0902\u0917 \u0914\u0930 \u092b\u094d\u0930\u0947\u0902\u0921\u0936\u093f\u092a \u0910\u092a!\n\nYaro \u090f\u0915 \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0906\u0935\u093e\u091c \u092e\u0902\u091a \u0939\u0948 \u091c\u094b \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0938\u092e\u092f \u0915\u0947 1-\u0911\u0928-1 \u0935\u0949\u092f\u0938 \u0915\u0949\u0932 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u091c\u0941\u0921\u093c\u0928\u0947 \u092e\u0947\u0902 \u092e\u0926\u0926 \u0915\u0930\u0924\u093e \u0939\u0948\u0964 \u091a\u093e\u0939\u0947 \u0906\u092a \u092c\u093e\u0924 \u0915\u0930\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u094b\u0902, \u0928\u090f \u0926\u094b\u0938\u094d\u0924 \u092c\u0928\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u094b\u0902, \u092f\u093e \u092c\u0938 \u0938\u092e\u092f \u092c\u093f\u0924\u093e\u0928\u093e \u091a\u093e\u0939\u0924\u0947 \u0939\u094b\u0902, Yaro \u0938\u093e\u0930\u094d\u0925\u0915 \u0906\u0935\u093e\u091c \u0935\u093e\u0930\u094d\u0924\u093e\u0932\u093e\u092a\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0914\u0930 \u0906\u0915\u0930\u094d\u0937\u0915 \u0938\u094d\u0925\u093e\u0928 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0940 \u0939\u0948\u3002\n\n\ud83c\udfaf \u092a\u094d\u0930\u092e\u0941\u0916 \u0935\u093f\u0936\u0947\u0937\u0924\u093e\u090f\u0902:\n\n\u2022 1-\u0911\u0928-1 \u0930\u0940\u092f\u0932-\u091f\u093e\u0907\u092e \u0935\u0949\u092f\u0938 \u0915\u0949\u0932\u093f\u0902\u0917\n\u2022 \u0938\u093f\u0915\u094d\u0915\u093e-\u0906\u0927\u093e\u0930\u093f\u0924 \u0915\u0949\u0932\u093f\u0902\u0917 \u092a\u094d\u0930\u0923\u093e\u0932\u0940 (\u0906\u0938\u093e\u0928 \u0930\u093f\u091a\u093e\u0930\u094d\u091c \u0915\u0947 \u0938\u093e\u0925)\n\u2022 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u0905\u0928\u0941\u0915\u0942\u0932\u0928 (\u0905\u0935\u0924\u093e\u0930, \u092c\u093e\u092f\u094b\u0938)\n\u2022 \u0928\u090f \u0932\u094b\u0917\u094b\u0902 \u0938\u0947 \u092e\u093f\u0932\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u094d\u092e\u093e\u0930\u094d\u091f \u092e\u0948\u091a\u092e\u0947\u0915\u093f\u0902\u0917\n\u2022 \u092a\u0942\u0930\u094d\u0923 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 - \u092c\u094d\u0932\u0949\u0915, \u0930\u093f\u092a\u094b\u0930\u094d\u091f, \u0906\u0926\u093f\u3002\n\n\ud83d\udd12 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0914\u0930 \u0938\u092e\u094d\u092e\u093e\u0928\u091c\u0928\u0915 \u0935\u093e\u0924\u093e\u0935\u0930\u0923\n\n\u0939\u092e \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0938\u0941\u0930\u0915\u094d\u0937\u093e \u0915\u094b \u092a\u094d\u0930\u093e\u0925\u092e\u093f\u0915\u0924\u093e \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0939\u092e\u093e\u0930\u0947 \u092e\u0902\u091a \u092e\u0947\u0902 \u090f\u0915 \u0938\u092e\u094d\u092e\u093e\u0928\u091c\u0928\u0915 \u0914\u0930 \u0926\u0941\u0930\u0941\u092a\u092f\u094b\u0917-\u092e\u0941\u0915\u094d\u0924 \u0905\u0928\u0941\u092d\u0935 \u092c\u0928\u093e\u090f \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0916\u094d\u0924 \u092e\u0949\u0921\u0930\u0947\u0936\u0928 \u091f\u0942\u0932, \u0930\u093f\u092a\u094b\u0930\u094d\u091f\u093f\u0902\u0917 \u0938\u0941\u0935\u093f\u0927\u093e\u090f\u0901 \u0914\u0930 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u0923 \u0936\u093e\u092e\u093f\u0932 \u0939\u0948\u0902\u0964\n\n\ud83c\udf0d \u0939\u092e \u0915\u094c\u0928 \u0939\u0948\u0902\n\nYaro \u092d\u093e\u0930\u0924 \u0938\u094d\u0925\u093f\u0924 \u091f\u0940\u092e \u0926\u094d\u0935\u093e\u0930\u093e \u0935\u093f\u0915\u0938\u093f\u0924 \u0915\u0940 \u0917\u0908 \u0939\u0948 \u091c\u094b \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0914\u0930 \u0927\u094d\u0935\u0928\u093f-\u0915\u0947\u0902\u0926\u094d\u0930\u093f\u0924 \u0938\u093e\u092e\u093e\u091c\u093f\u0915 \u0905\u0928\u0941\u092d\u0935\u094b\u0902 \u0915\u0947 \u0928\u093f\u0930\u094d\u092e\u093e\u0923 \u0915\u0947 \u092a\u094d\u0930\u0924\u093f \u091c\u0941\u0928\u0942\u0928\u0940 \u0939\u0948\u0964\n\n\ud83d\udcf1 \u0910\u092a \u0909\u092a\u0932\u092c\u094d\u0927\u0924\u093e:\n\nGoogle Play Store \u092a\u0930 \u0909\u092a\u0932\u092c\u094d\u0927 \u0939\u0948\nhttps://play.google.com/store/apps/details?id=yaro.vc.app\n\n\ud83d\udcec \u0939\u092e\u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902:\n\n\u0908\u092e\u0947\u0932: support@yaroapp.in\n\u0907\u0928-\u0910\u092a: \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u2192 \u0938\u0939\u093e\u092f\u0924\u093e \u0914\u0930 \u0938\u092e\u0930\u094d\u0925\u0928 \u092a\u0930 \u091c\u093e\u090f\u0902"},contact_us:{title:"\u0939\u092e\u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902",part1:"Yaro \u092e\u0947\u0902, \u0939\u092e \u0938\u092d\u0940 \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u0947 \u0932\u093f\u090f \u090f\u0915 \u0938\u0939\u091c \u0914\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0906\u0935\u093e\u091c-\u0915\u0949\u0932\u093f\u0902\u0917 \u0905\u0928\u0941\u092d\u0935 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u092a\u094d\u0930\u0924\u093f\u092c\u0926\u094d\u0927 \u0939\u0948\u0902\u0964 \u092f\u0926\u093f \u0906\u092a\u0915\u0947 \u092a\u093e\u0938 \u0910\u092a, \u0939\u092e\u093e\u0930\u0940 \u0938\u0947\u0935\u093e\u0913\u0902 \u092f\u093e \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0915\u0947 \u0938\u0902\u092c\u0902\u0927 \u092e\u0947\u0902 \u0915\u094b\u0908 \u092a\u094d\u0930\u0936\u094d\u0928, \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u092f\u093e \u091a\u093f\u0902\u0924\u093e \u0939\u0948, \u0924\u094b \u092c\u0947\u091d\u093f\u091d\u0915 \u0939\u092e\u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u3002\n\n\ud83d\udcec \u0938\u0939\u093e\u092f\u0924\u093e \u0908\u092e\u0947\u0932:\n",part2:"\n\u0939\u092e \u0906\u092e\u0924\u094c\u0930 \u092a\u0930 24-48 \u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u0918\u0902\u091f\u094b\u0902 \u0915\u0947 \u092d\u0940\u0924\u0930 \u091c\u0935\u093e\u092c \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u3002\n\n\ud83d\udee0 \u0907\u0928-\u0910\u092a \u0938\u092e\u0930\u094d\u0925\u0928:\n\u0906\u092a \u0910\u092a \u0915\u0947 \u092d\u0940\u0924\u0930 \u0938\u0947 \u092d\u0940 \u0939\u092e \u0924\u0915 \u092a\u0939\u0941\u0902\u091a \u0938\u0915\u0924\u0947 \u0939\u0948\u0902:\n\n1. \u0905\u092a\u0928\u0940 \u092a\u094d\u0930\u094b\u092b\u093c\u093e\u0907\u0932 \u092a\u0930 \u091c\u093e\u090f\u0902\n2. \u0938\u0939\u093e\u092f\u0924\u093e \u0914\u0930 \u0938\u092e\u0930\u094d\u0925\u0928 \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\n3. \u0905\u092a\u0928\u093e \u092e\u0941\u0926\u094d\u0926\u093e \u092f\u093e \u092a\u094d\u0930\u0924\u093f\u0915\u094d\u0930\u093f\u092f\u093e \u0938\u0940\u0927\u0947 \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0947\u0902\n\n\ud83e\uddd1\u200d\u2696 \u0915\u093e\u0928\u0942\u0928\u0940 \u0914\u0930 \u0928\u0940\u0924\u093f \u0938\u0902\u092c\u0902\u0927\u0940 \u092a\u094d\u0930\u0936\u094d\u0928:\n\u0915\u093e\u0928\u0942\u0928\u0940 \u092e\u093e\u092e\u0932\u094b\u0902, \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0938\u0902\u092c\u0902\u0927\u0940 \u091a\u093f\u0902\u0924\u093e\u0913\u0902, \u092f\u093e \u0938\u0947\u0935\u093e \u0915\u0940 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u0940 \u092a\u0942\u091b\u0924\u093e\u091b \u0915\u0947 \u0932\u093f\u090f, \u0906\u092a \u0939\u092e\u0947\u0902 ",part3:" \u092a\u0930 \u0908\u092e\u0947\u0932 \u092d\u0940 \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902, \u091c\u093f\u0938\u092e\u0947\u0902 \u0935\u093f\u0937\u092f \u092a\u0902\u0915\u094d\u0924\u093f \u0938\u094d\u092a\u0937\u094d\u091f \u0930\u0942\u092a \u0938\u0947 \u0906\u092a\u0915\u0940 \u091a\u093f\u0902\u0924\u093e \u0915\u093e \u0909\u0932\u094d\u0932\u0947\u0916 \u0915\u0930\u0924\u0940 \u0939\u0948 (\u0909\u0926\u093e., \"\u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u091a\u093f\u0902\u0924\u093e\", \"\u0938\u0947\u0935\u093e \u0915\u0940 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u0947 \u092a\u094d\u0930\u0936\u094d\u0928\")\u0964"},refund_policy:{title:"\u0930\u093f\u092b\u0902\u0921 \u0928\u0940\u0924\u093f \u2013 Yaro",content:"\u092a\u094d\u0930\u092d\u093e\u0935\u0940 \u0924\u093f\u0925\u093f: 15/08/2025\n\n1. \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0928\u0940\u0924\u093f\n\nYaro \u0915\u0947 \u092d\u0940\u0924\u0930 \u0915\u0940 \u0917\u0908 \u0938\u092d\u0940 \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0905\u0902\u0924\u093f\u092e \u0914\u0930 \u0917\u0948\u0930-\u0935\u093e\u092a\u0938\u0940 \u092f\u094b\u0917\u094d\u092f \u092e\u093e\u0928\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0964 \u0939\u092e \u0935\u0949\u092f\u0938 \u091a\u0948\u091f \u090f\u0915\u094d\u0938\u0947\u0938, \u0935\u0930\u094d\u091a\u0941\u0905\u0932 \u0938\u093f\u0915\u094d\u0915\u0947 \u0914\u0930 \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0938\u0941\u0935\u093f\u0927\u093e\u0913\u0902 \u091c\u0948\u0938\u0940 \u0935\u0930\u094d\u091a\u0941\u0905\u0932 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0914\u0930 \u0938\u0947\u0935\u093e\u090f\u0902 \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u090f\u0915 \u092c\u093e\u0930 \u0916\u0930\u0940\u0926\u0947 \u091c\u093e\u0928\u0947 \u0915\u0947 \u092c\u093e\u0926, \u092f\u0947 \u0938\u0947\u0935\u093e\u090f\u0902 \u0924\u0941\u0930\u0902\u0924 \u0935\u093f\u0924\u0930\u093f\u0924 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u0902 \u0914\u0930 \u0907\u0928\u094d\u0939\u0947\u0902 \u0909\u0932\u091f\u093e \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u3002\n\n2. \u0907\u0928-\u0910\u092a \u0916\u0930\u0940\u0926\u093e\u0930\u0940\n\n\u2022 Google Play Store \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0915\u0940 \u0917\u0908 \u0916\u0930\u0940\u0926\u093e\u0930\u0940 Google Play \u0915\u0940 \u092d\u0941\u0917\u0924\u093e\u0928 \u092a\u094d\u0930\u0923\u093e\u0932\u0940 \u0926\u094d\u0935\u093e\u0930\u093e \u0928\u093f\u092f\u0902\u0924\u094d\u0930\u093f\u0924 \u0915\u0940 \u091c\u093e\u0924\u0940 \u0939\u0948\u3002\n\u2022 \u0939\u092e \u0938\u0940\u0927\u0947 \u092d\u0941\u0917\u0924\u093e\u0928 \u0915\u094b \u0938\u0902\u0938\u093e\u0927\u093f\u0924 \u092f\u093e \u092a\u094d\u0930\u092c\u0902\u0927\u093f\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u3002\n\u2022 \u0926\u0941\u0930\u094d\u0932\u092d \u092e\u093e\u092e\u0932\u094b\u0902 \u092e\u0947\u0902, \u092f\u0926\u093f \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u0915\u094b \u0924\u0915\u0928\u0940\u0915\u0940 \u0938\u092e\u0938\u094d\u092f\u093e\u0913\u0902 \u092f\u093e \u0906\u0915\u0938\u094d\u092e\u093f\u0915 \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0915\u093e \u0905\u0928\u0941\u092d\u0935 \u0939\u094b\u0924\u093e \u0939\u0948, \u0924\u094b \u0930\u093f\u092b\u0902\u0921 \u092a\u0930 \u0935\u093f\u091a\u093e\u0930 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948\u3002\n\n3. \u0930\u093f\u092b\u0902\u0921 \u0915\u0947 \u0932\u093f\u090f \u092a\u093e\u0924\u094d\u0930\u0924\u093e\n\n\u0930\u093f\u092b\u0902\u0921 \u0905\u0928\u0941\u0930\u094b\u0927\u094b\u0902 \u0915\u0940 \u092e\u093e\u092e\u0932\u093e-\u0926\u0930-\u092e\u093e\u092e\u0932\u093e \u0906\u0927\u093e\u0930 \u092a\u0930 \u0938\u092e\u0940\u0915\u094d\u0937\u093e \u0915\u0940 \u091c\u093e\u090f\u0917\u0940 \u0914\u0930 \u0909\u0928\u094d\u0939\u0947\u0902 \u0915\u0947\u0935\u0932 \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u0947 \u0924\u0939\u0924 \u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u0915\u093f\u092f\u093e \u091c\u093e \u0938\u0915\u0924\u093e \u0939\u0948:\n\n\u2022 \u0926\u094b\u0939\u0930\u0940 \u0916\u0930\u0940\u0926\u093e\u0930\u0940\n\u2022 \u0924\u0915\u0928\u0940\u0915\u0940 \u0935\u093f\u092b\u0932\u0924\u093e (\u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0935\u093f\u0924\u0930\u093f\u0924 \u0928\u0939\u0940\u0902 \u0939\u0941\u0908)\n\u2022 \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u0932\u0947\u0928\u0926\u0947\u0928 (\u0935\u0948\u0927 \u092a\u094d\u0930\u092e\u093e\u0923 \u0915\u0947 \u0938\u093e\u0925)\n\n\u0930\u093f\u092b\u0902\u0921 \u0915\u0947 \u0932\u093f\u090f \u092a\u093e\u0924\u094d\u0930 \u0939\u094b\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f, \u0906\u092a\u0915\u094b:\n\n\u2022 \u0932\u0947\u0928\u0926\u0947\u0928 \u0915\u0947 48 \u0918\u0902\u091f\u094b\u0902 \u0915\u0947 \u092d\u0940\u0924\u0930 \u0939\u092e\u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e\n\u2022 \u0906\u0926\u0947\u0936 \u0906\u0908\u0921\u0940 \u0914\u0930 \u092a\u094d\u0930\u093e\u0938\u0902\u0917\u093f\u0915 \u092a\u094d\u0930\u092e\u093e\u0923 (\u0909\u0926\u093e. \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f, \u0924\u094d\u0930\u0941\u091f\u093f \u0938\u0902\u0926\u0947\u0936) \u092a\u094d\u0930\u0926\u093e\u0928 \u0915\u0930\u0928\u093e \u0939\u094b\u0917\u093e\n\n4. \u0930\u093f\u092b\u0902\u0921 \u0915\u093e \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u0948\u0938\u0947 \u0915\u0930\u0947\u0902\n\n\u092f\u0926\u093f \u0906\u092a\u0915\u094b \u0932\u0917\u0924\u093e \u0939\u0948 \u0915\u093f \u0906\u092a \u0930\u093f\u092b\u0902\u0921 \u0915\u0947 \u092a\u093e\u0924\u094d\u0930 \u0939\u0948\u0902, \u0924\u094b \u0907\u0928\u092e\u0947\u0902 \u0938\u0947 \u0915\u093f\u0938\u0940 \u090f\u0915 \u0935\u093f\u0915\u0932\u094d\u092a \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0947\u0902:\n\nGoogle Play \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947:\n\n1. \u0905\u092a\u0928\u093e Google Play \u0916\u093e\u0924\u093e \u0916\u094b\u0932\u0947\u0902\u0964\n2. \"\u0911\u0930\u094d\u0921\u0930 \u0907\u0924\u093f\u0939\u093e\u0938\" \u092a\u0930 \u091c\u093e\u090f\u0902\u0964\n3. \u0932\u0947\u0928\u0926\u0947\u0928 \u0922\u0942\u0902\u0922\u0947\u0902 \u0914\u0930 \"\u0938\u092e\u0938\u094d\u092f\u093e \u0915\u0940 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0930\u0947\u0902\" \u092a\u0930 \u091f\u0948\u092a \u0915\u0930\u0947\u0902\u3002\n4. \u0909\u092a\u092f\u0941\u0915\u094d\u0924 \u0915\u093e\u0930\u0923 \u091a\u0941\u0928\u0947\u0902 \u0914\u0930 \u092b\u0949\u0930\u094d\u092e \u0938\u092c\u092e\u093f\u091f \u0915\u0930\u0947\u0902\u3002\n\n\u092f\u093e \u0938\u0940\u0927\u0947 \u0939\u092e\u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902:\n\n\u0908\u092e\u0947\u0932: support@yaroapp.in\n\u0936\u093e\u092e\u093f\u0932 \u0915\u0930\u0947\u0902:\n\n\u2022 \u0906\u092a\u0915\u093e \u0928\u093e\u092e\n\u2022 Google \u0906\u0926\u0947\u0936 \u0906\u0908\u0921\u0940 (GPA. \u0938\u0947 \u0936\u0941\u0930\u0942)\n\u2022 \u0930\u093f\u092b\u0902\u0921 \u0905\u0928\u0941\u0930\u094b\u0927 \u0915\u093e \u0915\u093e\u0930\u0923\n\u2022 \u0938\u094d\u0915\u094d\u0930\u0940\u0928\u0936\u0949\u091f (\u092f\u0926\u093f \u0932\u093e\u0917\u0942 \u0939\u094b)\n\n5. \u0930\u093f\u092b\u0902\u0921 \u0938\u092e\u092f \u0938\u0940\u092e\u093e\n\n\u092f\u0926\u093f \u0938\u094d\u0935\u0940\u0915\u0943\u0924 \u0939\u094b \u091c\u093e\u0924\u093e \u0939\u0948, \u0924\u094b \u0906\u092a\u0915\u0947 \u092c\u0948\u0902\u0915 \u092f\u093e Google Play \u0928\u0940\u0924\u093f \u0915\u0947 \u0906\u0927\u093e\u0930 \u092a\u0930, 5-10 \u0935\u094d\u092f\u093e\u0935\u0938\u093e\u092f\u093f\u0915 \u0926\u093f\u0928\u094b\u0902 \u0915\u0947 \u092d\u0940\u0924\u0930 \u092e\u0942\u0932 \u092d\u0941\u0917\u0924\u093e\u0928 \u0935\u093f\u0927\u093f \u0915\u094b \u0930\u093f\u092b\u0902\u0921 \u091c\u093e\u0930\u0940 \u0915\u0930 \u0926\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u3002\n\n6. \u0907\u0928\u0915\u0947 \u0932\u093f\u090f \u0915\u094b\u0908 \u0930\u093f\u092b\u0902\u0921 \u0928\u0939\u0940\u0902:\n\n\u2022 \u092e\u0928 \u092c\u0926\u0932\u0928\u093e\n\u2022 \u0906\u0902\u0936\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u091c\u093e\u0928\u0947 \u0935\u093e\u0932\u0940 \u0938\u0947\u0935\u093e\u090f\u0902 (\u0909\u0926\u093e., \u0909\u092a\u092f\u094b\u0917 \u0915\u093f\u090f \u0917\u090f \u0938\u093f\u0915\u094d\u0915\u0947 \u092f\u093e \u092a\u0942\u0930\u094d\u0923 \u091a\u0948\u091f)\n\u2022 \u0926\u0941\u0930\u0941\u092a\u092f\u094b\u0917 \u092f\u093e \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u093e \u0909\u0932\u094d\u0932\u0902\u0918\u0928\n\u2022 \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0915\u0947 48 \u0918\u0902\u091f\u0947 \u092c\u093e\u0926 \u0905\u0928\u0941\u0930\u094b\u0927\n\n7. \u0939\u092e\u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\n\n\u0938\u092e\u0930\u094d\u0925\u0928 \u092f\u093e \u0927\u0928\u0935\u093e\u092a\u0938\u0940 \u0905\u0928\u0941\u0930\u094b\u0927\u094b\u0902 \u0915\u0947 \u0932\u093f\u090f, \u0915\u0943\u092a\u092f\u093e \u0939\u092e\u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902:\n\n\u0938\u092e\u0930\u094d\u0925\u0928 \u0908\u092e\u0947\u0932: support@yaroapp.in\n\u0907\u0928-\u0910\u092a \u0938\u092e\u0930\u094d\u0925\u0928 \u0905\u0928\u0941\u092d\u093e\u0917: \u0910\u092a \u0938\u0947\u091f\u093f\u0902\u0917\u094d\u0938 \u092e\u0947\u0902 \u0909\u092a\u0932\u092c\u094d\u0927\n\n\u0910\u092a \u092e\u0947\u0902 \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0915\u0930\u0915\u0947, \u0906\u092a \u0907\u0938 \u0927\u0928\u0935\u093e\u092a\u0938\u0940 \u0928\u0940\u0924\u093f \u0938\u0947 \u0938\u0939\u092e\u0924 \u0939\u094b\u0924\u0947 \u0939\u0948\u0902\u0964"},terms_of_use:{title:"\u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u0936\u0930\u094d\u0924\u0947\u0902 \u2013 Yaro",content:"1. \u092a\u0930\u093f\u091a\u092f:\nYaro, \u090f\u0915 \u0938\u094b\u0936\u0932 \u0935\u0949\u092f\u0938 \u091a\u0948\u091f \u0914\u0930 \u0935\u0949\u092f\u0938 \u0915\u0949\u0932\u093f\u0902\u0917 \u090f\u092a\u094d\u0932\u093f\u0915\u0947\u0936\u0928 \u092e\u0947\u0902 \u0906\u092a\u0915\u093e \u0938\u094d\u0935\u093e\u0917\u0924 \u0939\u0948\u0964 \u0907\u0938 \u0910\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947, \u0906\u092a \u0928\u093f\u092e\u094d\u0928\u0932\u093f\u0916\u093f\u0924 \u0928\u093f\u092f\u092e\u094b\u0902 \u0914\u0930 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u093e \u092a\u093e\u0932\u0928 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u092e\u0924 \u0939\u0948\u0902\u0964\n\n2. \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e \u092a\u093e\u0924\u094d\u0930\u0924\u093e:\n\u0907\u0938 \u0910\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0906\u092a\u0915\u0940 \u0906\u092f\u0941 \u0915\u092e \u0938\u0947 \u0915\u092e 18 \u0935\u0930\u094d\u0937 \u0939\u094b\u0928\u0940 \u091a\u093e\u0939\u093f\u090f\u0964 \u0907\u0938 \u0910\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947, \u0906\u092a \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0915\u093f \u0906\u092a \u092a\u093e\u0924\u094d\u0930\u0924\u093e \u092e\u093e\u0928\u0926\u0902\u0921\u094b\u0902 \u0915\u094b \u092a\u0942\u0930\u093e \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n\n3. \u0910\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917:\n- \u092f\u0939 \u0910\u092a \u0906\u092a\u0915\u094b \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0914\u0930 \u0928\u093f\u091c\u0940 \u0935\u0949\u092f\u0938 \u091a\u0948\u091f \u0930\u0942\u092e \u092e\u0947\u0902 \u0936\u093e\u092e\u093f\u0932 \u0939\u094b\u0928\u0947 \u0914\u0930 \u0905\u0928\u094d\u092f \u0909\u092a\u092f\u094b\u0917\u0915\u0930\u094d\u0924\u093e\u0913\u0902 \u0915\u094b \u0935\u0949\u092f\u0938 \u0915\u0949\u0932 \u0915\u0930\u0928\u0947 \u0915\u0940 \u0905\u0928\u0941\u092e\u0924\u093f \u0926\u0947\u0924\u093e \u0939\u0948\u0964\n- \u0906\u092a \u0915\u0947\u0935\u0932 \u0935\u0948\u0927 \u0914\u0930 \u0938\u092e\u094d\u092e\u093e\u0928\u091c\u0928\u0915 \u0938\u0902\u091a\u093e\u0930 \u0915\u0947 \u0932\u093f\u090f \u0910\u092a \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0938\u0939\u092e\u0924 \u0939\u0948\u0902\u0964\n- \u0915\u093f\u0938\u0940 \u092d\u0940 \u092a\u094d\u0930\u0915\u093e\u0930 \u0915\u093e \u0926\u0941\u0930\u094d\u0935\u094d\u092f\u0935\u0939\u093e\u0930, \u0909\u0924\u094d\u092a\u0940\u0921\u093c\u0928 \u092f\u093e \u0906\u092a\u0924\u094d\u0924\u093f\u091c\u0928\u0915 \u0938\u093e\u092e\u0917\u094d\u0930\u0940 \u0938\u0916\u094d\u0924 \u0935\u0930\u094d\u091c\u093f\u0924 \u0939\u0948\u0964\n\n4. \u0916\u093e\u0924\u0947 \u0915\u0940 \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930\u0940:\n- \u0906\u092a \u0905\u092a\u0928\u0947 \u0916\u093e\u0924\u0947 \u0915\u0940 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u092c\u0928\u093e\u090f \u0930\u0916\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u091c\u093f\u092e\u094d\u092e\u0947\u0926\u093e\u0930 \u0939\u0948\u0902\u0964\n- \u0906\u092a\u0915\u094b \u0905\u092a\u0928\u0940 \u0932\u0949\u0917\u093f\u0928 \u091c\u093e\u0928\u0915\u093e\u0930\u0940 \u0915\u093f\u0938\u0940 \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u091d\u093e \u0928\u0939\u0940\u0902 \u0915\u0930\u0928\u0940 \u091a\u093e\u0939\u093f\u090f\u0964\n- \u092f\u0926\u093f \u0906\u092a\u0915\u094b \u0915\u093f\u0938\u0940 \u0905\u0928\u0927\u093f\u0915\u0943\u0924 \u092a\u0939\u0941\u0902\u091a \u0915\u093e \u0938\u0902\u0926\u0947\u0939 \u0939\u0948, \u0924\u094b \u0915\u0943\u092a\u092f\u093e \u0910\u092a \u0938\u092e\u0930\u094d\u0925\u0928 \u0905\u0928\u0941\u092d\u093e\u0917 \u0915\u0947 \u092e\u093e\u0927\u094d\u092f\u092e \u0938\u0947 \u0907\u0938\u0915\u0940 \u0930\u093f\u092a\u094b\u0930\u094d\u091f \u0915\u0930\u0947\u0902\u0964\n\n5. \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0914\u0930 \u0921\u0947\u091f\u093e:\n- \u0939\u092e \u0906\u092a\u0915\u0940 \u0917\u094b\u092a\u0928\u0940\u092f\u0924\u093e \u0915\u094b \u092e\u0939\u0924\u094d\u0935 \u0926\u0947\u0924\u0947 \u0939\u0948\u0902\u0964 \u0906\u092a\u0915\u0947 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u0917\u0924 \u0921\u0947\u091f\u093e \u0915\u094b \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0942\u092a \u0938\u0947 \u0938\u0902\u092d\u093e\u0932\u093e \u091c\u093e\u090f\u0917\u093e \u0914\u0930 \u0907\u0938\u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0947\u0935\u0932 \u0910\u092a \u0905\u0928\u0941\u092d\u0935 \u0915\u094b \u092c\u0947\u0939\u0924\u0930 \u092c\u0928\u093e\u0928\u0947 \u0915\u0947 \u0932\u093f\u090f \u0915\u093f\u092f\u093e \u091c\u093e\u090f\u0917\u093e\u0964\n- \u0935\u0949\u092f\u0938 \u0921\u0947\u091f\u093e \u0914\u0930 \u091a\u0948\u091f \u0907\u0902\u091f\u0930\u0948\u0915\u094d\u0936\u0928 \u0915\u094b \u0938\u093e\u0930\u094d\u0935\u091c\u0928\u093f\u0915 \u0930\u0942\u092a \u0938\u0947 \u092f\u093e \u0924\u0940\u0938\u0930\u0947 \u092a\u0915\u094d\u0937 \u0915\u0947 \u0938\u093e\u0925 \u0938\u093e\u091d\u093e \u0928\u0939\u0940\u0902 \u0915\u093f\u092f\u093e \u091c\u093e\u0924\u093e \u0939\u0948, \u091c\u092c \u0924\u0915 \u0915\u093f \u0915\u093e\u0928\u0942\u0928 \u0926\u094d\u0935\u093e\u0930\u093e \u0906\u0935\u0936\u094d\u092f\u0915 \u0928 \u0939\u094b\u0964\n\n6. \u092d\u0941\u0917\u0924\u093e\u0928 \u0914\u0930 \u0938\u093f\u0915\u094d\u0915\u0947:\n- \u0910\u092a \u0907\u0928-\u0910\u092a \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u091c\u0948\u0938\u0947 \u0938\u093f\u0915\u094d\u0915\u0947 \u092f\u093e \u092a\u094d\u0930\u0940\u092e\u093f\u092f\u092e \u0938\u0941\u0935\u093f\u0927\u093e\u0913\u0902 \u0915\u0940 \u092a\u0947\u0936\u0915\u0936 \u0915\u0930 \u0938\u0915\u0924\u093e \u0939\u0948\u0964\n- \u0938\u092d\u0940 \u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0905\u0902\u0924\u093f\u092e \u0939\u0948\u0902 \u0914\u0930 \u0917\u0948\u0930-\u0935\u093e\u092a\u0938\u0940 \u092f\u094b\u0917\u094d\u092f \u0939\u0948\u0902 \u091c\u092c \u0924\u0915 \u0915\u093f \u0910\u092a \u0938\u094d\u091f\u094b\u0930 \u0928\u0940\u0924\u093f\u092f\u094b\u0902 \u0926\u094d\u0935\u093e\u0930\u093e \u0905\u0928\u094d\u092f\u0925\u093e \u0928 \u0915\u0939\u093e \u0917\u092f\u093e \u0939\u094b\u0964\n\n7. \u0916\u093e\u0924\u0947 \u0915\u0940 \u0938\u092e\u093e\u092a\u094d\u0924\u093f:\n- \u092f\u0926\u093f \u0906\u092a \u0915\u093f\u0938\u0940 \u092d\u0940 \u0928\u093f\u092f\u092e \u0915\u093e \u0909\u0932\u094d\u0932\u0902\u0918\u0928 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902 \u0924\u094b Yaro \u0906\u092a\u0915\u0947 \u0916\u093e\u0924\u0947 \u0915\u094b \u0928\u093f\u0932\u0902\u092c\u093f\u0924 \u092f\u093e \u0938\u092e\u093e\u092a\u094d\u0924 \u0915\u0930\u0928\u0947 \u0915\u093e \u0905\u0927\u093f\u0915\u093e\u0930 \u0938\u0941\u0930\u0915\u094d\u0937\u093f\u0924 \u0930\u0916\u0924\u093e \u0939\u0948\u0964\n- \u0906\u092a \u0910\u092a \u0915\u0940 \u0938\u0947\u091f\u093f\u0902\u0917 \u0938\u0947 \u0915\u092d\u0940 \u092d\u0940 \u0905\u092a\u0928\u093e \u0916\u093e\u0924\u093e \u0939\u091f\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\n\n8. \u0910\u092a \u0938\u093e\u092e\u0917\u094d\u0930\u0940:\n- \u0915\u0941\u091b \u0926\u0943\u0936\u094d\u092f, \u0905\u0935\u0924\u093e\u0930 \u092f\u093e \u0906\u0907\u0915\u0928 \u0915\u0943\u0924\u094d\u0930\u093f\u092e \u092c\u0941\u0926\u094d\u0927\u093f\u092e\u0924\u094d\u0924\u093e (\u090f\u0906\u0908) \u0915\u093e \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0915\u0947 \u0909\u0924\u094d\u092a\u0928\u094d\u0928 \u0915\u093f\u090f \u091c\u093e \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964\n- \u092f\u0947 \u0935\u093e\u0938\u094d\u0924\u0935\u093f\u0915 \u0935\u094d\u092f\u0915\u094d\u0924\u093f\u092f\u094b\u0902 \u0915\u093e \u092a\u094d\u0930\u0924\u093f\u0928\u093f\u0927\u093f\u0924\u094d\u0935 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964 \u0915\u094b\u0908 \u092d\u0940 \u0938\u092e\u093e\u0928\u0924\u093e \u0935\u093f\u0936\u0941\u0926\u094d\u0927 \u0930\u0942\u092a \u0938\u0947 \u0938\u0902\u092f\u094b\u0917 \u0939\u0948\u0964\n\n9. \u0936\u0930\u094d\u0924\u094b\u0902 \u092e\u0947\u0902 \u092c\u0926\u0932\u093e\u0935:\n\u0939\u092e \u0938\u092e\u092f-\u0938\u092e\u092f \u092a\u0930 \u0907\u0928 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u094b \u0905\u092a\u0921\u0947\u091f \u0915\u0930 \u0938\u0915\u0924\u0947 \u0939\u0948\u0902\u0964 \u0910\u092a \u0915\u093e \u0928\u093f\u0930\u0902\u0924\u0930 \u0909\u092a\u092f\u094b\u0917 \u0915\u0930\u0928\u0947 \u0915\u093e \u092e\u0924\u0932\u092c \u0939\u0948 \u0915\u093f \u0906\u092a \u0905\u0926\u094d\u092f\u0924\u0928 \u0936\u0930\u094d\u0924\u094b\u0902 \u0915\u094b \u0938\u094d\u0935\u0940\u0915\u093e\u0930 \u0915\u0930\u0924\u0947 \u0939\u0948\u0902\u0964\n\n10. \u0938\u092e\u0930\u094d\u0925\u0928:\n\u092f\u0926\u093f \u0906\u092a\u0915\u0947 \u0915\u094b\u0908 \u092a\u094d\u0930\u0936\u094d\u0928, \u091a\u093f\u0902\u0924\u093e\u090f\u0902 \u092f\u093e \u0936\u093f\u0915\u093e\u092f\u0924\u0947\u0902 \u0939\u0948\u0902, \u0924\u094b \u0915\u0943\u092a\u092f\u093e \u0910\u092a \u092e\u0947\u0902 \u0938\u092e\u0930\u094d\u0925\u0928 \u0905\u0928\u0941\u092d\u093e\u0917 \u0938\u0947 \u0939\u092e\u0938\u0947 \u0938\u0902\u092a\u0930\u094d\u0915 \u0915\u0930\u0947\u0902\u0964\n\n\u0928\u094b\u091f: \u092f\u0947 \u0909\u092a\u092f\u094b\u0917 \u0915\u0940 \u0936\u0930\u094d\u0924\u0947\u0902 \u090f\u0915 \u0938\u093e\u092e\u093e\u0928\u094d\u092f \u0926\u093f\u0936\u093e\u0928\u093f\u0930\u094d\u0926\u0947\u0936 \u0939\u0948\u0902 \u0914\u0930 \u092d\u093e\u0930\u0924\u0940\u092f \u0926\u0902\u0921 \u0938\u0902\u0939\u093f\u0924\u093e \u092f\u093e \u0906\u0908\u091f\u0940 \u0905\u0927\u093f\u0928\u093f\u092f\u092e \u0938\u0939\u093f\u0924 \u0932\u093e\u0917\u0942 \u0915\u093e\u0928\u0942\u0928\u094b\u0902 \u0915\u0947 \u0924\u0939\u0924 \u0915\u093f\u0938\u0940 \u092d\u0940 \u0915\u093e\u0928\u0942\u0928\u0940 \u0928\u093f\u092f\u092e\u094b\u0902 \u0915\u094b \u092a\u094d\u0930\u0924\u093f\u0938\u094d\u0925\u093e\u092a\u093f\u0924 \u0928\u0939\u0940\u0902 \u0915\u0930\u0924\u0940 \u0939\u0948\u0902\u0964"},notifications:{title:"\u0938\u0942\u091a\u0928\u093e\u090f\u0902",empty:"\u0905\u092d\u0940 \u0924\u0915 \u0915\u094b\u0908 \u0938\u0942\u091a\u0928\u093e \u0928\u0939\u0940\u0902"},system_messages:{title:"\u0938\u093f\u0938\u094d\u091f\u092e \u0938\u0902\u0926\u0947\u0936",empty:"\u0915\u094b\u0908 \u0938\u093f\u0938\u094d\u091f\u092e \u0938\u0902\u0926\u0947\u0936 \u0928\u0939\u0940\u0902"},recharge:{title:"\u0935\u0949\u0932\u0947\u091f \u0930\u093f\u091a\u093e\u0930\u094d\u091c \u0915\u0930\u0947\u0902",processing:"\u0916\u0930\u0940\u0926\u093e\u0930\u0940 \u0938\u0902\u0938\u093e\u0927\u093f\u0924 \u0939\u094b \u0930\u0939\u0940 \u0939\u0948...",history:"\u0930\u093f\u091a\u093e\u0930\u094d\u091c \u0907\u0924\u093f\u0939\u093e\u0938",no_history:"\u0915\u094b\u0908 \u0930\u093f\u091a\u093e\u0930\u094d\u091c \u0907\u0924\u093f\u0939\u093e\u0938 \u0928\u0939\u0940\u0902 \u092e\u093f\u0932\u093e"},withdrawal:{title:"\u092a\u0948\u0938\u0947 \u0928\u093f\u0915\u093e\u0932\u0947\u0902",min_withdrawal:"\u0928\u094d\u092f\u0942\u0928\u0924\u092e \u0928\u093f\u0915\u093e\u0938\u0940 \u0939\u0948 \u20b9",complete_kyc:"\u0905\u092a\u0928\u093e KYC \u092a\u0942\u0930\u093e \u0915\u0930\u0947\u0902",verify:"\u0938\u0924\u094d\u092f\u093e\u092a\u093f\u0924 \u0915\u0930\u0947\u0902",input_coin:"\u0928\u093f\u0915\u093e\u0938\u0940 \u0938\u093f\u0915\u094d\u0915\u093e \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",equivalent_amount:"\u0938\u092e\u0924\u0941\u0932\u094d\u092f \u0930\u093e\u0936\u093f:",bank_account:"\u092c\u0948\u0902\u0915 \u0916\u093e\u0924\u093e",upi:"\u092f\u0942\u092a\u0940\u0906\u0908",bank_name:"\u092c\u0948\u0902\u0915 \u0915\u093e \u0928\u093e\u092e",account_number:"\u0916\u093e\u0924\u093e \u0938\u0902\u0916\u094d\u092f\u093e",confirm_account:"\u0916\u093e\u0924\u093e \u0938\u0902\u0916\u094d\u092f\u093e \u0915\u0940 \u092a\u0941\u0937\u094d\u091f\u093f \u0915\u0930\u0947\u0902",ifsc_code:"IFSC \u0915\u094b\u0921",receiver_name:"\u092a\u094d\u0930\u093e\u092a\u094d\u0924\u0915\u0930\u094d\u0924\u093e \u0915\u093e \u0928\u093e\u092e",enter_upi:"UPI ID \u0926\u0930\u094d\u091c \u0915\u0930\u0947\u0902",example_u